try {
/* module-key = 'com.atlassian.confluence.editor:collaborative-helper', location = 'com/atlassian/confluence/tinymceplugin/loader/collaborative-helper.js' */
define('confluence-editor/loader/collaborative-helper', [
    'jquery',
    'ajs',
    'confluence/meta',
    'confluence/api/event',
    'confluence/get-content-id'
], function (
    $,
    AJS,
    Meta,
    Event,
    getContentId) {
    "use strict";

    // TODO SHARED-DRAFTS Port to frontend repo

    var collaborativePlugin;
    var collaborativePluginPromise = $.Deferred();

    var editorContentId;
    var loadPromise;
    var editPromise = $.Deferred();
    var contentPromise = $.Deferred();
    var editorPromise = $.Deferred();

    // TODO Would be nice to pass all the data we need through the events
    // and completely stop depending on global state (Meta) to init the editor
    // if that is the case, we can ditch 'rte-quick-edit-init' here which doesn't really add value
    // and really have a simple initialisation logic without having to wait for the load before triggering the edit,
    // special cases (see editorReady), etc.

    function init() {
        Event.bind('rte-loaded', function (e, data) {
            load(data);
        });

        Event.bind('rte-quick-edit-init rte-initial-raw-content-ready', function (e, data) {
            edit(data);
        });

        Event.bind('rte-quick-edit-ready', function () {
            editorReady();
        });

        Event.bind('rte-ready', function () {
            if (!AJS.Rte.isQuickEdit) {
                editorReady();
            }
        });
    }

    function getLoadPromise() {
        var contentId = getContentId();
        if (contentId !== editorContentId) {
            loadPromise = $.Deferred();
            editorContentId = contentId;

            // Use collaborativePluginPromise in case rte-loaded is published before the plugin registration (currently can happen for slow edit)
            $.when(loadPromise, collaborativePluginPromise).done(function() {
                collaborativePlugin.load();
            });
        }

        return loadPromise;
    }

    function hasUnsavedChanges() {
        return collaborativePlugin.hasUnsavedChanges();
    }

    function load(content) {
        if (content.editPermission && isCollaborativeEditingAvailable(content)) {
            getLoadPromise().resolve();
        }
    }

    function edit(content) {
        // We need to do this cause the edit and content steps can happen before the editor is loaded
        getLoadPromise().done(function () {
            if (isCollaborativeEditingAvailable(content)) {
                if (content) {
                    var error = contentError(content);
                    error ? contentPromise.reject(error) : contentPromise.resolve(content);
                }

                editPromise.resolve();
            }
        });
    }

    function editorReady() {
        if (isCollaborativeEditingAvailable()) {
            // Make sure load and therefore edit is triggered if the editor is not initially loaded as collaborative
            // One case is due to race condition with Meta 'content-type' when quickly adding a comment on page load
            getLoadPromise().resolve();

            editorPromise.resolve(AJS.Rte.getEditor());
        } else {
            setStatus('off');
        }
    }

    function contentError(data) {
        if (!isReconciled(data.syncRevSource)) {
            // TODO CFE-115 Should we trigger recovery in this case instead of messing around with different cases in the Content API?
            return 'unreconciled-recovery';
        }

        if (hasError(data.editorContent)) {
            return 'render';
        }

        return false;
    }

    function isReconciled(syncRevSource) {
        return !syncRevSource || syncRevSource === 'synchrony' || syncRevSource === 'synchrony-ack';
    }

    function hasError(editorContent) {
        return !!$('<div>' + editorContent + '</div>').find('.fatal-render-error').length;
    }

    // For page objects to wait correctly in tests
    function setStatus(status) {
        $('meta[name="ajs-collaborative-editor-status"]').attr('content', status);
    }

    function getStatus() {
        return $('meta[name="ajs-collaborative-editor-status"]').attr('content');
    }

    function isCollaborativeEditingAvailable(_content) {
        var content = _content || {};

        var id = content.id ||  getContentId();
        var contentType = content.type || Meta.get('content-type');
        var entityExists = id !== '0';

        return (contentType === 'page' || contentType === 'blogpost') && entityExists;
    }

    function registerPlugin(_collaborativePlugin) {
        collaborativePlugin = _collaborativePlugin;
        collaborativePluginPromise.resolve();

        editPromise.done(function () {
            collaborativePlugin.edit(contentPromise.promise(), editorPromise.promise());
        });
    }

    function getEditorContent() {
        // If the editor is in fake mode which is used in tests that use the collaborative editor, but don't connect to a proper synchrony, fall back to the old way of getting content
        if (isCollaborativeEditingAvailable() && getStatus() !== 'fake') {
            return collaborativePlugin.getSynchronisedEditorContent();
        } else {
            return {
                content: AJS.Rte.getEditor().getContent()
            };
        }
    }

    return {
        _init: init,
        registerPlugin: registerPlugin,
        setStatus: setStatus,
        isCollaborativeEditingAvailable: isCollaborativeEditingAvailable,
        getEditorContent: getEditorContent,
        hasUnsavedChanges: hasUnsavedChanges
    };
});

require('confluence/module-exporter').safeRequire('confluence-editor/loader/collaborative-helper', function (CollaborativeHelper) {
    CollaborativeHelper._init();
});
}catch(e){WRMCB(e)};
;
try {
/* module-key = 'com.atlassian.confluence.plugins.confluence-collaborative-editor-plugin:cql-user-information', location = '/com/atlassian/confluence/plugins/collab/js/cql-user-information.js' */
define('confluence-collaborative-editor-plugin/cql-user-information', [
  'jquery',
  'confluence/meta',
  'confluence/api/constants'
], function(
  $,
  Meta,
  CONSTANTS
) {
  'use strict';

  var UNDEF = '__UNDEFINED_OBJECT_KEY__';
  var ANONYMOUS = 'anonymous';

  var defaultProfilePic = Meta.get('static-resource-url-prefix') + '/images/icons/profilepics/default.png';

  var defaultCachedUser = {
    sub: 0,
    avatarURL: defaultProfilePic,
    displayName: 'Current User'
  };

  var SUBS = [];

  var CACHE = {
    ACCOUNT_IDS: {},
    USERNAMES: {} // TODO: remove after GDPR.
  };

  var currentUserId = Meta.get('atlassian-account-id');
  var currentUserFullName = Meta.get('current-user-fullname');
  var currentUserObject = {
    displayName: currentUserFullName,
    displayname: currentUserFullName,
    fullName: currentUserFullName,
    fullname: currentUserFullName,
    avatarURL: Meta.get('current-user-avatar-uri-reference'),
    sub: 0
  };
  CACHE.ACCOUNT_IDS[currentUserId] = currentUserObject;

  var currentUserRemoteUser = Meta.get('remote-user');
  if (currentUserRemoteUser) {
    // TODO: remove after GDPR.
    CACHE.USERNAMES[currentUserRemoteUser] = currentUserObject;
  }

  /**
   * Obtains an ordered list of objects from the cached data.
   */
  function populateUserInformation(userObjects) {
    return userObjects.map(function (userObject) {
      var cachedUser = CACHE.ACCOUNT_IDS[ userObject.accountId || UNDEF ] ||
          CACHE.USERNAMES[ userObject.username || UNDEF ] ||  // TODO: remove after GDPR.
          defaultCachedUser;

      var user = Object.assign({}, userObject);
      user.displayName = cachedUser.displayName;
      user.fullname = cachedUser.displayName;
      user.avatarURL = cachedUser.avatarURL;
      user.sub = user.sub || cachedUser.sub;
      return user;
    });
  }

  function quote(ids) {
    return ids.map(function(id) {
      return '"' + id + '"';
    });
  }

  /**
   * Fetches a set of users by account IDs or usernames.
   */
  function cqlUserInformation(userObjects) {
    if (!Array.isArray(userObjects)) {
      userObjects = [userObjects];
    }

    if (!userObjects.length) {
      return Promise.resolve([]);
    }

    return new Promise(function (resolve) {
      // Get all the account IDs to be fetched via cql and exclude cached info.
      var accountIds = userObjects.filter(function (userObject) {
        return (
          userObject.accountId &&
          !CACHE.ACCOUNT_IDS[userObject.accountId] &&
          userObject.accountId !== ANONYMOUS
        );
      }).map(function (userObject) {
        return userObject.accountId;
      });

      // TODO: remove after GDPR.
      // Get all the usernames to be fetched via cql and exclude cached info.
      var usernames = userObjects.filter(function (userObject) {
        return (
          userObject.username &&
          !CACHE.USERNAMES[userObject.username] &&
          userObject.username !== ANONYMOUS
        );
      }).map(function (userObject) {
        return userObject.username;
      });

      if (!accountIds.length && !usernames.length) {
        return resolve(populateUserInformation(userObjects));
      }

      var statements = [];
      if (accountIds.length) {
        statements.push('user.accountid in (' + quote(accountIds).join(',') + ')');
      }
      if (usernames.length) { // TODO: remove after GDPR.
        statements.push('user in (' + quote(usernames).join(',') + ')');
      }

      var searchSlug = '?cql=' + encodeURIComponent(statements.join(' or '));
      $.ajax({
        url: CONSTANTS.CONTEXT_PATH + '/rest/api/search/user' + searchSlug,
        dataType: 'json',
        type: 'GET',
        contentType: 'application/json',
        success: function (resp) {
          (resp.results || []).forEach(function (result) {
            var user = ((result || {}).user || {});

            // This value is used to identify the color of the collaborator.
            var sub = SUBS.indexOf(user.accountId);
            if (SUBS.indexOf(user.accountId) === -1) {
              SUBS.push(user.accountId);
              sub = SUBS.length - 1;
            }

            var cachedUser = {
              sub: sub,
              displayName: user.displayName || ANONYMOUS,
              avatarURL: (user.profilePicture || {}).path || defaultProfilePic
            };

            if (user.accountId && user.accountId !== ANONYMOUS) {
              CACHE.ACCOUNT_IDS[user.accountId] = cachedUser;
            }

            if (user.username && user.username !== ANONYMOUS) { // TODO: remove after GDPR.
              CACHE.USERNAMES[user.username] = cachedUser;
            }
          });

          resolve(populateUserInformation(userObjects));
        },
        failure: function () {
          resolve(populateUserInformation(userObjects));
        }
      });
    });
  }

  return cqlUserInformation;
});

}catch(e){WRMCB(e)};
;
try {
/* module-key = 'com.atlassian.confluence.plugins.confluence-collaborative-editor-plugin:user-information', location = '/com/atlassian/confluence/plugins/collab/js/user-information.js' */
/**
 * An object containing information about a user's profile picture.
 * @typedef {Object} ProfilePicture
 * @property {string} path - The URL to the profile picture
 */

/**
 * An Atlassian user object.
 * @typedef {Object} AtlassianUser
 * @property {string} accountId - The user's account ID.
 * @property {string} dislayName - The user's display name.
 * @property {ProfilePicture} profilePicture - The user's profile picture information.
 * @property {string} username - The user's username.
 */

/**
 * @typedef SearchResult
 * @property {*} accountIds
 * @property {AtlassianUser=} user
 */

/**
 * @typedef SearchPageResponseSearchResult
 * @property {SearchResult[]=} results
 */

/**
 * A user object.
 * @typedef {Object} User
 * @property {string} avatarURL - The URL pointing to the user's avatar.
 * @property {string} displayName - The user's display name.
 * @property {string} fullname - The user's full name.
 * @property {number} sub - TODO.
 */

define('confluence-collaborative-editor-plugin/user-information', [
    'jquery',
    'confluence/meta',
    'confluence/api/constants'
], function (
    $,
    Meta,
    API_CONSTANTS
) {
    'use strict';

    var ANONYMOUS = 'anonymous';

    /** URL of the default profile picture. */
    var defaultProfilePic = Meta.get('static-resource-url-prefix') + '/images/icons/profilepics/default.png';

    /**
     * This array tracks new subscribers and is used to help determine the
     * color of the collaborator's avatar.
     * @type {string[]}
     */
    var subs = [];

    var currentUserId = Meta.get('atlassian-account-id');
    var currentUserFullName = Meta.get('current-user-fullname');
    var currentUserObject = {
        displayName: currentUserFullName,
        fullname: currentUserFullName,
        avatarURL: Meta.get('current-user-avatar-uri-reference'),
        sub: 0
    };

    /**
     * Cache of user information keyed by account ID.
     * @type {Object.<string, User>}
     */
    var cache = {};
    cache[currentUserId] = currentUserObject;

    /** @type {User} */
    var defaultCachedUser = {
        avatarURL: defaultProfilePic,
        displayName: 'Current User',
        fullname: 'Current User',
        sub: 0
    };

    /**
     * Attempts to get the data cached at the given account IDs. Defaults to
     * "Current User" if no data exists.
     *
     * @param {string[]} accountIds - Account IDs of users we want info on.
     * @returns {User[]} The user objects.
     */
    function getCachedUsersByID(accountIds) {
        return accountIds.map(function (accountId) {
            var cachedUser = cache[accountId] || defaultCachedUser;

            return {
                avatarURL: cachedUser.avatarURL,
                displayName: cachedUser.displayName,
                fullname: cachedUser.fullname,
                sub: cachedUser.sub
            };
        });
    }

    /**
     * Caches information about a user by account ID.
     *
     * @param {AtlassianUser} user
     */
    function cacheUser(user) {
        // This value is used to identify the color of the collaborator.
        var sub = subs.indexOf(user.accountId);
        if (sub === -1) {
          subs.push(user.accountId);
          sub = subs.length - 1;
        }

        /** @type {User} */
        var cachedUser = {
          sub: sub,
          displayName: user.displayName || ANONYMOUS,
          fullname: user.displayName || ANONYMOUS,
          avatarURL: (user.profilePicture || {}).path || defaultProfilePic
        };

        if (user.accountId && user.accountId !== ANONYMOUS) {
            cache[user.accountId] = cachedUser;
        }
    }

    /**
     * Fetches user objects for each account ID and username.
     *
     * @param {(string[] | string)=} accountIds User account IDs to fetch information for.
     * @returns {Promise<User[]>} A list of user objects.
     */
    function userInformation(accountIds) {
        // If null, just return an empty array
        if (!accountIds) {
            return Promise.resolve([]);
        }

        // If not an array, it's probably a single ID
        if (!Array.isArray(accountIds)) {
            accountIds = [accountIds];
        }

        return new Promise(function (resolve) {
            // Find all the non-cached account IDs. We'll need to fetch these
            var nonCachedAccountIds = accountIds.filter(function (accountId) {
                return accountId &&
                    accountId !== ANONYMOUS &&
                    !cache[accountId];
            });

            // If we don't have any non-cached items, then we can immediately
            // resolve.
            if (!nonCachedAccountIds.length) {
                return resolve(getCachedUsersByID(accountIds));
            }

            var searchString = '?accountId=' + nonCachedAccountIds.join(',');

            // Fetch the non-cached users
            $.ajax({
                url: API_CONSTANTS.CONTEXT_PATH + '/rest/api/user/bulk' + searchString,
                dataType: 'json',
                type: 'GET',
                contentType: 'application/json',
                success: function (/** @type SearchPageResponseSearchResult */ response) {
                    // Loop through each result and cache it
                    (response.results || []).forEach(function (user) {
                        if (!user) {
                            return;
                        }

                        cacheUser(user);
                    });

                    // Since we've fetched the missing users and cached them,
                    // let's grab the info from the cache and resolve the
                    // promise.
                    resolve(getCachedUsersByID(accountIds));
                },
                error: function (response) {
                    console.error('Failed to fetch user data: ' + response.statusText);

                    // We failed, but there may be some user information that's
                    // cached.
                    resolve(getCachedUsersByID(accountIds));
                }
            });
        });
    }

    return userInformation;
});
}catch(e){WRMCB(e)};
;
try {
/* module-key = 'com.atlassian.confluence.editor:page-editor-quit-dialog', location = 'com/atlassian/confluence/tinymceplugin/editor/page-editor-quit-dialog.js' */
define("confluence-editor/editor/page-editor-quit-dialog", [
    "jquery",
    "confluence/templates",
    "ajs",
    "confluence/meta",
    "window",
    "document",
    "confluence-editor/editor/page-editor-message",
    "confluence/api/constants",
    "underscore",
    "confluence/legacy-editor-global-AVOID-IF-POSSIBLE",
    "confluence/dark-features",
    'confluence-collaborative-editor-plugin/cql-user-information',
    'confluence-collaborative-editor-plugin/user-information'
], function(
        $,
        Templates,
        AJS,
        Meta,
        window,
        document,
        Message,
        CONSTANTS,
        _,
        Editor,
        DarkFeatures,
        cqlUserInfo,
        userInfo
) {
    "use strict";

    var exports = {};
    var UI = {};
    var isPagePublished;
    var needDialog;
    var Type = {
        DELETE: "delete",
        REVERT: "revert",
        PUBLISH: "publish",
        UPDATE: "update",
        SHOW_DIFF: "diff"
    };
    var contributors = [];
    var isInitialized = false;
    var ExternalHandlers = {};
    var previousDialogType;
    var publishSuccessDeferred;

    exports.init = function(options) {
        needDialog = Meta.get("content-type") === "page" || Meta.get("content-type") === "blogpost";
        if (needDialog) {
            if (!isInitialized) {
                isPagePublished = !Meta.get("new-page");

                UI.discardButton = $("#qed-discard-button").tooltip({gravity: 's', className: 'quit-editor-dialog'});
                UI.discardButton.click(clickDiscard);

                UI.saveExitButton = $("#qed-save-exit-button").click(clickSaveExit);
                //publish button in the dialog
                UI.publishButton = $("#qed-publish-button");
                //close button in the dialog
                UI.closeButton = $("#qed-close-button").click(closeDialog);
                UI.buttonsAll = [UI.discardButton, UI.saveExitButton, UI.hideDiffButton, UI.publishButton];
                UI.dialog = AJS.dialog2("#quit-editor-dialog");
                UI.dialogEl = UI.dialog.$el;
                UI.dialogHeader = UI.dialogEl.find(".aui-dialog2-header");
                UI.dialogContent = UI.dialogEl.find(".aui-dialog2-content");
                UI.dialogFooter = UI.dialogEl.find(".aui-dialog2-footer");
                UI.editorForm = $("#wysiwyg").closest("form");

                $("#rte-show-changes").on("click", clickShowChanges);
                $("#rte-show-revert").on("click", clickRevertChanges);
                $("#rte-show-migrate").on("click", clickMigrate);

                UI.dialog.on("hide", onHideDialog);

                AJS.bind('editor-heartbeat', fetchContributors);

                isInitialized = true;
            }
            if (options) {
                ExternalHandlers.save = options.saveHandler;
                UI.publishButton.click(clickPublish);
            }
        }
    };

function clickShowDiff(e) {
    e.stopPropagation();
    e.preventDefault();

    AJS.trigger("analyticsEvent", {
        name: "confluence.synchrony.editor.quit-dialog.show-diff-clicked"
    });

    UI.showDiffButton.hide();

    showUnpublishedChanges(false);

    UI.hideDiffButton.show();
}

function clickHideDiff(e) {
    e.stopPropagation();
    e.preventDefault();

    AJS.trigger("analyticsEvent", {
        name: "confluence.synchrony.editor.quit-dialog.hide-diff-clicked"
    });

    UI.hideDiffButton.hide();
    UI.closeButton.show();

        //resize dialog smaller
        UI.dialogEl.removeClass("aui-dialog2-xlarge").addClass("aui-dialog2-medium");
        displayDialog(previousDialogType);
    }

    function clickDiscard (e) {
        AJS.trigger("analyticsEvent", {
            name: "confluence.synchrony.editor.quit-dialog.discard"
        });
        AJS.trigger("confluence.legacy-editor.discard-changes.started");
        e.stopPropagation();
        e.preventDefault();
        Editor.UI.setButtonsState(false, UI.buttonsAll);
        discardThenLeaveEditor(Meta.get("content-id"));
    }

    function submitFormAsCancelAction() {
        UI.editorForm.append(Templates.Editor.Page.hiddenInputCancel()).submit();
    }

    function clickSaveExit(e) {
        if (e) {
            e.stopPropagation();
            e.preventDefault();
        }
        AJS.trigger("confluence.legacy-editor.close.succeeded");
        submitFormAsCancelAction();
    }

    function clickPublish(e) {
        Editor.UI.setButtonsState(false, UI.buttonsAll);
        ExternalHandlers.save(e).done(function () {
            publishSuccessDeferred.resolve();
        });
    }

    function clickShowChanges(e) {
        e.stopPropagation();
        e.preventDefault();

        previousDialogType = null;

        AJS.trigger("analyticsEvent", {
            name: "confluence.synchrony.editor.draft-status-indicator.click"
        });

        UI.closeButton.show();

        showUnpublishedChanges(true);
    }

    function clickRevertChanges(e) {
        e.stopPropagation();
        e.preventDefault();

        UI.closeButton.show();

        if(Meta.get('new-page')) {
            displayDialog(Type.DELETE);
        } else {
            displayDialog(Type.REVERT);
        }
    }

    function clickMigrate(e) {
        e.stopPropagation();
        e.preventDefault();

        // If the draft is dirty, save it before migrating so you don't loose any content.
        if (Editor.Drafts.isDraftDirty()) {
            triggerDraftAutosave(triggerMigrate);
        } else {
            triggerMigrate();
        }
    }

    function triggerMigrate() {
        var contentId = Meta.get("content-id");
        var spaceKey = Meta.get("space-key");
        var fabricEditorUrl = CONSTANTS.CONTEXT_PATH + '/spaces/'+ spaceKey + '/pages/edit-v2/' + contentId;
        // Check if the content is migratable.
        $.ajax({
            url: CONSTANTS.CONTEXT_PATH + "/rest/api/content/" + contentId + "?status=draft&expand=body.atlas_doc_format,metadata.properties.editor",
            type: "GET"
        }).success(function (response) {
            if (response.body.atlas_doc_format.value.includes("\"extensionKey\":\"__confluenceADFMigrationUnsupportedContentInternalExtension__\"")) {
                Message.handleMessage("collaborative-editor-discard-error", {
                    type: "error",
                    title: "Your page is not migratable to Fabric Editor!",
                    message: "Your page contains content, that is not migratable to Fabric Editor."
                });
            } else {
                // Add the editor v2 property to mark the content for fabric editor.
                // FIXME CFE-2417 Remove saving of the content property, it is implementation detail!
                // Instead of adding the content property, this should
                // save the draft in ADF which then automatically adds the property

                if (response.metadata.properties.editor) {
                    // Editor property exists, update it.
                    $.ajax({
                        url: CONSTANTS.CONTEXT_PATH + "/rest/api/content/" + contentId + "/property/editor",
                        type: "PUT",
                        data: JSON.stringify({
                            key: "editor",
                            value: "v2",
                            version: {
                                number: response.metadata.properties.editor.version.number + 1,
                                minorEdit: false
                            }
                        }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json"
                    }).success(function () {
                        // Navigate the user to the fabric editor.
                        window.location.href = fabricEditorUrl;
                    }).fail(function (data) {
                        displayMigrationError();
                    });
                } else {
                    // Editor property doesn't exist. Create one.
                    $.ajax({
                        url: CONSTANTS.CONTEXT_PATH + "/rest/api/content/" + contentId + "/property",
                        type: "POST",
                        data: JSON.stringify({
                            key: "editor",
                            value: "v2",
                            version: {
                                number: 1,
                                minorEdit: false
                            }
                        }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json"
                    }).success(function () {
                        // Navigate the user to the fabric editor.
                        window.location.href = fabricEditorUrl;
                    }).fail(function (data) {
                        displayMigrationError();
                    });
                }
            }
        }).fail(function (data) {
            displayMigrationError();
        });
    }

    function displayMigrationError() {
        Message.handleMessage("collaborative-editor-discard-error", {
            type: "error",
            title: "Something went wrong migrating page to Fabric Editor!",
            message: "Please reload your editor and try again."
        });
    }



    function closeDialog(e) {
        e.stopPropagation();
        e.preventDefault();

        UI.dialog.hide();
    }

    function showUnpublishedChanges(forceDraftAutosave) {
        function fetchDiff() {
            $.ajax({
                url: CONSTANTS.CONTEXT_PATH + "/rest/tinymce/1/content/" + Meta.get("page-id") + "/draft/diff",
                type: "GET"
            }).success(function (response) {
                $(".diff-spinner").hide();
                var $diffBody = UI.dialogContent.find(".wiki-content").html(response);

                // hide HR to avoid 2 separators
                if ($diffBody.children().first().hasClass("diff-context-placeholder")) {
                    UI.dialogContent.find("hr").hide();
                }
            });
        }

        // Use larger dialog class.
        UI.dialogEl.removeClass("aui-dialog2-medium").addClass("aui-dialog2-xlarge");
        displayDialog(Type.SHOW_DIFF);
        $(".diff-spinner").show();

        if (forceDraftAutosave) {
            triggerDraftAutosave(fetchDiff);
        } else {
            fetchDiff();
        }
    }

    exports.process = function(e) {
        if (needDialog) {
            e.stopPropagation();
            e.preventDefault();

            $(window).one('editor-heartbeat', function (ev, data) {
                switch(e.target.id) {
                    case Editor.UI.saveButton.attr("id"):
                    case Editor.UI.versionCommentInput.attr("id"):
                        processPublish();
                        break;
                    case Editor.UI.cancelButton.attr("id"):
                        processClose();
                        break;
                }
            });

            //explicitly invoke method to get latest contributors list
            Editor.heartbeat();

            publishSuccessDeferred = $.Deferred();
            return publishSuccessDeferred.promise();
        }

        var deferred = $.Deferred();
        deferred.fail();
        return deferred.promise();
    };

    function processPublish() {
        //toggle busy to avoid pressing Cmd+S will duplicate action
        Editor.UI.toggleSavebarBusy(true);
        if (contributors.length === 0) {
            //don't show dialog, just process to save
            ExternalHandlers.save().done(function() {
                publishSuccessDeferred.resolve();
            });
        } else {
            triggerDraftAutosave();

            var publishType = isPagePublished ? Type.UPDATE : Type.PUBLISH;
            displayDialog(publishType);
        }
    }

    function processClose() {
        if (Editor.Drafts.isDraftDirty()) {
            triggerDraftAutosave();
        }
        clickSaveExit();
    }

    exports.requireSynchronyPresence = function() {
        return require('confluence-collaborative-editor-plugin/synchrony-presence');
    };

    function addWarning() {
        UI.dialogEl.addClass("aui-dialog2-warning");
    }

    function removeWarning() {
        UI.dialogEl.removeClass("aui-dialog2-warning");
    }

    function displayDialog(dialogType) {
        function isShowingDiffOnRevertDialog() {
            return dialogType === Type.SHOW_DIFF && (previousDialogType === Type.REVERT || previousDialogType === Type.DELETE);
        }

        var synchronyPresence = exports.requireSynchronyPresence();
        contributors = contributors.map(function(contributor) {
            if (synchronyPresence) {
                contributor.active = synchronyPresence.isUserActive(contributor.accountId);
            }
            return contributor;
        }).sort(function(contributor1, contributor2) {
            if (contributor1.active && !contributor2.active) {
                return false;
            }
            if (!contributor1.active && contributor2.active) {
                return true;
            }
            return contributor1.lastModification < contributor2.lastModification;
        });

        var headerType = dialogType;

        if (isShowingDiffOnRevertDialog()) {
            headerType = previousDialogType;
        }

        function domElementsHandler(contributors) {
          UI.dialogHeader.html(Templates.Editor.Page.quitDialogHeader({
            dialogType: headerType,
            contentType: Meta.get("content-type"),
            newPage: Meta.get('new-page')
          }));

          UI.dialogContent.html(Templates.Editor.Page.quitDialogContent({
            dialogType: dialogType,
            contributors: contributors,
            contentType: Meta.get("content-type"),
            newDialog: previousDialogType == null
          }));

          UI.hideDiffButton = $("#qed-hide-diff-button").click(clickHideDiff);

          if (!Meta.get('new-page')) {
            if (dialogType !== Type.SHOW_DIFF) {
              previousDialogType = dialogType;
            }

            UI.showDiffButton = $("#qed-show-diff-button").click(clickShowDiff);
            UI.showDiffButton.show();
            UI.buttonsAll.push(UI.showDiffButton);
          }

          if (dialogType === Type.DELETE || dialogType === Type.REVERT || isShowingDiffOnRevertDialog()) {
            UI.discardButton.show();
            addWarning();
          } else {
            removeWarning();
          }

          UI.closeButton.show();

          //only show buttons that suitable for a dialogType
          UI.dialogFooter.find("." + dialogType).show();

          UI.dialog.show();
        }

        userInfo(contributors.map(function (contributor) {
            return contributor.accountId;
        })).then(domElementsHandler);
    }

    function onHideDialog() {
        AJS.trigger("analyticsEvent", {
            name: "confluence.synchrony.editor.quit-dialog.dialog-closed"
        });
        UI.dialogEl.removeClass("aui-dialog2-xlarge").addClass("aui-dialog2-medium");
        Editor.UI.toggleSavebarBusy(false);
        UI.dialogFooter.find(".aui-button").hide();
        UI.dialogContent.empty();
    }

    function discardThenLeaveEditor(contentId) {
        var contextPath = AJS.contextPath();
        var url = isPagePublished ?
            contextPath + "/rest/synchrony/1.0/content/" + contentId + "/changes/unpublished" :
            contextPath + '/rest/api/content/' + contentId + '?status=draft';

        if (isPagePublished) {
            // suppress the message from synchrony-editor.js that indicates a different user performed a revert
            Message.suppressMessage("editor.synchrony.revert-page");

            // CFE-845: Editor.js in confluence-frontend-server is listening to this event
            $(window).trigger("revert.tinymce", { pageVersion: AJS.params.pageVersion || "null" });
        } else {
            // CFE-845: Editor.js in confluence-frontend-server is listening to this event
            $(window).trigger("delete.tinymce");
        }

        $.ajax({
            url: url,
            type: 'DELETE',
            data: {
                draftId: contentId
            },
            contentType: "application/json",
            dataType: "json"
        }).done(function () {
            if (isPagePublished) {
                Message.handleMessage("collaborative-editor-discard-error", {
                    type: "success",
                    close: "auto",
                    message: "Restablecido correctamente a la \u00faltima versi\u00f3n publicada"
                });
            }
            AJS.trigger("analyticsEvent", {
                name: "confluence.synchrony.editor.quit-dialog.discard-success",
                data: {
                    contentId: contentId
                }
            });
            AJS.trigger("confluence.legacy-editor.discard-changes.succeeded");
            submitFormAsCancelAction();
        }).fail(function (data) {
            var response = JSON.parse(data.responseText);
            var deleteFailedTitle =  "Se han producido errores al descartar tu borrador.";
            var deleteFailedMessage = data["errors"] || "Se ha producido un error desconocido. Consulta tu registro.";

            if (response.data && response.data.errors && response.data.errors[0] && response.data.errors[0].message.key === 'content.delete.published') {
                deleteFailedTitle = "Esta p\u00e1gina ya se ha publicado";
                deleteFailedMessage = "No se puede descartar este borrador porque ya no es un borrador.";
            }

            Message.handleMessage("collaborative-editor-discard-error", {
                type: "error",
                title: isPagePublished ? "No es posible volver a la \u00faltima versi\u00f3n publicada" : deleteFailedTitle,
                message: isPagePublished ? "No podemos obtener la \u00faltima versi\u00f3n publicada de la p\u00e1gina en este momento. Espera unos minutos y prueba a descartar el borrador de nuevo." : deleteFailedMessage
            });
            AJS.trigger("analyticsEvent", {
                name: "confluence.synchrony.editor.quit-dialog.discard-error",
                data: {
                    contentId: contentId
                }
            });
            AJS.trigger("confluence.legacy-editor.discard-changes.failed");
            UI.dialog.hide();
            // Re-enable buttons here to allow the user to resubmit.
            Editor.UI.setButtonsState(true, UI.buttonsAll);
        });
    }

    function fetchContributors(e, data) {
        if (data && data.contributors) {
            //exclude myself from the list
            contributors = _.reject(data.contributors, function (contributor) {
                return contributor.accountId === Meta.get("atlassian-account-id") || contributor.name === Meta.get("remote-user");
            });
        }
    }

    function triggerDraftAutosave(onSuccessHandler) {
        //this is to make sure the diff is up to date.
        Editor.Drafts.save({forceSave: isPagePublished, skipErrorHandler: true, onSuccessHandler: onSuccessHandler || $.noop});
    }

    /**
     * Reset module's state (for testing purpose)
     * @private
     */
    exports._destroy = function() {
        isInitialized = false;
    };

    return exports;
});

}catch(e){WRMCB(e)};
;
