    case 'revert':
      output += (opt_data.newPage) ? (opt_data.contentType == 'blogpost') ? '<h2 class="aui-dialog2-header-main">' + soy.$$escapeHtml('\xbfBorrar entrada de blog sin publicar?') + '</h2>' : '<h2 class="aui-dialog2-header-main">' + soy.$$escapeHtml('\xbfBorrar p\xe1gina sin publicar?') + '</h2>' : '<h2 class="aui-dialog2-header-main">' + soy.$$escapeHtml('\xbfVolver a la \xfaltima versi\xf3n publicada?') + '</h2>';
      break;
    case 'publish':
    case 'update':
      output += '<h2 class="aui-dialog2-header-main">' + soy.$$escapeHtml('\xbfPublicar la p\xe1gina?') + '</h2>';
      break;
    case 'diff':
      output += '<h2 class="aui-dialog2-header-main">' + soy.$$escapeHtml('Cambios no publicados') + '</h2>';
      break;
  }
  output += '<a class="aui-dialog2-header-close"><span class="aui-icon aui-icon-small aui-iconfont-close-dialog">' + soy.$$escapeHtml('Cerrar') + '</span></a>';
  return output;
};
if (goog.DEBUG) {
  Confluence.Templates.Editor.Page.quitDialogHeader.soyTemplateName = 'Confluence.Templates.Editor.Page.quitDialogHeader';
}


Confluence.Templates.Editor.Page.quitDialogContent = function(opt_data, opt_ignored) {
  var output = '';
  switch (opt_data.dialogType) {
    case 'revert':
      output += (opt_data.contributors.length == 0) ? ((opt_data.contentType == 'blogpost') ? soy.$$filterNoAutoescape('Esta acci\xf3n borrar\xe1 de forma permanente todos los cambios que hayas realizado desde la \xfaltima vez que se public\xf3 la entrada de blog.') : soy.$$filterNoAutoescape('Esta acci\xf3n borrar\xe1 de forma permanente todos los cambios que hayas realizado desde la \xfaltima vez que se public\xf3 la p\xe1gina.')) + '<div class="aui-dialog2-footer-hint"><a id="qed-show-diff-button" class="aui-button aui-button-link">' + soy.$$escapeHtml('Mostrar cambios') + '</a></div>' : soy.$$filterNoAutoescape('Esta acci\xf3n borrar\xe1 de forma permanente todos los cambios que las siguientes personas hayan realizado desde la \xfaltima vez que se public\xf3 la p\xe1gina.') + '<div class="aui-dialog2-footer-hint"><a id="qed-show-diff-button" class="aui-button aui-button-link">' + soy.$$escapeHtml('Mostrar cambios') + '</a></div>' + Confluence.Templates.Editor.Page.contributorList(opt_data);
      break;
    case 'delete':
      output += (opt_data.contributors.length == 0) ? (opt_data.contentType == 'blogpost') ? soy.$$filterNoAutoescape('Una vez que borres una entrada de blog sin publicar, la habr\xe1s perdido para siempre.') : soy.$$filterNoAutoescape('Si borras una p\xe1gina sin publicar, la perder\xe1s para siempre.') : ((opt_data.contentType == 'blogpost') ? soy.$$filterNoAutoescape('Esta acci\xf3n borrar\xe1 de forma permanente la entrada de blog en la que t\xfa y otras personas hab\xe9is trabajado.') : soy.$$filterNoAutoescape('Esta acci\xf3n borrar\xe1 de forma permanente la p\xe1gina en la que t\xfa y otras personas hab\xe9is trabajado.')) + Confluence.Templates.Editor.Page.contributorList(opt_data);
      break;
    case 'publish':
    case 'update':
      output += soy.$$filterNoAutoescape('Tambi\xe9n publicar\xe1s los cambios que hayan realizado estas personas:') + Confluence.Templates.Editor.Page.contributorList(opt_data);
      break;
    case 'diff':
      output += '<div><div class="legend"><span class="legend-title">' + soy.$$escapeHtml('Clave') + ': </span><span class="diff-html-added">' + soy.$$escapeHtml('Se ha a\xf1adido esta l\xednea.') + '</span><span class="diff-html-removed">' + soy.$$escapeHtml('Se ha eliminado esta l\xednea.') + '</span><span class="diff-html-changed">' + soy.$$escapeHtml('El formato se ha cambiado.') + '</span></div>' + ((! opt_data.newDialog) ? '<a class="aui-button aui-button-link" id="qed-hide-diff-button">' + soy.$$escapeHtml('Mostrar colaboradores') + '</a>' : '') + '<hr/><div class="wiki-content"></div><span class="aui-icon aui-icon-wait diff-spinner"></span></div>';
      break;
  }
  return output;
};
if (goog.DEBUG) {
  Confluence.Templates.Editor.Page.quitDialogContent.soyTemplateName = 'Confluence.Templates.Editor.Page.quitDialogContent';
