ra obtener todas las incidencias.') + '</div></div></fieldset><fieldset><div class="field-group"><select id="jiraIssueColumnSelector" data-placeholder="' + soy.$$escapeHtml('Comenzar a escribir para ver la cantidad de columnas posibles') + '" multiple="true" class="select long-field"></select><label for="jiraIssueColumnSelector">' + soy.$$escapeHtml('Columnas que mostrar') + '</label></div></fieldset></div></form></div>';
