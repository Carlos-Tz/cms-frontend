Confluence.Templates.Roadmap.footerActionContent = function(opt_data, opt_ignored) {
  return '' + ((opt_data.roadmapShouldAutoSave) ? '<span class="autosave-text">' + soy.$$escapeHtml('Este planificador de hojas de ruta se guarda autom\xe1ticamente cada 15 segundos.') + '</span>' : '') + aui.buttons.button({text: 'Insertar', id: 'roadmapInsertBtn'}) + ((opt_data.roadmapShouldAutoSave) ? aui.buttons.button({text: 'Cerrar', type: 'link', id: 'roadmapCloseBtn'}) : aui.buttons.button({text: 'Cancelar', type: 'link', id: 'roadmapCancelBtn'}));
};
if (goog.DEBUG) {
  Confluence.Templates.Roadmap.footerActionContent.soyTemplateName = 'Confluence.Templates.Roadmap.footerActionContent';
}

