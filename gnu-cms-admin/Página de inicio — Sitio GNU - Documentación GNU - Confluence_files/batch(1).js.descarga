            return this;
        },

        updateHeight: function (height) {
            this.$el.height(height);
        },

        update: function () {
            this.render();
        },

        getSizeAndPosition: function () {
            return {
                width: this.$el.width(),
                height: this.$el.height(),
                left: this.$el.position().left,
                top: this.$el.position().top
            };
        }
    });
})(AJS.$, window._);

}catch(e){WRMCB(e)};
;
