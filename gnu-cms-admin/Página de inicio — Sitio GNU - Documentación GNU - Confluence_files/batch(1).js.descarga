    output += '<li data-username="' + soy.$$escapeHtml(contributorData147.name) + '" data-account-id="' + soy.$$escapeHtml(contributorData147.accountId) + '"><div class="contributor-avatar ' + ((contributorData147.active) ? 'active' : '') + '"><img src="' + soy.$$escapeHtml(contributorData147.avatarURL) + '"></div><div class="contributor-detail"><p class="contributor-detail-name"><span>' + soy.$$escapeHtml(contributorData147.fullname) + '</span></p><p class="contributor-detail-last-modification"><span>' + soy.$$escapeHtml('\xdaltima edici\xf3n') + ' ' + soy.$$escapeHtml(contributorData147.formattedLastModification) + '</span></p></div></li>';
  }
  output += '</ul>';
  return output;
};
