/* module-key = 'confluence.extra.masterdetail:details-summary-resources', location = 'com/atlassian/confluence/extra/masterdetail/js/detailssummary-fields.js' */
/*eslint-disable confluence/deprecated-identifier, confluence/must-use-amd, no-undef */
AJS.toInit(function ($) {

    function useLiveDocsCopy() {
        return true;
    }

    var overrides = {
        fields: {
            "string": {
                "id": function idField(param, options) {
                    if (useLiveDocsCopy()) {
                        param.displayName = "ID de propiedades de contenido (opcional)";
                        param.description = "Si tienes varias macros de propiedades de contenido en una p\u00e1gina o en un doc en vivo y quieres informar sobre uno en particular, introduce el ID de esa macro. Deja el campo vac\u00edo para incluir todas las macros.";
                    }
                    return AJS.MacroBrowser.ParameterFields["string"](param, options);
                },
                "firstcolumn": function firstColumnField(param, options) {
                    if (useLiveDocsCopy()) {
                        param.description = "Cambia el encabezado de la columna de t\u00edtulo que contiene enlaces al contenido (35\u00a0caracteres como m\u00e1ximo).";
                    }
                    return AJS.MacroBrowser.ParameterFields["string"](param, options);
                },
                "headings": function headingsField(param, options) {
                    if (useLiveDocsCopy()) {
                        param.description = "Lista de columnas separadas por coma para incluir en la tabla. El t\u00edtulo de la p\u00e1gina se muestra siempre.";
                    }
                    return AJS.MacroBrowser.ParameterFields["string"](param, options);
                }
            }
        },

        beforeDialogShow: function beforeDialogShow(title) {
            // Set macro browser header to just the macro title
            AJS.MacroBrowser.dialog.gotoPage(1).addHeader(title);
        }
    };

    AJS.MacroBrowser.setMacroJsOverride("detailssummary", overrides);
});

}catch(e){WRMCB(e)};