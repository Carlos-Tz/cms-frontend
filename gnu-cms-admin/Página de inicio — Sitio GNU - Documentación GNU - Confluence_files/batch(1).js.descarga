Confluence.Templates.File.helpLink = function(opt_data, opt_ignored) {
  return '<div class="dialog-help-link"><a href="' + soy.$$escapeHtml("https://confluence.atlassian.com/display/ConfCloud/Display+Files+and+Images") + '" target="_blank">' + soy.$$escapeHtml('Ayuda') + '</a></div>';
