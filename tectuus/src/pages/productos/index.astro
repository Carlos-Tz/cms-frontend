---
import Layout from "../../layouts/Layout.astro";
import SectionRenderer from "../../components/SectionRenderer.astro";
import PageHero from "../../components/sections/PageHero.astro";
import ProductCatalog from "../../components/ProductCatalog.astro";
import { fetchData } from "../../functions/fetch";
import { fetchAllProducts, fetchCategories, fetchProductDetails } from "../../functions/catalog";
import type { PageResponse } from "../../types/page";

const pageResponse: PageResponse | undefined = await fetchData("pages/productos");
const page = pageResponse?.data;
const sections = page?.sections ?? [];

// The catalog is a data domain, not a section of this page: the CMS page only
// carries the hero, and categories/products are managed as their own rows.
const [categories, listing] = await Promise.all([fetchCategories(), fetchAllProducts()]);

// Most products have no image, so the cards are built from text, and the
// listing leaves out `description`; each product's detail fills it in.
const details = await fetchProductDetails(listing);
const products = listing.map((product) => ({
  ...product,
  description: details.get(product.slug)?.description ?? null,
}));
---

<Layout title={page?.title ?? "Productos"}>
  {!page && <PageHero title="Productos" subtitle="Equipo industrial para gas natural." />}
  <SectionRenderer sections={sections} pageSlug={page?.slug ?? "productos"} />
  <ProductCatalog categories={categories} products={products} />
</Layout>
