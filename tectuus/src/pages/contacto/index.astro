---
import Layout from "../../layouts/Layout.astro";
import SectionRenderer from "../../components/SectionRenderer.astro";
import PageHero from "../../components/sections/PageHero.astro";
import LeadCaptureForm from "../../components/sections/LeadCaptureForm.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import { fetchData } from "../../functions/fetch";
import type { PageResponse } from "../../types/page";

const pageResponse: PageResponse | undefined = await fetchData("pages/contacto");
const page = pageResponse?.data;
const sections = page?.sections ?? [];
---

<Layout title={page?.title ?? "Contacto"}>
  {!page && (
    <>
      <PageHero title="Contacto" subtitle="Estamos para ayudarte." />
      <section class="section" id="contacto">
        <div class="container contact-split">
          <ContactPanel />
          <LeadCaptureForm
            formId="contacto-lead-form"
            source="contacto"
            title="Escríbenos"
            intro="Déjanos tus datos y un asesor se comunicará contigo."
            submit_label="Hablar con un asesor"
          />
        </div>
      </section>
    </>
  )}
  <SectionRenderer sections={sections} pageSlug={page?.slug ?? "contacto"} />
</Layout>
