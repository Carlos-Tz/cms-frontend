---
import { Image } from 'astro:assets';
import noimg from '../../assets/images/noimg.jpg';

const nav = [
	{ href: '#inicio', label: 'Inicio' },
	{ href: '#nosotros', label: 'Sobre nosotros' },
	{ href: '#productos', label: 'Productos' },
	{ href: '#contacto', label: 'Contacto' },
];

const productos = [
	{
		name: 'EDRM',
		full: 'Estación de Regulación y Medición',
		desc: 'Diseño, fabricación e instalación de estaciones de regulación y medición de gas natural, con control de presión y medición certificada para procesos industriales.',
	},
	{
		name: 'Compresoras',
		full: 'Sistemas de compresión',
		desc: 'Equipos de compresión de gas natural dimensionados a la demanda de tu planta, con mantenimiento preventivo y monitoreo remoto.',
	},
	{
		name: 'Valvulería',
		full: 'Válvulas industriales',
		desc: 'Suministro de válvulas y accesorios de alta especificación para líneas de gas natural, cumpliendo normativa nacional e internacional.',
	},
];

const clientes = Array.from({ length: 6 });
const banners = [
	{ eyebrow: 'Ingeniería en gas natural', title: 'Soluciones integrales para tu industria', text: 'Diseñamos, instalamos y damos mantenimiento a sistemas de gas natural para plantas industriales en todo México.' },
	{ eyebrow: 'Más de una década de experiencia', title: 'Seguridad y eficiencia en cada proyecto', text: 'Equipos certificados y personal especializado que acompañan tu operación de principio a fin.' },
	{ eyebrow: 'Servicio y mantenimiento', title: 'Tu operación, siempre en marcha', text: 'Monitoreo y mantenimiento preventivo para que tu suministro de gas natural nunca se detenga.' },
];

const currentYear = 2026;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Tectuus — Ingeniería y soluciones en gas natural: EDRM, compresoras y valvulería para la industria." />
		<title>Tectuus — Soluciones en gas natural para tu industria</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<div class="wrap site-header__inner">
				<a class="brand" href="#inicio">
					<span class="brand__mark" aria-hidden="true">
						<img src="/favicon.svg" alt="" width="22" height="22" />
					</span>
					<span class="brand__text">TECTUUS</span>
				</a>

				<input type="checkbox" id="nav-toggle" class="nav-toggle" />
				<label for="nav-toggle" class="nav-toggle__btn" aria-label="Abrir menú">
					<span></span><span></span><span></span>
				</label>

				<div class="nav-panel">
					<nav class="site-nav" aria-label="Principal">
						{nav.map((item) => (
							<a href={item.href}>{item.label}</a>
						))}
					</nav>

					<div class="site-header__side">
						<div class="social-row" aria-label="Redes sociales">
							<a href="#" aria-label="Facebook" class="social-icon">
