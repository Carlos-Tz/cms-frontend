					</button>

					<div class="carousel__dots" role="tablist" aria-label="Seleccionar diapositiva">
						{banners.map((_, i) => (
							<button
								type="button"
								class="carousel__dot"
								data-dot
								role="tab"
								aria-label={`Ir a la diapositiva ${i + 1}`}
