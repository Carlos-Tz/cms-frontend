							></button>
						))}
					</div>
				</div>
			</section>

			<!-- Nuestros clientes -->
			<section class="section section--muted" aria-label="Nuestros clientes">
				<div class="wrap">
					<p class="section__kicker">Nuestros clientes</p>
					<div class="clients-grid">
						{clientes.map(() => (
							<div class="clients-grid__item">
								<Image src={noimg} alt="Cliente" inferSize width={160} />
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- SOBRE NOSOTROS / ¿Quiénes somos? -->
			<section id="nosotros" class="section">
				<div class="wrap split">
					<div class="split__media">
						<Image src={noimg} alt="Equipo Tectuus en planta" inferSize width={640} />
					</div>
					<div class="split__copy">
						<span class="eyebrow">¿Quiénes somos?</span>
						<h2>Especialistas en gas natural para la industria</h2>
						<p>
							En Tectuus, parte de GNU Gas Natural, diseñamos e implementamos soluciones de gas natural
							a la medida de cada planta industrial: desde la estación de regulación y medición hasta
							la compresión y valvulería que mantienen tu operación segura y en marcha.
						</p>
						<p>
							Nuestro equipo acompaña cada proyecto de principio a fin, con ingeniería certificada,
							instalación y mantenimiento preventivo pensado para reducir paros no programados.
						</p>
					</div>
				</div>

				<div class="wrap">
					<div class="video-block">
						<video class="video-block__player" controls preload="none" poster={noimg.src}>
							<source src="" type="video/mp4" />
							Tu navegador no soporta el elemento de video.
						</video>
						<p class="video-block__caption">Conoce cómo trabajamos en campo</p>
					</div>
				</div>
			</section>

			<!-- PRODUCTOS -->
			<section id="productos" class="section section--muted">
				<div class="wrap">
					<span class="eyebrow">Productos</span>
					<h2>Todo lo que tu planta necesita en gas natural</h2>
					<div class="cards-grid">
						{productos.map((p) => (
							<article class="card card--product">
								<div class="card--product__media">
									<Image src={noimg} alt={p.name} inferSize width={480} />
								</div>
								<h3 class="card__title">{p.name}</h3>
								<p class="card__subtitle">{p.full}</p>
								<p class="card--product__desc">{p.desc}</p>
								<a class="btn-secondary" href="#contacto">Solicitar información</a>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- CONTACTO / Captación de leads -->
			<section id="contacto" class="section">
				<div class="wrap split split--reverse">
					<div class="split__copy">
						<span class="eyebrow">Contacto</span>
						<h2>Hablemos de tu proyecto</h2>
						<p>
							Cuéntanos sobre tu planta y necesidades de gas natural. Un especialista de Tectuus se
							pondrá en contacto contigo en menos de 24 horas.
						</p>
						<ul class="contact-list">
							<li><strong>Teléfono:</strong> (55) 0000 0000</li>
							<li><strong>Correo:</strong> contacto@tectuus.com</li>
							<li><strong>Ubicación:</strong> Ciudad de México, México</li>
						</ul>
					</div>
					<form class="card lead-form" method="post">
						<div class="field">
							<label for="nombre">Nombre</label>
							<input id="nombre" name="nombre" type="text" placeholder="Tu nombre" required />
						</div>
						<div class="field">
							<label for="empresa">Empresa</label>
							<input id="empresa" name="empresa" type="text" placeholder="Nombre de tu empresa" />
						</div>
						<div class="field">
							<label for="email">Correo</label>
							<input id="email" name="email" type="email" placeholder="tu@empresa.com" required />
						</div>
						<div class="field">
							<label for="telefono">Teléfono</label>
							<input id="telefono" name="telefono" type="tel" placeholder="(55) 0000 0000" />
						</div>
						<div class="field">
							<label for="mensaje">Mensaje</label>
							<textarea id="mensaje" name="mensaje" rows="4" placeholder="Cuéntanos sobre tu proyecto"></textarea>
							<span class="hint">Respondemos en menos de 24 horas hábiles.</span>
						</div>
						<button class="btn-primary lead-form__submit" type="submit">Enviar mensaje</button>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap site-footer__inner">
				<div class="brand brand--footer">
					<span class="brand__mark" aria-hidden="true">
						<img src="/favicon.svg" alt="" width="22" height="22" />
					</span>
					<span class="brand__text">TECTUUS</span>
				</div>

				<nav class="site-footer__nav" aria-label="Principal">
					{nav.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>

				<div class="social-row" aria-label="Redes sociales">
					<a href="#" aria-label="Facebook" class="social-icon social-icon--footer">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M13.5 21v-7.9h2.65l.4-3.08h-3.05V8.05c0-.89.25-1.5 1.52-1.5h1.63V3.84C15.94 3.76 15.06 3.7 14.03 3.7c-2.24 0-3.78 1.37-3.78 3.87v2.16H7.6v3.08h2.65V21h3.25Z"/></svg>
					</a>
					<a href="#" aria-label="Instagram" class="social-icon social-icon--footer">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 3.2c2.4 0 2.7 0 3.65.05 2.4.11 3.52 1.24 3.63 3.63.05.95.05 1.24.05 3.65s0 2.7-.05 3.65c-.11 2.4-1.23 3.52-3.63 3.63-.95.05-1.24.05-3.65.05s-2.7 0-3.65-.05c-2.4-.11-3.52-1.24-3.63-3.63C4.67 13.7 4.66 13.4 4.66 11s0-2.7.06-3.65C4.83 5 5.95 3.87 8.35 3.76 9.3 3.7 9.6 3.7 12 3.7Zm0-1.7C9.55 1.5 9.24 1.5 8.28 1.55c-3.09.14-4.8 1.85-4.95 4.94C3.3 7.45 3.3 7.76 3.3 10.2v1.6c0 2.44 0 2.75.05 3.71.14 3.09 1.85 4.8 4.94 4.94.96.05 1.27.05 3.71.05s2.75 0 3.71-.05c3.08-.14 4.8-1.85 4.94-4.94.05-.96.05-1.27.05-3.71v-1.6c0-2.44 0-2.75-.05-3.71-.14-3.08-1.85-4.8-4.94-4.94C14.75 1.5 14.44 1.5 12 1.5Zm0 5.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.75a3.05 3.05 0 1 1 0-6.1 3.05 3.05 0 0 1 0 6.1Zm5-7.94a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0Z"/></svg>
					</a>
					<a href="#" aria-label="LinkedIn" class="social-icon social-icon--footer">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.75h3.5V21H3.4V8.75Zm6.2 0h3.36v1.68h.05c.47-.87 1.6-1.8 3.3-1.8 3.53 0 4.18 2.24 4.18 5.16V21H16.9v-6.13c0-1.46-.03-3.35-2.05-3.35-2.05 0-2.37 1.58-2.37 3.24V21H9.6V8.75Z"/></svg>
					</a>
				</div>
			</div>
			<p class="site-footer__legal">GNU Gas Natural {currentYear} · Tectuus. Todos los derechos reservados.</p>
		</footer>

		<a class="whatsapp-fab" href="https://wa.me/5215500000000" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
			<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.28-1.39a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.4 1.33-1.94 1.4-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.16-4.94-4.35-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.29-.13.57.17.29.75 1.24 1.6 2 1.11.99 2.05 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.71-.83.9-1.11.19-.29.38-.24.63-.14.26.1 1.63.77 1.91.91.29.14.48.21.55.33.07.12.07.68-.17 1.36Z"/></svg>
		</a>

		<script>
			const root = document.querySelector('[data-carousel]');

			if (root) {
				const slides = Array.from(root.querySelectorAll('[data-slide]'));
				const dots = Array.from(root.querySelectorAll('[data-dot]'));
				const prevBtn = root.querySelector('[data-prev]');
				const nextBtn = root.querySelector('[data-next]');
				const AUTOPLAY_MS = 6000;
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				let index = 0;
				let timer = 0;

				function show(nextIndex: number) {
					index = (nextIndex + slides.length) % slides.length;
					slides.forEach((slide, n) => {
						const active = n === index;
						slide.classList.toggle('is-active', active);
						slide.toggleAttribute('inert', !active);
						slide.setAttribute('aria-hidden', active ? 'false' : 'true');
					});
					dots.forEach((dot, n) => {
						const active = n === index;
						dot.classList.toggle('is-active', active);
						dot.setAttribute('aria-selected', active ? 'true' : 'false');
					});
				}

				function next() { show(index + 1); }
				function prev() { show(index - 1); }

				function play() {
					stop();
					if (!reduceMotion) timer = window.setInterval(next, AUTOPLAY_MS);
				}
				function stop() {
					window.clearInterval(timer);
				}

				nextBtn?.addEventListener('click', () => { next(); play(); });
				prevBtn?.addEventListener('click', () => { prev(); play(); });
				dots.forEach((dot, n) => dot.addEventListener('click', () => { show(n); play(); }));

				root.addEventListener('mouseenter', stop);
				root.addEventListener('mouseleave', play);
				root.addEventListener('focusin', stop);
				root.addEventListener('focusout', play);

				let touchStartX = 0;
				root.addEventListener('touchstart', (e: Event) => { touchStartX = (e as TouchEvent).changedTouches[0].clientX; }, { passive: true });
				root.addEventListener('touchend', (e: Event) => {
					const dx = (e as TouchEvent).changedTouches[0].clientX - touchStartX;
					if (Math.abs(dx) > 40) {
						dx < 0 ? next() : prev();
						play();
					}
				}, { passive: true });

				show(0);
				play();
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		/* Backgrounds */
		--color-bg: #ffffff;
		--color-bg-muted: #f4f2f0;

		/* Brand — from the Tectuus sitemap board */
		--color-navy: #163a64;
		--color-navy-dark: #0e2946;
		--color-green: #2fa84c;
		--color-green-dark: #227d3a;
		--color-cyan: #3ec6ef;
		--color-taupe: #6b665e;
		--color-taupe-dark: #55514a;
		--color-heading-muted: #86807a;

		/* Text on light backgrounds */
		--color-text: #16202c;
		--color-text-60: rgba(22, 32, 44, 0.64);
		--color-text-40: rgba(22, 32, 44, 0.42);
		--color-text-on-dark: #ffffff;
		--color-text-on-dark-60: rgba(255, 255, 255, 0.68);

		/* Borders / surfaces */
		--color-border: rgba(22, 58, 100, 0.14);
		--color-border-hover: rgba(22, 58, 100, 0.3);
		--color-surface: rgba(22, 58, 100, 0.04);

		/* Radius & shadow */
		--radius-lg: 1rem;
		--radius-md: 0.5rem;
		--radius-full: 999px;
		--shadow-cta: 0 10px 30px -8px rgba(22, 58, 100, 0.35);
		--shadow-card: 0 4px 24px -8px rgba(22, 58, 100, 0.12);
	}

	* { box-sizing: border-box; }

	html { scroll-behavior: smooth; }

	body {
		margin: 0;
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		color: var(--color-text);
		background: var(--color-bg);
		-webkit-font-smoothing: antialiased;
	}

	img { max-width: 100%; display: block; }

	h1, h2, h3 { font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; margin: 0.5rem 0 1rem; }
	h1 { font-size: clamp(2rem, 4vw, 3rem); color: var(--color-text-on-dark); }
	h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); color: var(--color-navy); }
	h3 { font-size: 1.125rem; }
	p { line-height: 1.6; }

	.wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }

	.skip-link {
		position: absolute; left: -999px; top: 0; background: var(--color-navy);
		color: #fff; padding: 0.5rem 1rem; z-index: 100;
	}
	.skip-link:focus { left: 1rem; top: 1rem; }

	/* Eyebrow */
	.eyebrow {
		display: inline-block;
		border-radius: var(--radius-full);
		border: 1px solid rgba(47, 168, 76, 0.4);
		background: rgba(47, 168, 76, 0.1);
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
