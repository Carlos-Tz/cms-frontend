			</div>
		</header>

		<main id="contenido">
			<!-- INICIO / Carrusel de banners -->
			<section id="inicio" class="hero">
				<div class="carousel" data-carousel role="region" aria-roledescription="carrusel" aria-label="Destacados">
					<div class="carousel__track">
						{banners.map((b, i) => (
							<article class="carousel__slide" data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
								<div class="carousel__media">
									<Image src={noimg} alt="" inferSize width={1200} />
								</div>
								<div class="carousel__copy">
									<span class="eyebrow">{b.eyebrow}</span>
									<h1>{b.title}</h1>
									<p>{b.text}</p>
									<div class="hero__actions">
										<a class="btn-primary" href="#productos">Conoce nuestros productos</a>
										<a class="btn-secondary" href="#contacto">Contáctanos</a>
									</div>
								</div>
							</article>
						))}
					</div>

					<button type="button" class="carousel__arrow carousel__arrow--prev" data-prev aria-label="Diapositiva anterior">
