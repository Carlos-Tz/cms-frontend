---
import "../styles/global.css";
import { fetchData, FALLBACK_IMAGE } from "../functions/fetch";
import { fetchCategories } from "../functions/catalog";
import { seo } from "../config/seo";
import NavItem from "../components/nav/NavItem.astro";
import NavItemMobile from "../components/nav/NavItemMobile.astro";
import type { MenuItem, MenuResponse } from "../types/menu";
import type { GlobalsResponse } from "../types/globals";

interface Props {
  // Page-specific title, WITHOUT the site name — Layout appends
  // "{titleSeparator} {siteName}" automatically. Omit to fall back to
  // `seo.defaultTitle` (used as-is, already includes the site name).
  title?: string;
  description?: string;
  // Absolute or root-relative URL to a social preview image (og:image / twitter:image).
  image?: string | null;
  // Set true on pages that shouldn't be indexed (e.g. a "not found" state).
  noindex?: boolean;
  // Slug of the page being rendered, exposed as `data-page` on <main> so a
  // single page can carry its own typographic treatment (see the justified
  // copy on `inicio` in global.css).
  slug?: string | null;
}

const { title, description, image, noindex = false, slug = null } = Astro.props;

const pageTitle = title ? `${title} ${seo.titleSeparator} ${seo.siteName}` : seo.defaultTitle;
const pageDescription = description ?? seo.defaultDescription;
const socialImage = image ?? seo.defaultImage;
const canonicalUrl = new URL(Astro.url.pathname, seo.siteUrl).toString();
const socialImageUrl = socialImage ? new URL(socialImage, seo.siteUrl).toString() : null;

// Nav menu is CMS-driven (Landing Page → Menú). Falls back to the site's four
// top-level pages if the menu endpoint is unreachable.
const fallbackMenu: MenuItem[] = [
  { slug: "inicio", path: "/", title: "Inicio", children: [] },
  { slug: "sobre-nosotros", path: "/sobre-nosotros", title: "Sobre nosotros", children: [] },
  { slug: "productos", path: "/productos", title: "Productos", children: [] },
  { slug: "contacto", path: "/contacto", title: "Contacto", children: [] },
];

const menuResponse: MenuResponse | undefined = await fetchData("menu");
const cmsMenu: MenuItem[] = menuResponse?.data?.length ? menuResponse.data : fallbackMenu;

// The CMS menu is derived from the `pages` table, and product categories are
// rows the admin manages — not pages — so "Productos" always comes back with
// `children: []`. Its submenu is built here from the catalog instead.
const categories = await fetchCategories();
const categoryChildren: MenuItem[] = categories.map((category) => ({
  slug: category.slug,
  path: `/productos?category=${category.slug}`,
  title: category.name,
  children: [],
}));

const menuItems: MenuItem[] = cmsMenu.map((item) =>
  item.slug === "productos" && !item.children?.length ? { ...item, children: categoryChildren } : item
);

// Footer contact info, social links and the WhatsApp button are all editable
// from the CMS admin (Landing Page → Datos de contacto / Redes sociales /
// Botón de WhatsApp) and shared by every page, so they come from the
// site-wide `globals` endpoint. This layout wraps every page, so it fetches
// them here rather than relying on each page to pass them down.
const globalsResponse: GlobalsResponse | undefined = await fetchData("globals");
const globals = globalsResponse?.data;

const contactInfo = globals?.contact_info;
const socialIcons = globals?.social_icons;
const whatsappButton = globals?.whatsapp_button;

const footerEmail = contactInfo?.email ?? "contacto@tectuus.com";
const footerPhone = contactInfo?.phone;
const footerSchedule = contactInfo?.schedule;
const footerAddress = contactInfo?.address;
const footerAdditionalInfo = contactInfo?.additional_info;

// Brand glyphs from Font Awesome (loaded in <head>).
const SOCIAL_ICON_MARKUP: Record<string, string> = {
  facebook: '<i class="fa-brands fa-facebook-f" aria-hidden="true"></i>',
  instagram: '<i class="fa-brands fa-instagram" aria-hidden="true"></i>',
  linkedin: '<i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>',
  youtube: '<i class="fa-brands fa-youtube" aria-hidden="true"></i>',
  twitter: '<i class="fa-brands fa-x-twitter" aria-hidden="true"></i>',
};

const fallbackNetworks = [
  { network: "facebook", url: "#" },
  { network: "instagram", url: "#" },
  { network: "linkedin", url: "#" },
];
const socialNetworks = (socialIcons?.networks?.length ? socialIcons.networks : fallbackNetworks).filter(
  (item) => SOCIAL_ICON_MARKUP[item.network]
);

// No number in the CMS means no button. A WhatsApp link pointing at a
// placeholder number looks live and goes nowhere, which is worse than no CTA:
// the visitor writes and nobody ever reads it. `phone` is required by the
// section schema, so this only bites when `/globals` failed at build time.
const whatsappDigits = (whatsappButton?.phone ?? "").replace(/\D/g, "");
const whatsappHref = whatsappDigits
  ? `https://wa.me/${whatsappDigits}${
      whatsappButton?.prefilled_message ? `?text=${encodeURIComponent(whatsappButton.prefilled_message)}` : ""
    }`
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Archivo is loaded with its width axis: display type is set expanded
        (see --display-stretch), which is where the engineered feel comes from.
        IBM Plex Sans carries body copy. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />

    {/* Font Awesome supplies the site's UI icons (fa-solid / fa-brands). */}
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}

    <meta name="twitter:card" content={seo.twitterCard} />
    {seo.twitterHandle && <meta name="twitter:site" content={seo.twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

    <script is:inline define:vars={{ fallbackImage: FALLBACK_IMAGE }}>
      // A CMS image path can point at a file that was never uploaded, which
      // would drop a broken-image icon into the layout. Swap those for the
      // blank plate instead. Registered here in <head> with capture, since
      // error events fire during load and don't bubble.
      document.addEventListener(
        "error",
        (event) => {
          const el = event.target;
          if (el && el.tagName === "IMG" && el.dataset.fallback !== "1") {
            el.dataset.fallback = "1";
            el.src = fallbackImage;
          }
        },
        true
      );
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand">
          <img class="brand__logo" src="/logo-tectuus.png" alt="Tectuus — Technological Momentum" width="798" height="206" />
        </a>

        <nav class="nav" aria-label="Principal">
          {menuItems.map((item) => (
            <NavItem item={item} />
          ))}
        </nav>

        <div class="header-actions">
          <div class="social-row" style="margin-top: 0;" aria-label="Redes sociales">
            {socialNetworks.map((item) => (
              <a class="social-icon" href={item.url || "#"} target="_blank" rel="noopener noreferrer" aria-label={item.network}>
                <Fragment set:html={SOCIAL_ICON_MARKUP[item.network]} />
              </a>
            ))}
          </div>
          <a class="btn-primary btn-primary--compact" href="/contacto">Escríbenos</a>
        </div>

        <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="nav-mobile" id="nav-mobile" aria-label="Principal móvil">
        {menuItems.map((item) => (
          <NavItemMobile item={item} />
        ))}
        <a href="/contacto" class="btn-primary">Escríbenos</a>
        <div class="social-row social-row--nav-mobile" aria-label="Redes sociales">
          {socialNetworks.map((item) => (
            <a class="social-icon" href={item.url || "#"} target="_blank" rel="noopener noreferrer" aria-label={item.network}>
              <Fragment set:html={SOCIAL_ICON_MARKUP[item.network]} />
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="contenido" data-page={slug}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a href="/" class="brand brand--on-dark">
              <img class="brand__logo" src="/logo-tectuus-white.png" alt="Tectuus — Technological Momentum" width="800" height="204" loading="lazy" />
            </a>
            <p class="footer-tagline">
              Tectuus, contribuyendo al aprovechamiento integral del gas natural en la industria Mexicana
            </p>
            <div class="social-row">
              {socialNetworks.map((item) => (
                <a
                  class="social-icon social-icon--on-dark"
                  href={item.url || "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.network}
                >
                  <Fragment set:html={SOCIAL_ICON_MARKUP[item.network]} />
                </a>
              ))}
            </div>
          </div>
          <div>
            <p class="footer-heading">Navegación</p>
            {menuItems.map((item) => (
              <a class="footer-link" href={item.path}>{item.title}</a>
            ))}
          </div>
          <div>
            <p class="footer-heading">Contacto</p>
            {footerAddress && (
              <p class="footer-link footer-link--icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>{footerAddress}</p>
            )}
            <a class="footer-link footer-link--icon" href={`mailto:${footerEmail}`}>
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>{footerEmail}
            </a>
            {footerPhone && (
              <a class="footer-link footer-link--icon" href={`tel:${footerPhone.replace(/\s/g, "")}`}>
                <i class="fa-solid fa-phone" aria-hidden="true"></i>{footerPhone}
              </a>
            )}
            {footerSchedule && (
              <p class="footer-link footer-link--icon"><i class="fa-solid fa-clock" aria-hidden="true"></i>{footerSchedule}</p>
            )}
            {footerAdditionalInfo && (
              <p class="footer-link footer-link--icon"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>{footerAdditionalInfo}</p>
            )}
          </div>
        </div>
        <div class="footer-bottom">
          <span>Tectuus, parte de GNU Gas Natural. Todos los derechos reservados, {new Date().getFullYear()}.</span>
          <span class="footer-bottom__legal">
            <span>Aviso de privacidad</span>
            <span>Términos y condiciones</span>
          </span>
        </div>
      </div>
    </footer>

    {whatsappHref && (
    <a
      class="whatsapp-fab"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
    >
      <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    </a>
    )}

    <script>
      const toggle = document.getElementById("nav-toggle");
      const mobileNav = document.getElementById("nav-mobile");

      toggle?.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
      });

      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav.classList.remove("is-open");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });

      // Resizing past the breakpoint with the drawer open would otherwise leave
      // aria-expanded="true" on a toggle the CSS has just hidden.
      const desktopNav = window.matchMedia("(min-width: 981px)");
      const syncNavToBreakpoint = () => {
        if (!desktopNav.matches) return;
        mobileNav?.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
      };
      desktopNav.addEventListener("change", syncNavToBreakpoint);
      syncNavToBreakpoint();

      const navItems = Array.from(document.querySelectorAll<HTMLElement>(".nav-item"));

      function closeNavItem(item: HTMLElement) {
        item.classList.remove("is-open");
        item.querySelector<HTMLButtonElement>(".nav-link--toggle")?.setAttribute("aria-expanded", "false");
      }

      navItems.forEach((item) => {
        const dropdownToggle = item.querySelector<HTMLButtonElement>(".nav-link--toggle");
        dropdownToggle?.addEventListener("click", () => {
          const isOpen = item.classList.contains("is-open");
          navItems.forEach(closeNavItem);
          if (!isOpen) {
            item.classList.add("is-open");
            dropdownToggle.setAttribute("aria-expanded", "true");
          }
        });
      });

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node)) return;
        navItems.forEach((item) => {
          if (!item.contains(event.target as Node)) closeNavItem(item);
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") navItems.forEach(closeNavItem);
      });

      // Each section's dimension rule strikes itself as the block comes into
      // view, ahead of the plates it introduces (see the reveal pass below).
      const rules = document.querySelectorAll<HTMLElement>(".section-head");

      if ("IntersectionObserver" in window && rules.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-drawn");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2, rootMargin: "0px 0px -60px 0px" }
        );

        rules.forEach((el) => {
          // Opting in from JS keeps the rule visible when JS never runs.
          el.dataset.draw = "";
          observer.observe(el);
        });
      }

      // Plates and copy settle in as they arrive. Same opt-in-from-JS rule as
      // the dimension lines above: no JS, no hidden content.
      const revealTargets = Array.from(
        document.querySelectorAll(
          ".card, .product-card, .gallery-item, .client-card, .clients-grid__item, .prose, .product-detail__layout, .rich-text__video, .engineering-highlight__media, .rich-text-cover__media"
        )
      );

      // Members of these containers arrive one after another rather than as one
      // slab; --i is the element's position among its revealing siblings.
      const STAGGER_PARENTS = ".grid, .catalog-grid, .gallery-grid, .clients-grid, .clients-wall, .rich-text-cover__aside";

      if (revealTargets.length) {
        const staggerCounts = new Map<Element, number>();
        revealTargets.forEach((el) => {
          const parent = el.parentElement?.closest(STAGGER_PARENTS);
          if (!parent) return;
          const index = staggerCounts.get(parent) ?? 0;
          staggerCounts.set(parent, index + 1);
          (el as HTMLElement).style.setProperty("--i", String(index));
        });

        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

        // Anything already inside the viewport at load (a short page, or a
        // scroll position the browser restored on refresh) would have an
        // IntersectionObserver report it as "intersecting" the instant
        // observe() runs. A CSS *transition* only animates if the browser gets
        // to paint the "before" state first — this early in the page's
        // lifecycle that is never guaranteed, so it can jump straight to the
        // end state with nothing visible in between. A keyframe *animation*
        // has no such requirement (it always plays from its own 0% keyframe
        // once applied), so already-visible elements get one of those instead.
        const alreadyVisible: Element[] = [];
        const belowFold: Element[] = [];
        revealTargets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          (rect.top < viewportHeight && rect.bottom > 0 ? alreadyVisible : belowFold).push(el);
        });

        alreadyVisible.forEach((el) => el.classList.add("reveal-instant"));

        if (belowFold.length && "IntersectionObserver" in window) {
          const plateObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  plateObserver.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
          );

          belowFold.forEach((el) => {
            el.classList.add("reveal");
            plateObserver.observe(el);
          });
        } else {
          belowFold.forEach((el) => el.classList.add("reveal", "is-visible"));
        }
      }
    </script>
  </body>
</html>
