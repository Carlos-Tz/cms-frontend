---
// Renders a CMS page's "sections" array: each section's `type` picks a
// component, and sections render in the order the API returns them. Unknown
// types are skipped, so a new CMS section type never breaks a page.
import BannerCarousel from "./sections/BannerCarousel.astro";
import PageHero from "./sections/PageHero.astro";
import RichText from "./sections/RichText.astro";
import FeatureGrid from "./sections/FeatureGrid.astro";
import ImageGallery from "./sections/ImageGallery.astro";
import ClientsShowcase from "./sections/ClientsShowcase.astro";
import LeadCaptureForm from "./sections/LeadCaptureForm.astro";
import ContactPanel from "./ContactPanel.astro";
import type { PageSection } from "../types/page";

interface Props {
  sections: PageSection[];
  // Slug of the page being rendered. Forwarded to any lead form as its
  // `source`, so the admin inbox can tell which page produced a lead.
  pageSlug?: string | null;
}

const { sections: allSections, pageSlug = null } = Astro.props;

// Sections the CMS still serves but this site temporarily doesn't render, by
// page slug. The CMS can only unpublish a whole page, not one section, so the
// switch lives here (see technical_debt.md). Remove an entry to show it again.
const HIDDEN_ON_PAGE: Record<string, string[]> = {
  // "Nuestra experiencia" — placeholder captions, hidden until real content.
  "sobre-nosotros": ["image_gallery"],
};

const hidden = HIDDEN_ON_PAGE[pageSlug ?? ""] ?? [];
const sections = allSections.filter((section) => !hidden.includes(section.type));
const firstRichText = sections.findIndex((section) => section.type === "rich_text");

// Frontend-only images stacked under a page's first rich-text cover image,
// by page slug. The CMS gives a rich_text one cover image; these are extra
// (see technical_debt.md).
const EXTRA_RICH_TEXT_IMAGES: Record<string, { src: string; alt: string }[]> = {
  "sobre-nosotros": [
    {
      src: "/about/nuestra-experiencia.jpg",
      alt: "Ingeniero revisando planos de una planta de gas natural en su escritorio",
    },
  ],
};
const extraImages = EXTRA_RICH_TEXT_IMAGES[pageSlug ?? ""] ?? [];
---

{sections.map((section, index) => {
  switch (section.type) {
    case "banner_carousel": {
      const { slides = [] } = section.content as { slides?: any[] };
      // Only the first section on a page owns the <h1>; a banner further down
      // renders its title as plain copy.
      return slides.length ? <BannerCarousel slides={slides} primary={index === 0} /> : null;
    }

    case "page_hero": {
      const { title, subtitle, image } = section.content as {
        title?: string | null;
        subtitle?: string | null;
        image?: string | null;
      };
      return title ? <PageHero title={title} subtitle={subtitle} image={image} /> : null;
    }

    case "rich_text": {
      const { title, body, video_url, image_video_url } = section.content as {
        title?: string | null;
        body?: string | null;
        video_url?: string | null;
        image_video_url?: string | null;
      };
      // A page can hand in frontend-only content to follow its first rich
      // text (the homepage's engineering block) through this named slot.
      return (
        <>
          <RichText
            title={title}
            body={body ?? ""}
            video_url={video_url}
            image_video_url={image_video_url}
            extraImages={index === firstRichText ? extraImages : []}
          />
          {index === firstRichText && <slot name="after-rich_text" />}
        </>
      );
    }

    case "feature_grid": {
      const { title, items = [] } = section.content as { title?: string | null; items?: any[] };
      return items.length ? <FeatureGrid title={title} items={items} /> : null;
    }

    case "image_gallery": {
      const { title, images = [] } = section.content as { title?: string | null; images?: any[] };
      return images.length ? <ImageGallery title={title} images={images} /> : null;
    }

    case "clients_showcase": {
      const { title, subtitle, intro, logos = [] } = section.content as {
        title?: string | null;
        subtitle?: string | null;
        intro?: string | null;
        logos?: any[];
      };
      return logos.length ? <ClientsShowcase title={title} subtitle={subtitle ?? intro} logos={logos} /> : null;
    }

    case "lead_capture_form": {
      const { title, intro, submit_label, fields } = section.content as {
        title?: string | null;
        intro?: string | null;
        submit_label?: string | null;
        fields?: string[];
      };
      // The closing contact band goes on ink, so the page settles into the
      // same ground it opened on. A form that opens a page (right under a
      // page hero, which is already ink) stays on paper instead.
      const onInk = index > 1;

      return (
        <section class:list={["section", { "section--ink": onInk }]} id="contacto">
          <div class="container contact-split">
            <ContactPanel />
            <LeadCaptureForm
              formId={`lead-form-${index}`}
              source={pageSlug}
              title={title ?? undefined}
              intro={intro}
              submit_label={submit_label ?? undefined}
              fields={fields?.length ? fields : undefined}
            />
          </div>
        </section>
      );
    }

    default:
      return null;
  }
})}
