---
// Renders a CMS page's "sections" array: each section's `type` picks a
// component, and sections render in the order the API returns them. Unknown
// types are skipped, so a new CMS section type never breaks a page.
import BannerCarousel from "./sections/BannerCarousel.astro";
import PageHero from "./sections/PageHero.astro";
import RichText from "./sections/RichText.astro";
import FeatureGrid from "./sections/FeatureGrid.astro";
import ImageGallery from "./sections/ImageGallery.astro";
import ClientsShowcase from "./sections/ClientsShowcase.astro";
import LeadCaptureForm from "./sections/LeadCaptureForm.astro";
import type { PageSection } from "../types/page";

interface Props {
  sections: PageSection[];
}

const { sections } = Astro.props;
---

{sections.map((section, index) => {
  switch (section.type) {
    case "banner_carousel": {
      const { slides = [] } = section.content as { slides?: any[] };
      // Only the first section on a page owns the <h1>; a banner further down
      // renders its title as plain copy.
      return slides.length ? <BannerCarousel slides={slides} primary={index === 0} /> : null;
    }

    case "page_hero": {
      const { title, subtitle, image } = section.content as {
        title?: string | null;
        subtitle?: string | null;
        image?: string | null;
      };
      return title ? <PageHero title={title} subtitle={subtitle} image={image} /> : null;
    }

    case "rich_text": {
      const { title, body, video_url } = section.content as {
        title?: string | null;
        body?: string | null;
        video_url?: string | null;
      };
      return <RichText title={title} body={body ?? ""} video_url={video_url} />;
    }

    case "feature_grid": {
      const { title, items = [] } = section.content as { title?: string | null; items?: any[] };
      return items.length ? <FeatureGrid title={title} items={items} /> : null;
    }

    case "image_gallery": {
      const { title, images = [] } = section.content as { title?: string | null; images?: any[] };
      return images.length ? <ImageGallery title={title} images={images} /> : null;
    }

    case "clients_showcase": {
      const { title, logos = [] } = section.content as { title?: string | null; logos?: any[] };
      return logos.length ? <ClientsShowcase title={title} logos={logos} /> : null;
    }

    case "lead_capture_form": {
      const { title, intro, submit_label, fields } = section.content as {
        title?: string | null;
        intro?: string | null;
        submit_label?: string | null;
        fields?: string[];
      };
      return (
        <section class="section" id="contacto">
          <div class="container" style="max-width: 34rem;">
            <LeadCaptureForm
              formId={`lead-form-${index}`}
              title={title ?? undefined}
              intro={intro}
              submit_label={submit_label ?? undefined}
              fields={fields?.length ? fields : undefined}
            />
          </div>
        </section>
      );
    }

    default:
      return null;
  }
})}
