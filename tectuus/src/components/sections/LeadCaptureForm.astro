---
import { BASE_URL } from "../../functions/fetch";

type ContactFieldType = "text" | "email" | "tel" | "number" | "textarea";

const contactFieldMeta: Record<string, { label: string; type: ContactFieldType; placeholder: string }> = {
  name: { label: "Nombre completo", type: "text", placeholder: "Tu nombre" },
  company: { label: "Empresa", type: "text", placeholder: "Nombre de tu empresa" },
  email: { label: "Correo electrónico", type: "email", placeholder: "tu@empresa.com" },
  phone: { label: "Teléfono", type: "tel", placeholder: "Ej. 55 1234 5678" },
  message: { label: "Mensaje", type: "textarea", placeholder: "Cuéntanos sobre tu proyecto" },
  product: { label: "Producto de interés", type: "text", placeholder: "EDRM, compresoras, valvulería…" },
};

// Columns of `leads`. Anything the CMS declares beyond these goes in `details`,
// which the API validates against the section's own `fields[]`.
const CORE_FIELDS = ["name", "email", "phone", "message"];

interface Props {
  title?: string | null;
  intro?: string | null;
  submit_label?: string | null;
  fields?: string[];
  formId?: string;
  // Slug of the page this form lives on. The API stores it as `leads.source`,
  // which is what separates the homepage form from the /contacto one in the
  // admin inbox — it must match a published page of the site or the POST 422s.
  source?: string | null;
}

const {
  title = "Escríbenos",
  intro,
  submit_label = "Enviar",
  fields = ["name", "email", "phone", "message"],
  formId = "lead-form",
  source = null,
} = Astro.props;
---

<div class="card">
  <p class="card__title" style="margin-bottom: 1rem;">{title}</p>
  {intro && <p class="card__text" style="margin-bottom: 1rem;">{intro}</p>}
  <form id={formId}>
    {fields.map((field) => {
      const meta = contactFieldMeta[field] ?? {
        label: field.charAt(0).toUpperCase() + field.slice(1),
        type: "text" as ContactFieldType,
        placeholder: "",
      };
      return (
        <div class="field">
          <label for={`${formId}-${field}`}>{meta.label}</label>
          {meta.type === "textarea" ? (
            <textarea id={`${formId}-${field}`} name={field} rows="4" placeholder={meta.placeholder} />
          ) : (
            <input
              type={meta.type}
              id={`${formId}-${field}`}
              name={field}
              placeholder={meta.placeholder}
              required={field !== "phone" && field !== "company"}
            />
          )}
        </div>
      );
    })}
    <button type="submit" class="btn-primary lead-form__submit">{submit_label}</button>
    <p class="lead-form__status" data-lead-form-status role="status" aria-live="polite"></p>
  </form>
</div>

<script
  define:vars={{ apiBase: BASE_URL, leadFormId: formId, leadSource: source, coreFields: CORE_FIELDS }}
  is:inline
>
  const form = document.getElementById(leadFormId);
  const status = form ? form.querySelector("[data-lead-form-status]") : null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = form.querySelector('button[type="submit"]');
    const entries = Object.fromEntries(new FormData(form).entries());

    // Core keys are columns of `leads`; anything else the CMS declared in
    // `fields[]` has to travel inside `details`.
    const payload = leadSource ? { source: leadSource } : {};
    const details = {};

    for (const [key, value] of Object.entries(entries)) {
      if (coreFields.includes(key)) payload[key] = value;
      else details[key] = value;
    }
    if (Object.keys(details).length) payload.details = details;

    if (submitButton) submitButton.disabled = true;
    if (status) {
      status.textContent = "Enviando...";
      status.className = "lead-form__status";
    }

    try {
      const response = await fetch(apiBase + "leads", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => null);

      if (!response.ok) {
        // 429 is the route's throttle:10,1; 422 carries per-field messages.
        const firstError = result?.errors ? Object.values(result.errors)[0]?.[0] : null;
        throw new Error(
          response.status === 429
            ? "Recibimos demasiados envíos. Espera un momento e intenta de nuevo."
            : firstError || result?.message || "No pudimos enviar tu mensaje. Intenta de nuevo."
        );
      }

      form.reset();
      if (status) {
        status.textContent = result?.meta?.message || "Gracias por contactarnos.";
        status.className = "lead-form__status lead-form__status--success";
      }
    } catch (error) {
      if (status) {
        status.textContent = error?.message || "No pudimos enviar tu mensaje. Intenta de nuevo.";
        status.className = "lead-form__status lead-form__status--error";
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
