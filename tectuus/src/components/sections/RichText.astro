---
import { mediaUrl } from "../../functions/fetch";

interface Props {
  title?: string | null;
  body: string;
  video_url?: string | null;
  // Cover image for the section's media slot (a media path, despite the
  // `_url` name). Shown beside the text when there's no video, as in
  // landing-gnu; with a video, the video wins.
  image_video_url?: string | null;
  // Frontend-only images stacked under the cover (see technical_debt.md):
  // public paths, not CMS media.
  extraImages?: { src: string; alt: string }[];
}

const { title, body: rawBody, video_url, image_video_url, extraImages = [] } = Astro.props;

// The page title (page hero) owns the page's single <h1>. Editors sometimes
// open the body with their own <h1>; render it one level down so the page
// keeps one top-level heading. The text itself is untouched.
const body = rawBody.replace(/<(\/?)h1\b/gi, "<$1h2");

function toEmbedUrl(url: string) {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");

    if (host === "youtube.com" || host === "m.youtube.com") {
      if (parsed.pathname === "/watch") {
        const id = parsed.searchParams.get("v");
        if (id) return `https://www.youtube.com/embed/${id}`;
      }
      if (parsed.pathname.startsWith("/embed/")) return url;
      if (parsed.pathname.startsWith("/shorts/")) {
        return `https://www.youtube.com/embed/${parsed.pathname.split("/")[2]}`;
      }
    }

    if (host === "youtu.be") {
      return `https://www.youtube.com/embed/${parsed.pathname.slice(1)}`;
    }

    if (host === "vimeo.com") {
      return `https://player.vimeo.com/video/${parsed.pathname.slice(1)}`;
    }

    if (host === "player.vimeo.com") return url;

    return url;
  } catch {
    return url;
  }
}

// Autoplay is opt-in per player and browsers only honor it while the video is
// muted, so ask for both through the embed's own query params.
function withAutoplay(url: string) {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");

    if (host === "youtube.com" || host === "youtube-nocookie.com") {
      parsed.searchParams.set("autoplay", "1");
      parsed.searchParams.set("mute", "1");
      parsed.searchParams.set("playsinline", "1");
      return parsed.toString();
    }

    if (host === "player.vimeo.com") {
      parsed.searchParams.set("autoplay", "1");
      parsed.searchParams.set("muted", "1");
      return parsed.toString();
    }

    return url;
  } catch {
    return url;
  }
}

const embedUrl = video_url ? withAutoplay(toEmbedUrl(video_url)) : null;
const coverImage = !embedUrl && image_video_url ? mediaUrl(image_video_url) : null;
const media = [...(coverImage ? [{ src: coverImage, alt: "" }] : []), ...(embedUrl ? [] : extraImages)];
// A titled section with no media would otherwise leave half the container
// empty; it reads as a spread instead: title on the left, copy on the right.
const split = Boolean(title) && media.length === 0 && !embedUrl;
---

<section class="section">
  <div class:list={["container", { "rich-text-cover": media.length }]}>
    {media.length > 0 && (
      <div class="rich-text-cover__aside">
        {media.map((image) => (
          <figure class="rich-text-cover__media">
            <img src={image.src} alt={image.alt} loading="lazy" />
            <span class="photo-shine" aria-hidden="true"></span>
          </figure>
        ))}
      </div>
    )}
    <div class:list={["rich-text-cover__content", { "rich-text-split": split }]}>
    {title && (
      <div class="section-head">
        <h2 class="section-title">{title}</h2>
      </div>
    )}
    <div class="prose" set:html={body} />
    </div>
    {embedUrl && (
      <div class="rich-text__video">
        <iframe
          src={embedUrl}
          title={title ?? "Video"}
          loading="lazy"
          allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}
  </div>
</section>
