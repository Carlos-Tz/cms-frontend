---
// CMS "image_gallery" section: an optional title plus a list of images, each
// with an optional caption and alt text.
import { mediaUrl, FALLBACK_IMAGE } from "../../functions/fetch";

interface GalleryImage {
  image: string;
  caption?: string | null;
  alt?: string | null;
}

interface Props {
  title?: string | null;
  images: GalleryImage[];
}

const { title, images } = Astro.props;
---

<section class="section">
  <div class="container">
    {title && (
      <div class="section-head">
        <h2 class="section-title">{title}</h2>
      </div>
    )}

    <div class="gallery-grid">
      {images.map((item) => (
        <figure class="gallery-item">
          <img
            src={item.image ? mediaUrl(item.image) : FALLBACK_IMAGE}
            alt={item.alt ?? item.caption ?? ""}
            loading="lazy"
          />
          {item.caption && <figcaption class="gallery-caption">{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>
