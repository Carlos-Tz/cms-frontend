---
// landing-gnu's testimonial band (centered head + quote tiles).
import TestimonialTiles from "./TestimonialTiles.astro";

// The CMS `testimonials` section sends `author` and an optional `photo`;
// `name` is the shape of this site's own fallback copy.
interface Testimonial {
  quote: string;
  author?: string | null;
  name?: string | null;
  role?: string | null;
  photo?: string | null;
}

interface Props {
  title?: string | null;
  items?: Testimonial[];
}

const { title, items = [] } = Astro.props;
const tiles = items.map((item) => ({ ...item, author: item.author ?? item.name }));
---

{tiles.length > 0 && (
  <section class="section section--alt texture-grid">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Historias que nos mueven</span>
        <h2 class="section-title">{title ?? "Clientes que ya ahorran con GNV"}</h2>
      </div>
      <TestimonialTiles items={tiles} />
    </div>
  </section>
)}
