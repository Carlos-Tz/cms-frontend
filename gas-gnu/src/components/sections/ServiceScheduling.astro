---
import { fetchData, BASE_URL } from "../../functions/fetch";
import calendarIcon from "../../assets/images/calendar-icon.png";

interface Props {
  title?: string | null;
  intro?: string | null;
  success_message?: string | null;
}

const { title, intro, success_message } = Astro.props;

type PublicStation = {
  id?: number;
  name: string;
  address: string;
  latitude: number;
  longitude: number;
  phone: string;
  schedule: string;
};
type StationsResponse = { status: string; data: PublicStation[]; meta: Record<string, any> };

// `id` is what appointments/availability and POST appointments key on, and it
// comes straight from the listing. The name map below is only the bridge for
// an API host that hasn't shipped that field yet — delete it (and the `??`)
// once every environment answers `stations` with an id. A station that matches
// neither is dropped rather than guessed: the wrong id books the wrong workshop.
const LEGACY_STATION_IDS: Record<string, number> = {
  "Estación GNU Gas Natural Salida Quiroga Morelia, Michoacán": 3,
  "Estación GNU Gas Natural Salida Charo Morelia, Michoacán": 4,
  "Estación Blue GAS Uruapan, Michoacán": 13,
};

const stationsResponse: StationsResponse | undefined = await fetchData("stations");
const stations = (stationsResponse?.data ?? [])
  .map((station) => ({ ...station, id: station.id ?? LEGACY_STATION_IDS[station.name] }))
  .filter((station) => Number.isFinite(Number(station.id)));

const fallbackSuccessMessage = "Tu cita quedó registrada. Te esperamos.";
---

<section class="section zebra" id="agenda">
  <div class="container contact-layout scheduler-layout">
    <div class="scheduler-aside">
      <div class="scheduler-aside__intro">
        <div class="scheduler-aside__art" aria-hidden="true">
          <span class="scheduler-aside__blob"></span>
          <img class="scheduler-aside__icon" src={calendarIcon.src} width={calendarIcon.width} height={calendarIcon.height} alt="" />
        </div>
        <h2 class="section-title">{title ?? "Agenda tu verificación"}</h2>
      </div>
      {intro && <p class="section-subtitle">{intro}</p>}
    </div>

    {stations.length ? (
      <div class="card scheduler" data-success-message={success_message ?? fallbackSuccessMessage}>
        <form id="scheduler-lookup-form" class="scheduler__lookup">
          <div class="field">
            <label for="scheduler-station-trigger">
              <svg class="field__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" />
                <circle cx="12" cy="9.5" r="2.25" />
              </svg>
              Estación
            </label>
            <button
              type="button"
              class="station-select"
              id="scheduler-station-trigger"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="scheduler-station-modal"
            >
              <span id="scheduler-station-value" class="station-select__value">{stations[0]?.name}</span>
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <select id="scheduler-station" class="station-select__native" tabindex="-1" aria-hidden="true" required>
              {stations.map((station) => (
                <option value={station.id}>{station.name}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="scheduler-date">
              <svg class="field__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4.5" width="18" height="16" rx="2" />
                <path d="M3 9.5h18M8 3v3M16 3v3" />
              </svg>
              Fecha
            </label>
            <input type="date" id="scheduler-date" required />
          </div>
          <button type="submit" class="btn-secondary">Ver horarios</button>
        </form>

        <div id="scheduler-slots" class="scheduler__slots" role="status" aria-live="polite"></div>

        <form id="scheduler-booking-form" class="scheduler__booking">
          <div class="scheduler__booking-inner">
            <input type="hidden" id="scheduler-selected-station" />
            <input type="hidden" id="scheduler-selected-date" />
            <input type="hidden" id="scheduler-selected-slot" />
            <p class="scheduler__selected-slot" id="scheduler-selected-label"></p>
            <div class="field">
              <label for="scheduler-name">Nombre completo</label>
              <input type="text" id="scheduler-name" placeholder="Tu nombre" required />
            </div>
            <div class="field">
              <label for="scheduler-email">Correo electrónico</label>
              <input type="email" id="scheduler-email" placeholder="tucorreo@ejemplo.com" required />
            </div>
            <div class="field">
              <label for="scheduler-phone">Teléfono</label>
              <input type="tel" id="scheduler-phone" placeholder="Ej. 55 1234 5678" required />
            </div>
            <div class="field">
              <label for="scheduler-plate">Placa</label>
              <input type="text" id="scheduler-plate" placeholder="Ej. ABC-12-34" required />
            </div>
            <div class="field">
              <label for="scheduler-vehicle">Descripción del vehículo</label>
              <input type="text" id="scheduler-vehicle" placeholder="Marca, modelo y año" required />
            </div>
            <button type="submit" class="btn-primary">Confirmar cita</button>
            <p class="lead-form__status" id="scheduler-status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <dialog class="confirmation-modal" id="scheduler-confirmation">
          <button type="button" class="confirmation-modal__close" aria-label="Cerrar">×</button>
          <div class="confirmation-modal__check" aria-hidden="true">
            <svg viewBox="0 0 52 52">
              <circle class="confirmation-modal__check-circle" cx="26" cy="26" r="24" fill="none" />
              <path class="confirmation-modal__check-mark" fill="none" d="M14 27l7 7 16-16" />
            </svg>
          </div>
          <p class="confirmation-modal__title">¡Listo!</p>
          <p class="confirmation-modal__text" id="scheduler-confirmation-text"></p>
        </dialog>
      </div>
    ) : null}

    {stations.length > 0 && (
      <>
        {/* Deliberately NOT nested inside .card.scheduler: that card's own
            :hover transform (see .card:hover in global.css) would become the
            containing block for a position: fixed descendant the moment the
            visitor's pointer is resting on the card — which it almost always
            is right after clicking the trigger inside it — pinning this
            "modal" to the card's corner instead of centering it on the
            viewport. A plain toggled div, not <dialog>/showModal(), so there
            is no dependency on that API's own (less consistently
            implemented) top-layer exemption from the same problem either. */}
        <div class="station-modal-backdrop" id="scheduler-station-backdrop" aria-hidden="true"></div>
        <div class="station-modal" id="scheduler-station-modal" role="dialog" aria-modal="true" aria-label="Selecciona una estación">
          <div class="station-modal__header">
            <p class="station-modal__title">Elige tu estación</p>
            <button type="button" class="station-modal__close" aria-label="Cerrar">×</button>
          </div>
          <ul class="station-modal__list" role="listbox" aria-label="Estaciones disponibles">
            {stations.map((station, index) => (
              <li role="presentation">
                <button
                  type="button"
                  class:list={["station-modal__option", { "is-selected": index === 0 }]}
                  role="option"
                  aria-selected={index === 0}
                  data-value={station.id}
                >
                  <svg class="station-modal__pin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" />
                    <circle cx="12" cy="9.5" r="2.25" />
                  </svg>
                  <span>{station.name}</span>
                  <svg class="station-modal__check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </>
    )}
    {stations.length === 0 && (
      <p class="section-subtitle" style="text-align:center;">
        Agenda no disponible por el momento. Contáctanos directamente para programar tu verificación.
      </p>
    )}
  </div>
</section>

<script define:vars={{ apiBase: BASE_URL }} is:inline>
  const lookupForm = document.getElementById("scheduler-lookup-form");
  const slotsContainer = document.getElementById("scheduler-slots");
  const bookingForm = document.getElementById("scheduler-booking-form");
  const stationSelect = document.getElementById("scheduler-station");
  const dateInput = document.getElementById("scheduler-date");
  const selectedStationInput = document.getElementById("scheduler-selected-station");
  const selectedDateInput = document.getElementById("scheduler-selected-date");
  const selectedSlotInput = document.getElementById("scheduler-selected-slot");
  const selectedLabel = document.getElementById("scheduler-selected-label");
  const statusEl = document.getElementById("scheduler-status");
  const successMessage = document.querySelector(".scheduler")?.dataset.successMessage || "Tu cita quedó registrada.";
  const confirmationModal = document.getElementById("scheduler-confirmation");
  const confirmationText = document.getElementById("scheduler-confirmation-text");
  let confirmationTimer;

  function showConfirmation(message) {
    if (!confirmationModal || typeof confirmationModal.showModal !== "function") return;
    if (confirmationText) confirmationText.textContent = message;
    confirmationModal.showModal();
    clearTimeout(confirmationTimer);
    confirmationTimer = window.setTimeout(() => confirmationModal.close(), 4500);
  }

  confirmationModal?.addEventListener("click", (event) => {
    if (event.target === confirmationModal) confirmationModal.close();
  });
  confirmationModal?.querySelector(".confirmation-modal__close")?.addEventListener("click", () => confirmationModal.close());
  confirmationModal?.addEventListener("close", () => clearTimeout(confirmationTimer));

  // `min` has to be set in the browser: the site is built statically, so a
  // date rendered into the HTML is the build's date and lets visitors pick a
  // day the API already rejects with `after_or_equal:today`. Local time, not
  // UTC — in Mexico those are different days for six hours every evening.
  if (dateInput) {
    const now = new Date();
    dateInput.min = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  }

  // Custom station picker: a trigger button + a styled popup listing every
  // station as a big tappable row, instead of a plain <select> (whose open
  // list is OS/browser chrome — no amount of CSS can restyle it). The real
  // <select> stays in the DOM (hidden from view and from assistive tech) just
  // to hold the value the rest of this script already reads from it.
  //
  // Plain div + a .is-open class, not <dialog>/showModal(): this toggles
  // the same way the site's other fixed-position overlays already do (the
  // savings-simulator FAB panel), which keeps it independent of a browser's
  // own top-layer implementation for <dialog>.
  const stationTrigger = document.getElementById("scheduler-station-trigger");
  const stationValueLabel = document.getElementById("scheduler-station-value");
  const stationModal = document.getElementById("scheduler-station-modal");
  const stationBackdrop = document.getElementById("scheduler-station-backdrop");
  const stationOptions = stationModal ? Array.from(stationModal.querySelectorAll(".station-modal__option")) : [];

  function openStationModal() {
    stationModal?.classList.add("is-open");
    stationBackdrop?.classList.add("is-open");
    stationTrigger?.setAttribute("aria-expanded", "true");
    document.body.classList.add("station-modal-open");
  }

  function closeStationModal() {
    stationModal?.classList.remove("is-open");
    stationBackdrop?.classList.remove("is-open");
    stationTrigger?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("station-modal-open");
  }

  function selectStationOption(option) {
    if (!stationSelect || !option) return;
    stationSelect.value = option.dataset.value || "";
    if (stationValueLabel) stationValueLabel.textContent = option.querySelector("span")?.textContent ?? "";
    stationOptions.forEach((opt) => {
      const selected = opt === option;
      opt.classList.toggle("is-selected", selected);
      opt.setAttribute("aria-selected", String(selected));
    });
  }

  stationTrigger?.addEventListener("click", openStationModal);
  stationModal?.querySelector(".station-modal__close")?.addEventListener("click", closeStationModal);
  stationBackdrop?.addEventListener("click", closeStationModal);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && stationModal?.classList.contains("is-open")) closeStationModal();
  });
  stationOptions.forEach((option) => {
    option.addEventListener("click", () => {
      selectStationOption(option);
      closeStationModal();
      stationTrigger?.focus();
    });
  });

  function stationName(id) {
    const option = Array.from(stationSelect?.options ?? []).find((opt) => opt.value === String(id));
    return option?.textContent ?? "";
  }

  function resetBooking() {
    bookingForm?.classList.remove("is-visible");
    if (statusEl) {
      statusEl.textContent = "";
      statusEl.className = "lead-form__status";
    }
  }

  lookupForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    resetBooking();
    if (!slotsContainer) return;
    slotsContainer.textContent = "Buscando horarios...";

    const station = stationSelect?.value;
    const date = dateInput?.value;
    if (!station || !date) return;

    try {
      const response = await fetch(`${apiBase}appointments/availability?station=${station}&date=${date}`);
      const result = await response.json().catch(() => null);

      if (!response.ok || result?.status !== "success") {
        slotsContainer.textContent = result?.meta?.message || result?.message || "No pudimos consultar los horarios.";
        return;
      }

      const slots = result?.data?.slots ?? [];
      if (!slots.length) {
        slotsContainer.textContent = "No hay horarios disponibles para ese día. Intenta con otra fecha.";
        return;
      }

      slotsContainer.innerHTML = "";
      slots.forEach(({ slot, available }, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "scheduler__slot" + (available ? "" : " is-unavailable");
        button.style.animationDelay = `${Math.min(index * 30, 300)}ms`;
        button.textContent = slot;
        button.disabled = !available;
        button.addEventListener("click", () => {
          slotsContainer.querySelectorAll(".scheduler__slot").forEach((el) => el.classList.remove("is-selected"));
          button.classList.add("is-selected");
          if (selectedStationInput) selectedStationInput.value = station;
          if (selectedDateInput) selectedDateInput.value = date;
          if (selectedSlotInput) selectedSlotInput.value = slot;
          if (selectedLabel) selectedLabel.textContent = `${stationName(station)} · ${date} · ${slot}`;
          resetBooking();
          bookingForm?.classList.add("is-visible");
        });
        slotsContainer.appendChild(button);
      });
    } catch (error) {
      slotsContainer.textContent = "No pudimos consultar los horarios. Intenta de nuevo.";
    }
  });

  bookingForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = bookingForm.querySelector('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    if (statusEl) {
      statusEl.textContent = "Enviando...";
      statusEl.className = "lead-form__status";
    }

    const payload = {
      station_id: Number(selectedStationInput?.value),
      date: selectedDateInput?.value,
      slot: selectedSlotInput?.value,
      name: document.getElementById("scheduler-name")?.value,
      email: document.getElementById("scheduler-email")?.value,
      phone: document.getElementById("scheduler-phone")?.value,
      vehicle_plate: document.getElementById("scheduler-plate")?.value,
      vehicle_description: document.getElementById("scheduler-vehicle")?.value,
    };

    try {
      const response = await fetch(`${apiBase}appointments`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => null);

      if (!response.ok) {
        const firstError = result?.errors ? Object.values(result.errors)[0]?.[0] : null;
        throw new Error(firstError || result?.message || "request failed");
      }

      bookingForm.reset();
      bookingForm.classList.remove("is-visible");
      if (slotsContainer) slotsContainer.textContent = "";
      showConfirmation(result?.meta?.message || successMessage);
    } catch (error) {
      if (statusEl) {
        statusEl.textContent = error instanceof Error ? error.message : "No pudimos registrar tu cita. Intenta de nuevo.";
        statusEl.className = "lead-form__status lead-form__status--error";
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
