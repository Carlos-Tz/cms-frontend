---
import { mediaUrl } from "../../functions/fetch";
import noImg from "../../assets/images/noimg.jpg";

interface Post {
  tag: string;
  title: string;
  url?: string | null;
  cover_image?: string | null;
}

interface Props {
  title?: string | null;
  posts: Post[];
}

const { title, posts } = Astro.props;
---

<section class="section" id="blog">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Blog</span>
      <h2 class="section-title">{title ?? "Aprende más sobre el GNV"}</h2>
    </div>
    <div class="grid grid--3">
      {posts.map((post) => (
        <a class="blog-card" href={post.url || "#"}>
          <img class="blog-card__cover" src={post.cover_image ? mediaUrl(post.cover_image) : noImg.src} alt="" />
          <div class="blog-card__body">
            <span class="blog-card__tag">{post.tag}</span>
            <h3 class="blog-card__title">{post.title}</h3>
            <span class="blog-card__link">Leer más →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
