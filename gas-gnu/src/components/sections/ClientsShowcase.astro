---
import { mediaUrl } from "../../functions/fetch";

interface ClientLogo {
  name: string;
  image: string;
}

interface Props {
  title?: string | null;
  logos: ClientLogo[];
}

const { title, logos } = Astro.props;
---

<section class="section section--alt" id="clientes">
  <div class="container">
    <div class="section-head section-head--center">
      <h2 class="section-title">{title ?? "Nuestros clientes"}</h2>
    </div>
    <div class="clients-grid">
      {logos.map((logo) => (
        <img class="clients-grid__logo" src={mediaUrl(logo.image)} alt={logo.name} loading="lazy" />
      ))}
    </div>
  </div>
</section>
