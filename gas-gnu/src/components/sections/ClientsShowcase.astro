---
import { mediaUrl } from "../../functions/fetch";
import TestimonialTiles from "./TestimonialTiles.astro";

interface Logo {
  image: string;
  name: string;
  url?: string | null;
  // Optional per-logo extras: the pages that only show a wall of logos leave
  // them empty; the ones that do fill them get a quote tile per client.
  description?: string | null;
  quote?: string | null;
  quote_author?: string | null;
}

interface Props {
  title?: string | null;
  logos?: Logo[];
  id?: string;
}

const { title, logos = [], id = "clientes" } = Astro.props;
const shown = logos.map((logo) => ({ ...logo, image: mediaUrl(logo.image) }));
const useMarquee = shown.length >= 4;
const marqueeLogos = useMarquee ? [...shown, ...shown] : shown;
// Reuses the same tile component as the home page's "Lo que dicen nuestros
// clientes" — the logo doubles as the tile's photo, since these quotes don't
// have a separate headshot.
const quotedItems = shown
  .filter((logo) => logo.quote)
  .map((logo) => ({
    quote: logo.quote!,
    author: logo.quote_author,
    role: logo.description ?? logo.name,
    photo: logo.image,
  }));
---

{shown.length > 0 && (
  <section class="section clients-band texture-dots" id={id}>
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="section-title">{title ?? "Nuestros clientes"}</h2>
      </div>
      <div class={useMarquee ? "logo-marquee" : "logo-grid"}>
        <div class={useMarquee ? "logo-marquee__track" : "logo-grid__inner"}>
          {marqueeLogos.map((logo, index) => {
            // The marquee's second copy is decorative: hidden from assistive
            // tech and the tab order so each client is announced once.
            const duplicate = useMarquee && index >= shown.length;
            const inner = (
              <>
                <div class="logo-card__figure">
                  <img class="logo-card__img" src={logo.image} alt={duplicate ? "" : logo.name} loading="lazy" />
                </div>
                <span class="logo-card__name">{logo.name}</span>
                {logo.description && <span class="logo-card__desc">{logo.description}</span>}
              </>
            );
            const card = logo.url ? (
              <a
                class="logo-card"
                href={logo.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={duplicate ? -1 : undefined}
                title={logo.description ?? undefined}
              >
                {inner}
              </a>
            ) : (
              <div class="logo-card" title={logo.description ?? undefined}>{inner}</div>
            );
            return useMarquee ? (
              <div class="logo-marquee__item" aria-hidden={duplicate ? "true" : undefined}>{card}</div>
            ) : (
              card
            );
          })}
        </div>
      </div>

      {quotedItems.length > 0 && (
        <div class="client-quotes">
          <TestimonialTiles items={quotedItems} />
        </div>
      )}
    </div>
  </section>
)}
