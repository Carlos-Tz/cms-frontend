---
// landing-gnu's feature band: blueprint-grid background, balanced card rows,
// icon tile + copy panel. The CMS's `icon` field is meant for a small square
// icon, but editors sometimes drop a full stock photo in there instead (see
// technical_debt.md) — squeezed into the tiny tinted tile it reads as a
// random, illegible sliver. Anything far from square is probed at build time
// and shown as a proper 16:9 photo banner (the already-styled `card--photo`
// variant) instead.
import { mediaUrl } from "../../functions/fetch";
import { probeImageSize } from "../../lib/media";
import BalancedGrid from "../BalancedGrid.astro";
import CardBadge from "../CardBadge.astro";

interface FeatureItem {
  icon: string | null;
  title: string;
  text: string;
}

interface Props {
  title?: string | null;
  items: FeatureItem[];
  id?: string;
}

const { title, items, id } = Astro.props;

const resolvedItems = await Promise.all(
  items.map(async (item) => {
    const iconUrl = item.icon ? mediaUrl(item.icon) : null;
    const size = iconUrl ? await probeImageSize(iconUrl) : null;
    const aspect = size && size.height > 0 ? size.width / size.height : 1;
    // A true icon is roughly square; a photo dropped in by mistake almost
    // always isn't.
    const isPhoto = aspect < 0.75 || aspect > 1.35;
    return { ...item, iconUrl, isPhoto };
  })
);
---

{resolvedItems.length > 0 && (
<section class="section section--alt texture-grid" id={id}>
  <div class="container">
    {title && (
      <div class="section-head section-head--center">
        <h2 class="section-title">{title}</h2>
      </div>
    )}
    <BalancedGrid count={resolvedItems.length}>
      {resolvedItems.map((item) => (
        <div class:list={["card", "card--feature", { "card--photo": item.isPhoto }]}>
          {item.isPhoto ? (
            <div class="card__media">
              <img class="card__media-img" src={item.iconUrl!} alt="" loading="lazy" />
            </div>
          ) : (
            <div class="card__icon" aria-hidden="true">
              {item.iconUrl ? (
                <img class="card__icon-img" src={item.iconUrl} alt="" loading="lazy" />
              ) : (
                <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 1 3-1 4-2 4a2 2 0 0 1-2-2c0-2 2-3 1-6-2 1-4 3-4 6a5 5 0 0 0 5 5 5 5 0 0 0 5-5c0-4-3-6-3-9-3 1-5 4-5 7"
                    fill="currentColor"
                  />
                </svg>
              )}
            </div>
          )}
          <div class="card__panel">
            {item.isPhoto && <CardBadge variant="small" />}
            <p class="card__title">{item.title}</p>
            <p class="card__text">{item.text}</p>
          </div>
        </div>
      ))}
    </BalancedGrid>
  </div>
</section>
)}
