---
import PageHero from "./sections/PageHero.astro";
import RichText from "./sections/RichText.astro";
import FeatureGrid from "./sections/FeatureGrid.astro";
import LeadCaptureForm from "./sections/LeadCaptureForm.astro";
import StationsMap from "./sections/StationsMap.astro";
import ClientsShowcase from "./sections/ClientsShowcase.astro";
import ServiceScheduling from "./sections/ServiceScheduling.astro";
import SavingsSimulator from "./sections/SavingsSimulator.astro";
import HeroCarousel from "./sections/HeroCarousel.astro";
import ImageGallery from "./sections/ImageGallery.astro";
import Testimonials from "./sections/Testimonials.astro";
import ContactInfo from "./sections/ContactInfo.astro";

interface Section {
  type: string;
  content: Record<string, any>;
}

interface Props {
  sections: Section[];
  // Slug of the page these sections belong to. Forwarded to lead_capture_form
  // as `source` so submitted leads are attributed to the right page, and to
  // savings_simulator so the endpoint prices against this page's section.
  pageSlug?: string | null;
}

const { sections, pageSlug = null } = Astro.props;

// Every section type the CMS schema defines has a renderer here, so adding one
// to a page in the blueprint never silently drops it. `social_icons` and
// `whatsapp_button` are site-wide: the layout renders them from `globals`.
---

{sections.map((section) => {
  switch (section.type) {
    case "page_hero":
      return <PageHero {...(section.content as any)} />;
    case "banner_carousel":
      return <HeroCarousel slides={section.content.slides} />;
    case "rich_text":
      return <RichText {...(section.content as any)} />;
    case "feature_grid":
      return <FeatureGrid {...(section.content as any)} />;
    case "lead_capture_form":
      return (
        <section class="section">
          <div class="container" style="max-width: 34rem;">
            <LeadCaptureForm
              {...(section.content as any)}
              formId={`lead-form-${pageSlug ?? "page"}`}
              source={pageSlug ?? undefined}
            />
          </div>
        </section>
      );
    case "stations_map":
      return <StationsMap {...(section.content as any)} />;
    case "clients_showcase":
      return <ClientsShowcase {...(section.content as any)} />;
    case "service_scheduling":
      return <ServiceScheduling {...(section.content as any)} />;
    case "savings_simulator":
      return <SavingsSimulator {...(section.content as any)} page={pageSlug} />;
    case "image_gallery":
      return <ImageGallery {...(section.content as any)} />;
    case "testimonials":
      return <Testimonials {...(section.content as any)} />;
    case "contact_info":
      return <ContactInfo {...(section.content as any)} />;
    default:
      return null;
  }
})}
