---
import noImg from "../assets/images/noimg.jpg";
import { mediaUrl } from "../functions/fetch";
import { childrenOf, getPage, heroOf } from "../lib/cms";

interface Props {
  // Slug of the hub page whose children become cards.
  parent: string;
  // Used only when `GET menu` is unreachable at build time.
  fallback: Array<{ slug: string; path: string; title: string }>;
  gridClass?: string;
  // "grid": the plain card grid used on listing pages. "accordion": an
  // always-expanded feature list, image alternating left/right, for a more
  // editorial homepage teaser — same data, no extra fetch.
  variant?: "grid" | "accordion";
}

const { parent, fallback, gridClass = "grid--3", variant = "grid" } = Astro.props;

// The children come from the CMS menu, so a page unpublished in the admin
// drops its card too instead of linking to a 404.
const menuChildren = await childrenOf(parent);
const children = menuChildren.length ? menuChildren : fallback;

// Each card reuses its page's "Encabezado de página" (page_hero): the image and
// subtitle the admin already edits there, so a card has no content of its own.
const cards = await Promise.all(
  children.map(async (child) => {
    const hero = heroOf(await getPage(child.slug));
    return {
      path: child.path,
      title: child.title,
      subtitle: hero?.subtitle ?? null,
      image: hero?.image ? mediaUrl(hero.image) : noImg.src,
    };
  }),
);
---

{cards.length > 0 && variant === "accordion" ? (
  <div class="services-feature-list">
    {cards.map((card, index) => (
      <article class:list={["services-feature", { "services-feature--reverse": index % 2 === 1 }]}>
        <div class="services-feature__media">
          <span class="services-feature__media-blob" aria-hidden="true"></span>
          <img src={card.image} alt="" loading="lazy" />
          <span class="services-feature__media-badge" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </div>
        <div class="services-feature__panel">
          <span class="services-feature__eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            Servicio
          </span>
          <h3 class="services-feature__title">{card.title}</h3>
          {card.subtitle && <p class="services-feature__text">{card.subtitle}</p>}
          <a href={card.path} class="services-feature__link">Ver más <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
) : (
  cards.length > 0 && (
    <div class:list={["grid", gridClass]}>
      {cards.map((card) => (
        <a class="blog-card service-card" href={card.path}>
          <div class="service-card__media">
            <img class="blog-card__cover" src={card.image} alt="" loading="lazy" />
          </div>
          <div class="blog-card__body">
            <p class="card__title">{card.title}</p>
            {card.subtitle && <p class="blog-card__excerpt">{card.subtitle}</p>}
            <span class="blog-card__link">Ver más <span class="service-card__arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  )
)}
