---
import CmsPage from "../../components/CmsPage.astro";
import ChildPageCards from "../../components/ChildPageCards.astro";

const fallbackChildren = [
  { slug: "estaciones-morelia", path: "/ubicaciones/estaciones-morelia", title: "Estaciones Morelia" },
  { slug: "estacion-uruapan", path: "/ubicaciones/estacion-uruapan", title: "Estación Uruapan" },
  { slug: "agenda-tu-verificacion", path: "/ubicaciones/agenda-tu-verificacion", title: "Agenda tu verificación" },
  { slug: "talleres", path: "/ubicaciones/talleres", title: "Talleres" },
];
---

<CmsPage slug="ubicaciones" fallbackTitle="Ubicaciones" fallbackSubtitle="Encuentra tu estación de GNV más cercana.">
  <section class="section zebra">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Conoce más</span>
        <h2 class="section-title">Explora Ubicaciones</h2>
      </div>
      <ChildPageCards parent="ubicaciones" fallback={fallbackChildren} gridClass="grid--4" />
    </div>
  </section>
</CmsPage>
