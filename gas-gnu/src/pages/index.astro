---
import { Image } from "astro:assets";
import "../styles/global.css";
import placeholder from "../assets/images/noimg.jpg";

const nav = [
  { href: "#inicio", label: "Inicio" },
  { href: "#servicios", label: "Nuestros Servicios" },
  { href: "#ubicaciones", label: "Ubicaciones" },
  { href: "#contacto", label: "Contacto" },
  { href: "#blog", label: "Blog" },
];

const servicios = [
  {
    title: "Instala tu equipo de GNV",
    desc: "Conversión certificada para que tu auto ruede con gas natural vehicular desde la primera semana.",
    icon: "🔧",
  },
  {
    title: "Cotiza tu equipo",
    desc: "Recibe una cotización a tu medida según marca, modelo y tipo de motor.",
    icon: "📝",
  },
  {
    title: "Financiamiento",
    desc: "Planes a meses sin intereses para que tu conversión se pague sola con el ahorro mensual.",
    icon: "💳",
  },
  {
    title: "Flotillas empresariales",
    desc: "Soluciones a escala para transporte de carga, taxis y flotillas corporativas.",
    icon: "🚚",
  },
  {
    title: "Estaciones móviles",
    desc: "Unidades de carga móvil para llevar el GNV donde tu operación lo necesite.",
    icon: "🛠️",
  },
];

const ubicaciones = [
  { title: "Estaciones Morelia", desc: "3 puntos de carga activos las 24 horas." },
  { title: "Estación Uruapan", desc: "Carga rápida y área de espera techada." },
  { title: "Agenda tu verificación", desc: "Reserva tu cita de verificación anual en línea." },
  { title: "Talleres", desc: "Red de talleres certificados para mantenimiento de tu equipo." },
];

const testimoniales = [
  {
    quote: "Desde que convertí mi flotilla a GNV bajé más del 40% en gasto de combustible mensual.",
    name: "Ricardo Peña",
    role: "Flotilla de taxis, Morelia",
  },
  {
    quote: "La instalación fue rápida y el soporte post-venta siempre responde el mismo día.",
    name: "Lupita Camacho",
    role: "Transporte de carga, Uruapan",
  },
  {
    quote: "El simulador de ahorro me convenció antes de pisar el taller. Los números no mienten.",
    name: "Juan Osorio",
    role: "Cliente particular",
  },
];

const blog = [
  { tag: "Verificación", title: "Verificación anual: qué necesitas y cuándo renovarla" },
  { tag: "Sostenibilidad", title: "Transporte sostenible: el rol del GNV en las ciudades" },
  { tag: "Seguridad", title: "Seguridad del GNV: mitos y realidades" },
  { tag: "Comparativa", title: "GN vs. otros combustibles: ahorro y emisiones" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="GNU Gas Natural Vehicular: convierte tu auto o flotilla a GNV, encuentra estaciones cerca de ti y calcula tu ahorro."
    />
    <title>GNU · Gas Natural Vehicular</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="#inicio" class="logo">
          <span class="logo__mark">GNU</span>
          <span class="logo__text">Gas Natural Vehicular</span>
        </a>

        <nav class="nav" aria-label="Principal">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>

        <div class="site-header__actions">
          <a href="#contacto" class="btn-secondary btn-secondary--compact">Agenda tu verificación</a>
          <a href="#servicios" class="btn-primary btn-primary--compact">Cotiza tu equipo</a>
        </div>

        <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="nav-mobile" id="nav-mobile" aria-label="Principal móvil">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="#contacto" class="btn-primary">Cotiza tu equipo</a>
      </nav>
    </header>

    <main>
      <!-- HERO / INICIO -->
      <section id="inicio" class="hero">
        <div class="container hero__inner">
          <div class="hero__copy">
            <span class="eyebrow">GNU · Gas Natural Vehicular</span>
            <h1 class="hero__title">
              Ahorra hasta un <span class="gradient-text">60% en combustible</span> con gas natural vehicular
            </h1>
            <p class="hero__sub">
              Convierte tu auto, camioneta o flotilla a GNV: instalación certificada, red de estaciones en
              crecimiento y financiamiento a tu medida.
            </p>
            <div class="hero__cta">
              <a href="#simulador" class="btn-primary">Simula tu ahorro</a>
              <a href="#servicios" class="btn-secondary">Cotiza tu equipo</a>
            </div>
            <div class="hero__stats">
              <div>
                <strong>+5,000</strong>
                <span>equipos instalados</span>
              </div>
              <div>
                <strong>60%</strong>
                <span>ahorro promedio</span>
              </div>
              <div>
                <strong>24/7</strong>
                <span>estaciones activas</span>
              </div>
            </div>
          </div>
          <div class="hero__media">
            <Image src={placeholder} alt="Vehículo convertido a gas natural vehicular" width={640} height={400} />
          </div>
        </div>
      </section>

      <!-- CARRUSEL DE BANNERS -->
      <section class="banners">
        <div class="container">
          <div class="banners__track">
            <article class="banner-card">
              <Image src={placeholder} alt="Promoción de instalación" width={420} height={220} />
              <div class="banner-card__body">
                <span class="eyebrow">Promoción</span>
                <h3>Instalación con 20% de descuento este mes</h3>
              </div>
            </article>
            <article class="banner-card">
              <Image src={placeholder} alt="Financiamiento a flotillas" width={420} height={220} />
              <div class="banner-card__body">
                <span class="eyebrow">Flotillas</span>
                <h3>Financiamiento a 12 meses sin intereses</h3>
              </div>
            </article>
            <article class="banner-card">
              <Image src={placeholder} alt="Nueva estación" width={420} height={220} />
              <div class="banner-card__body">
                <span class="eyebrow">Novedad</span>
                <h3>Nueva estación de carga en Uruapan</h3>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- SIMULADOR DE AHORRO -->
      <section id="simulador" class="simulador">
        <div class="container simulador__inner">
          <div class="simulador__copy">
            <span class="eyebrow">Simulador de ahorro</span>
            <h2 class="section-heading">Descubre cuánto te ahorras al cambiar a GNV</h2>
            <p class="section-sub">
              Ingresa tus kilómetros recorridos y tu gasto actual de gasolina para ver una proyección de tu
              ahorro mensual y anual con gas natural vehicular.
            </p>
            <a href="#contacto" class="btn-secondary">Habla con un asesor</a>
          </div>
          <form class="card simulador__card" aria-label="Simulador de ahorro">
            <div class="field">
              <label for="km">Kilómetros recorridos al mes</label>
              <input type="number" id="km" name="km" placeholder="Ej. 2,500" />
            </div>
            <div class="field">
              <label for="gasto">Gasto mensual actual en gasolina</label>
              <input type="text" id="gasto" name="gasto" placeholder="Ej. $3,000 MXN" />
            </div>
            <button type="submit" class="btn-primary simulador__submit">Calcular mi ahorro</button>
            <div class="simulador__result">
              <span class="hint">Ahorro estimado</span>
              <strong>$1,800 MXN / mes</strong>
            </div>
          </form>
        </div>
      </section>

      <!-- NUESTROS SERVICIOS -->
      <section id="servicios" class="servicios">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Nuestros servicios</span>
            <h2 class="section-heading">Todo lo que necesitas para moverte con GNV</h2>
            <p class="section-sub">Desde la instalación hasta el financiamiento, acompañamos todo tu proceso de conversión.</p>
          </div>
          <div class="grid grid--auto">
            {servicios.map((s) => (
              <div class="card servicio-card">
                <span class="servicio-card__icon">{s.icon}</span>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- PROGRAMA DE RECOMPENSAS -->
      <section class="recompensas">
        <div class="container recompensas__inner">
          <div class="recompensas__media">
            <Image src={placeholder} alt="Programa de recompensas GNU" width={560} height={380} />
          </div>
          <div class="recompensas__copy">
            <span class="eyebrow">Programa de recompensas</span>
            <h2 class="section-heading">Gana beneficios cada vez que cargas con nosotros</h2>
            <ul class="check-list">
              <li>Acumula puntos por cada carga en estaciones GNU.</li>
              <li>Canjea por mantenimiento, verificaciones y accesorios.</li>
              <li>Descuentos exclusivos para clientes frecuentes y flotillas.</li>
            </ul>
            <a href="#contacto" class="btn-primary">Quiero inscribirme</a>
          </div>
        </div>
      </section>

      <!-- TESTIMONIALES -->
      <section class="testimoniales">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Testimoniales</span>
            <h2 class="section-heading">Clientes que ya ahorran con GNV</h2>
          </div>
          <div class="grid grid--auto">
            {testimoniales.map((t) => (
              <div class="card testimonial-card">
                <p class="testimonial-card__quote">“{t.quote}”</p>
                <div class="testimonial-card__author">
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- UBICACIONES / MAPA DE ESTACIONES -->
      <section id="ubicaciones" class="ubicaciones">
        <div class="container ubicaciones__inner">
          <div class="ubicaciones__copy">
            <span class="eyebrow">Ubicaciones</span>
            <h2 class="section-heading">Encuentra tu estación más cercana</h2>
            <p class="section-sub">Red de estaciones y talleres certificados en crecimiento constante.</p>
            <div class="grid grid--auto ubicaciones__list">
              {ubicaciones.map((u) => (
                <div class="card card--tight">
                  <h3>{u.title}</h3>
                  <p>{u.desc}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="ubicaciones__media">
            <Image src={placeholder} alt="Mapa de estaciones GNU" width={560} height={460} />
          </div>
        </div>
      </section>

      <!-- BLOG -->
      <section id="blog" class="blog">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2 class="section-heading">Aprende más sobre el GNV</h2>
          </div>
          <div class="grid grid--auto">
            {blog.map((post) => (
              <article class="card blog-card">
                <Image src={placeholder} alt={post.title} width={360} height={200} />
                <div class="blog-card__body">
                  <span class="eyebrow">{post.tag}</span>
                  <h3>{post.title}</h3>
                  <a href="#" class="blog-card__link">Leer más →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTACTO -->
      <section id="contacto" class="contacto">
        <div class="container contacto__inner">
          <div>
            <span class="eyebrow eyebrow--on-dark">Contacto</span>
            <h2 class="section-heading contacto__title">Hablemos de tu conversión a GNV</h2>
            <p class="contacto__sub">
              Escríbenos para recibir tu cotización, agendar una verificación o resolver dudas sobre
              facturación.
            </p>
            <div class="contacto__info">
              <div>
                <strong>Facturación</strong>
                <span>facturacion@gnu-gnv.mx</span>
              </div>
              <div>
                <strong>Mapa de estaciones</strong>
                <a href="#ubicaciones">Ver todas las estaciones →</a>
              </div>
            </div>
          </div>
          <form class="card contacto__card" aria-label="Formulario de contacto">
            <div class="field">
              <label for="nombre">Nombre</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" />
            </div>
            <div class="field">
              <label for="telefono">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" placeholder="Tu teléfono" />
            </div>
            <div class="field">
              <label for="mensaje">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="3" placeholder="Cuéntanos qué necesitas"></textarea>
            </div>
            <button type="submit" class="btn-primary contacto__submit">Enviar mensaje</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <span class="logo__mark logo__mark--footer">GNU</span>
          <p>Gas Natural Vehicular — energía más limpia y económica para tu movilidad.</p>
          <div class="social-icons" aria-label="Redes sociales">
            <a href="#" aria-label="Facebook">f</a>
            <a href="#" aria-label="Instagram">ig</a>
            <a href="#" aria-label="X">x</a>
          </div>
        </div>
        <div class="site-footer__cols">
          <div>
            <h4>Sitio</h4>
            {nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
          <div>
            <h4>Servicios</h4>
            <a href="#servicios">Instala tu equipo</a>
            <a href="#servicios">Financiamiento</a>
            <a href="#servicios">Flotillas empresariales</a>
          </div>
          <div>
            <h4>Contacto</h4>
            <a href="mailto:hola@gnu-gnv.mx">hola@gnu-gnv.mx</a>
            <a href="#contacto">Agenda tu verificación</a>
          </div>
        </div>
      </div>
      <div class="container site-footer__bottom">
        <span>© {new Date().getFullYear()} GNU Gas Natural Vehicular. Todos los derechos reservados.</span>
      </div>
    </footer>

    <a
      class="whatsapp-fab"
      href="https://wa.me/5210000000000"
      target="_blank"
      rel="noreferrer"
      aria-label="Contacto directo por WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2m0 1.8a8.1 8.1 0 0 1 8.1 8.11c0 4.47-3.63 8.1-8.1 8.1a8 8 0 0 1-4.09-1.12l-.29-.17-3.14.82.84-3.06-.19-.31a8.02 8.02 0 0 1-1.23-4.26 8.1 8.1 0 0 1 8.1-8.11m-4.53 4.6c-.19 0-.5.07-.76.36-.26.28-1 .98-1 2.4 0 1.4 1.03 2.76 1.17 2.95.14.19 2 3.17 4.93 4.32 2.44.96 2.94.77 3.47.72.53-.05 1.7-.7 1.94-1.37.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.33-.28-.14-1.7-.84-1.96-.93-.26-.1-.46-.14-.65.14-.19.28-.74.93-.91 1.12-.17.19-.33.21-.62.07-.28-.14-1.2-.44-2.29-1.42-.85-.75-1.42-1.68-1.59-1.96-.17-.28-.02-.43.13-.57.13-.13.28-.33.42-.5.14-.16.19-.28.28-.47.09-.19.05-.35-.02-.5-.07-.14-.65-1.58-.9-2.16-.23-.56-.47-.48-.65-.49z" />
      </svg>
    </a>

    <script>
      const toggle = document.getElementById("nav-toggle");
      const mobileNav = document.getElementById("nav-mobile");

      toggle?.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
      });

      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav.classList.remove("is-open");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });
    </script>
  </body>
</html>

<style>
  /* HEADER */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: var(--color-on-dark);
    font-weight: 800;
    font-size: 0.8rem;
  }
  .logo__text {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .nav a {
    text-decoration: none;
    color: var(--color-text-60);
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--color-primary);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .btn-primary--compact,
  .btn-secondary--compact {
    padding: 0.6rem 1.15rem;
    font-size: 0.8rem;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
  }
  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 1.5rem 1.25rem;
  }
  .nav-mobile a {
    padding: 0.6rem 0;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    border-bottom: 1px solid var(--color-border);
  }
  .nav-mobile.is-open {
    display: flex;
  }

  @media (max-width: 900px) {
    .nav,
    .site-header__actions {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }

  /* HERO */
  .hero {
    padding-top: 4rem;
    background: radial-gradient(120% 100% at 100% 0%, var(--color-primary-tint) 0%, var(--color-bg) 55%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero__title {
    font-size: 2.75rem;
    line-height: 1.1;
    margin-top: 1rem;
  }
  .hero__sub {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    color: var(--color-text-60);
    max-width: 34rem;
  }
  .hero__cta {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .hero__stats {
    display: flex;
    gap: 2.5rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }
  .hero__stats div {
    display: flex;
    flex-direction: column;
  }
  .hero__stats strong {
    font-size: 1.5rem;
    color: var(--color-primary-alt);
  }
  .hero__stats span {
    font-size: 0.8rem;
    color: var(--color-text-40);
  }
  .hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__title {
      font-size: 2.1rem;
    }
  }

  /* BANNERS / CARRUSEL */
  .banners {
    padding-top: 0;
    padding-bottom: 2.5rem;
  }
  .banners__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }
  .banner-card {
    flex: 0 0 min(320px, 85vw);
    scroll-snap-align: start;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    background: var(--color-surface);
  }
  .banner-card :global(img) {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }
  .banner-card__body {
    padding: 1rem 1.25rem 1.35rem;
  }
  .banner-card__body h3 {
    margin-top: 0.5rem;
    font-size: 1rem;
  }

  /* SIMULADOR */
  .simulador {
    background: var(--color-bg-alt);
  }
  .simulador__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .check-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .check-list li {
    padding-left: 1.75rem;
    position: relative;
    color: var(--color-text-60);
  }
  .check-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-primary);
    font-weight: 700;
  }
  .simulador__card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .simulador__submit {
    justify-content: center;
    width: 100%;
  }
  .simulador__result {
    display: flex;
    align-items: center;
