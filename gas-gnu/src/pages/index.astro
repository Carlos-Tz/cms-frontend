---
import Layout from "../layouts/Layout.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import LeadCaptureForm from "../components/sections/LeadCaptureForm.astro";
import RewardsProgram from "../components/sections/RewardsProgram.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import LocationsList from "../components/sections/LocationsList.astro";
import BlogTeaser from "../components/sections/BlogTeaser.astro";
import ClientsShowcase from "../components/sections/ClientsShowcase.astro";
import StationsMap from "../components/sections/StationsMap.astro";
import HeroCarousel from "../components/sections/HeroCarousel.astro";
import SavingsSimulator from "../components/sections/SavingsSimulator.astro";
import ChildPageCards from "../components/ChildPageCards.astro";
import { mediaUrl } from "../functions/fetch";
import { getBlogList, getPage, sectionOf } from "../lib/cms";

// The home page keeps a curated order rather than the CMS's raw section list:
// each block is read by type from `pages/inicio`. Only types the CMS schema
// actually defines are looked up — every other block comes from its own
// endpoint (services from the menu, posts from `GET blog`).
const page = await getPage("inicio");

const bannerCarousel = sectionOf(page, "banner_carousel");
const savingsSimulator = sectionOf(page, "savings_simulator");
// The CMS reuses the generic "feature_grid" type for the rewards panel's
// content (title/items) — so it feeds the rewards section below.
const rewardsGrid = sectionOf(page, "feature_grid");
const testimonials = sectionOf(page, "testimonials");
const stationsMap = sectionOf(page, "stations_map");
const leadCaptureForm = sectionOf(page, "lead_capture_form");
const clientsShowcase = sectionOf(page, "clients_showcase");

const latestPosts = (await getBlogList(1))?.posts.slice(0, 3) ?? [];

// The first banner is what the page opens on, so it is also its social preview.
const firstSlide = bannerCarousel?.slides?.[0];
const socialImage = firstSlide?.image ? mediaUrl(firstSlide.image) : undefined;

// Offline fallbacks, used only when `pages/inicio` is unreachable at build time.
const fallbackServices = [
  { slug: "instala-tu-equipo-de-gnv", path: "/nuestros-servicios/instala-tu-equipo-de-gnv", title: "Instala tu equipo de GNV" },
  { slug: "flotillas-empresariales", path: "/nuestros-servicios/flotillas-empresariales", title: "Flotillas empresariales" },
  { slug: "estaciones-moviles", path: "/nuestros-servicios/estaciones-moviles", title: "Estaciones móviles" },
];

const fallbackBenefits = [
  "Acumula puntos por cada carga en estaciones GNU.",
  "Canjea por mantenimiento, verificaciones y accesorios.",
  "Descuentos exclusivos para clientes frecuentes y flotillas.",
];

const fallbackTestimonials = [
  { quote: "Desde que convertí mi flotilla a GNV bajé más del 40% en gasto de combustible mensual.", author: "Ricardo Peña", role: "Flotilla de taxis, Morelia" },
  { quote: "La instalación fue rápida y el soporte post-venta siempre responde el mismo día.", author: "Lupita Camacho", role: "Transporte de carga, Uruapan" },
  { quote: "El simulador de ahorro me convenció antes de pisar el taller. Los números no mienten.", author: "Juan Osorio", role: "Cliente particular" },
];

const fallbackLocations = [
  { title: "Estaciones Morelia", text: "3 puntos de carga activos las 24 horas." },
  { title: "Estación Uruapan", text: "Carga rápida y área de espera techada." },
  { title: "Agenda tu verificación", text: "Reserva tu cita de verificación anual en línea." },
  { title: "Talleres", text: "Red de talleres certificados para mantenimiento de tu equipo." },
];
---

<Layout image={socialImage}>
  <main id="inicio">
    <HeroCarousel slides={bannerCarousel?.slides} />

    <div class="hero-stats">
      <div class="container hero-stats__inner">
        <div class="hero-stats__item"><strong>+5,000</strong><span>equipos instalados</span></div>
        <div class="hero-stats__item"><strong>60%</strong><span>ahorro promedio</span></div>
        <div class="hero-stats__item"><strong>24/7</strong><span>estaciones activas</span></div>
      </div>
    </div>

    <!-- Simulador de ahorro -->
    <SavingsSimulator
      title={savingsSimulator?.title}
      intro={savingsSimulator?.intro}
      fuel_prices={savingsSimulator?.fuel_prices}
      page={page?.slug ?? "inicio"}
    />

    <!-- Nuestros Servicios: the real service pages, each card from its own hero -->
    <section class="section section--alt" id="servicios">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="eyebrow">Nuestros servicios</span>
          <h2 class="section-title">Todo lo que necesitas para moverte con GNV</h2>
        </div>
        <ChildPageCards parent="nuestros-servicios" fallback={fallbackServices} gridClass="grid--3" />
      </div>
    </section>

    <!-- Nuestros clientes -->
    <ClientsShowcase title={clientsShowcase?.title} logos={clientsShowcase?.logos} />

    <!-- Programa de recompensas -->
    {rewardsGrid?.items?.length ? (
      <FeatureGrid id="recompensas" title={rewardsGrid.title} items={rewardsGrid.items} />
    ) : (
      <RewardsProgram benefits={fallbackBenefits} cta_label="Quiero inscribirme" cta_url="/#contacto" />
    )}

    <!-- Testimoniales -->
    <Testimonials
      title={testimonials?.title}
      items={testimonials?.items?.length ? testimonials.items : fallbackTestimonials}
    />

    <!-- Ubicaciones: the map and every active station from `GET stations` -->
    {stationsMap?.center ? (
      <StationsMap id="ubicaciones" title={stationsMap.title} center={stationsMap.center} zoom={stationsMap.zoom} />
    ) : (
      <LocationsList locations={fallbackLocations} />
    )}

    <!-- Blog: the newest real posts -->
    <BlogTeaser posts={latestPosts} />

    <!-- Contacto -->
    <section class="section" id="contacto">
      <div class="container contacto-grid">
        <div>
          <span class="eyebrow">Contacto</span>
          <h2 class="section-title">Hablemos de tu conversión a GNV</h2>
          <p class="section-subtitle">
            Escríbenos para recibir tu cotización, agendar una verificación o resolver dudas sobre facturación.
          </p>
        </div>
        <LeadCaptureForm
          formId="home-lead-form"
          title={leadCaptureForm?.title ?? "Cotiza sin compromiso"}
          intro={leadCaptureForm?.intro}
          submit_label={leadCaptureForm?.submit_label ?? "Enviar mensaje"}
          fields={leadCaptureForm?.fields}
          source={page?.slug ?? "inicio"}
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  .contacto-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 860px) {
    .contacto-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
