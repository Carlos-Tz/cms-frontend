---
import CmsPage from "../../components/CmsPage.astro";
import ChildPageCards from "../../components/ChildPageCards.astro";

const fallbackChildren = [
  { slug: "instala-tu-equipo-de-gnv", path: "/nuestros-servicios/instala-tu-equipo-de-gnv", title: "Instala tu equipo de GNV" },
  { slug: "flotillas-empresariales", path: "/nuestros-servicios/flotillas-empresariales", title: "Flotillas empresariales" },
  { slug: "estaciones-moviles", path: "/nuestros-servicios/estaciones-moviles", title: "Estaciones móviles" },
];
---

<CmsPage slug="nuestros-servicios" fallbackTitle="Nuestros servicios" fallbackSubtitle="Todo lo que necesitas para moverte con GNV.">
  <section class="section zebra">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Conoce más</span>
        <h2 class="section-title">Explora Nuestros servicios</h2>
      </div>
      <ChildPageCards parent="nuestros-servicios" fallback={fallbackChildren} gridClass="grid--3" />
    </div>
  </section>
</CmsPage>
