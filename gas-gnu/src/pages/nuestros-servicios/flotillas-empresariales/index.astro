---
import Layout from "../../../layouts/Layout.astro";
import SectionRenderer from "../../../components/SectionRenderer.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import { fetchData } from "../../../functions/fetch";

type PageResponse = {
  status: string;
  data: { slug: string; path: string; title: string; sections: Array<{ type: string; content: Record<string, any> }> };
  meta: Record<string, any>;
};

const pageResponse: PageResponse | undefined = await fetchData("pages/flotillas-empresariales");
const page = pageResponse?.data;
const sections = page?.sections ?? [];
---

<Layout title={page?.title ?? "Flotillas empresariales"}>
  <main>
    {!page && <PageHero title="Flotillas empresariales" subtitle="Convierte tu flotilla y baja tu costo por kilómetro." />}
    <SectionRenderer sections={sections} pageSlug={page?.slug} />
  </main>
</Layout>
