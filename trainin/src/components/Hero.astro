---
// Slide shape matches the CMS's generic "banner_carousel" section, shared
// with landing-gnu and gas-gnu's Slide type (image/title/subtitle/link_url/link_label).
interface Slide {
	image: string;
	title: string;
	subtitle?: string | null;
	link_url?: string | null;
	link_label?: string | null;
}

interface Props {
	slides: Slide[];
	id?: string;
	// A banner that is not the page's opening section (an interior page already
	// led by a page_hero) renders shorter, so two full-bleed bands don't stack.
	compact?: boolean;
}

const { slides, id, compact = false } = Astro.props;
---

<section id={id} class:list={["hero", { "hero--compact": compact }]}>
	<div class="hero-carousel" data-carousel>
		{slides.map((slide, i) => (
			<article class="hero-slide" data-slide aria-hidden={i === 0 ? "false" : "true"}>
				<img src={slide.image} alt="" class="hero-slide-img" />
				<div class="hero-slide-overlay"></div>
				<div class="container hero-slide-content">
					<h1 class="hero-title">{slide.title}</h1>
					{slide.subtitle && <p class="hero-text">{slide.subtitle}</p>}
					{slide.link_url && slide.link_label && (
						<div class="hero-actions">
							<a class="btn-primary" href={slide.link_url}>{slide.link_label}</a>
						</div>
					)}
				</div>
			</article>
		))}

		{slides.length > 1 && (
			<div class="hero-dots" data-dots>
				{slides.map((_, i) => (
					<button class="hero-dot" data-dot data-index={i} aria-label={`Ir al banner ${i + 1}`}></button>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.hero {
		position: relative;
		background: var(--color-dark);
	}

	.hero-carousel {
		position: relative;
		height: min(38rem, 82vh);
		overflow: hidden;
	}
	/* Inset inside the page background instead of running edge to edge, so it
	   reads as its own block rather than continuing the band above it. */
	.hero--compact {
		background: transparent;
		padding: 3.5rem 1.5rem;
	}
	.hero--compact .hero-carousel {
		height: min(22rem, 45vh);
		max-width: var(--container-max);
		margin: 0 auto;
		border-radius: var(--radius-lg);
	}

	.hero-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.6s ease;
	}
	.hero-slide[aria-hidden="false"] {
		opacity: 1;
		visibility: visible;
	}

	/* Slow Ken-Burns drift. Scale never dips below 1 so object-fit: cover never
	   reveals an edge, and 0%/100% match so the loop is seamless. */
	@keyframes hero-img-zoom {
		0%,
		100% {
			transform: scale(1.04);
		}
		50% {
			transform: scale(1.2);
		}
	}

	.hero-slide-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: hero-img-zoom 26s ease-in-out infinite;
	}

	/* Copy resolves a beat after the image, line by line. Only the opening slide
	   gets it — the rest arrive by crossfade, which is its own motion. */
	@keyframes hero-copy-in {
		from {
			opacity: 0;
			transform: translateY(1.4rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.hero-slide:first-child .hero-slide-content > * {
		animation: hero-copy-in 0.9s 0.2s var(--ease-out) both;
	}
	.hero-slide:first-child .hero-slide-content > *:nth-child(2) {
		animation-delay: 0.34s;
	}
	.hero-slide:first-child .hero-slide-content > *:nth-child(3) {
		animation-delay: 0.48s;
	}

	/* The active dot fills from the left over the autoplay interval, so the
	   carousel shows how long the current banner has left. */
	@keyframes hero-dot-fill {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.hero-slide-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, rgba(32, 29, 30, 0.92) 0%, rgba(32, 29, 30, 0.75) 45%, rgba(200, 16, 46, 0.55) 100%);
	}

	.hero-slide-content {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.1rem;
		max-width: 40rem;
		color: #fff;
	}

	.eyebrow--on-dark {
		border-color: rgba(255, 255, 255, 0.35);
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
	}

	.hero-title {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
	}
	.hero--compact .hero-slide-content {
		padding-inline: 2.5rem;
	}
	.hero--compact .hero-title {
		font-size: clamp(1.4rem, 2.6vw, 1.9rem);
	}
	.hero--compact .hero-text {
		font-size: 0.98rem;
	}

	.hero-text {
		color: var(--color-text-on-dark-60);
		font-size: 1.05rem;
		max-width: 34rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}

	.btn-secondary--on-dark {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.35);
	}
	.btn-secondary--on-dark:hover {
		border-color: #fff;
	}

	.hero-dots {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.5rem;
		z-index: 2;
	}
	.hero-dot {
		position: relative;
		width: 2.25rem;
		height: 0.3rem;
		border-radius: var(--radius-full);
		border: none;
		background: rgba(255, 255, 255, 0.35);
		cursor: pointer;
		padding: 0;
		transition: background 0.2s ease, width 0.3s var(--ease-out);
	}
	/* The painted bar is 5px tall, well under the 24×24 CSS-px target WCAG 2.5.8
	   asks for; this enlarges what the finger has to hit without changing what
	   is drawn. */
	.hero-dot::before {
		content: "";
		position: absolute;
		inset: -1.1rem -0.25rem;
	}
	.hero-dot:hover {
		background: rgba(255, 255, 255, 0.6);
	}
	.hero-dot[aria-current="true"] {
		width: 3.25rem;
	}
	.hero-dot::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: var(--color-red);
		transform: scaleX(0);
		transform-origin: left center;
	}
	/* 6s matches the carousel's autoplay interval in the script below. */
	.hero-dot[aria-current="true"]::after {
		animation: hero-dot-fill 6s linear forwards;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-slide-img,
		.hero-slide:first-child .hero-slide-content > * {
			animation: none;
		}
		.hero-slide {
			transition: none;
		}
		.hero-dot[aria-current="true"]::after {
			animation: none;
			transform: scaleX(1);
		}
	}
</style>

<script>
	function initCarousel(root: HTMLElement) {
		const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
		let active = 0;
		let timer: ReturnType<typeof setInterval>;

		function show(index: number) {
			active = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.setAttribute("aria-hidden", i === active ? "false" : "true"));
			dots.forEach((dot, i) => dot.setAttribute("aria-current", i === active ? "true" : "false"));
		}

		function next() {
			show(active + 1);
		}

		function restart() {
			clearInterval(timer);
			timer = setInterval(next, 6000);
		}

		dots.forEach((dot) => {
			dot.addEventListener("click", () => {
				show(Number(dot.dataset.index));
				restart();
			});
		});

		show(0);
		restart();
	}

	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);
</script>
