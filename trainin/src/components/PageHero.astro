---
import { titleLines } from "../functions/labels";
// Content shape matches the CMS's "page_hero" section: the banner at the top
// of an interior page (title, optional subtitle, optional background image).
interface Props {
	title: string;
	subtitle?: string | null;
	image?: string | null;
}

const { title, subtitle, image } = Astro.props;
---

<section class:list={["page-hero", { "page-hero--image": !!image }]}>
	{image && <img src={image} alt="" class="page-hero-img" />}
	<span class="page-hero-glow" aria-hidden="true"></span>

	<div class="container page-hero-content">
		<h1 class="page-hero-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h1>
		{subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		background: var(--color-dark);
		color: var(--color-text-on-dark);
		padding: clamp(4rem, 8vw, 7rem) 0;
		overflow: hidden;
		isolation: isolate;
	}

	.page-hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.35;
		z-index: -2;
		/* Slow drift, so a static banner image still feels alive. */
		animation: page-hero-drift 24s ease-in-out infinite alternate;
	}

	/* Angled brand wash sweeping in from the right, echoing the diagonal
	   accents the reference template uses on its inner banners. */
	.page-hero-glow {
		position: absolute;
		inset: -30% -20% -30% 45%;
		z-index: -1;
		background: linear-gradient(115deg, rgba(200, 16, 46, 0) 0%, rgba(200, 16, 46, 0.55) 100%);
		transform: skewX(-14deg);
		pointer-events: none;
	}

	.page-hero-content {
		position: relative;
		max-width: 46rem;
	}

	.page-hero-title {
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		line-height: 1.08;
		animation: page-hero-in 0.8s var(--ease-out) both;
	}

	.page-hero-subtitle {
		margin-top: 1.1rem;
		max-width: 34rem;
		font-size: 1.05rem;
		color: var(--color-text-on-dark-60);
		animation: page-hero-in 0.8s 0.12s var(--ease-out) both;
	}

	/* The title sits above a rule that widens once the banner has settled. */
	.page-hero-title::after {
		content: "";
		display: block;
		width: 0;
		height: 4px;
		margin-top: 1.25rem;
		border-radius: var(--radius-full);
		background: #fff;
		animation: page-hero-rule 0.9s 0.35s var(--ease-out) forwards;
	}

	@keyframes page-hero-in {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes page-hero-rule {
		to {
			width: 4.5rem;
		}
	}

	@keyframes page-hero-drift {
		from {
			transform: scale(1.06) translate3d(0, 0, 0);
		}
		to {
			transform: scale(1.14) translate3d(-1.5%, -1%, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-hero-img,
		.page-hero-title,
		.page-hero-subtitle {
			animation: none;
		}
		.page-hero-title::after {
			width: 4.5rem;
			animation: none;
		}
	}
</style>
