---
const navLinks = [
	{ href: "#inicio", label: "Inicio" },
	{ href: "#servicios", label: "Nuestros servicios" },
	{ href: "#nosotros", label: "Sobre nosotros" },
	{ href: "#contacto", label: "Contacto" },
	{ href: "#ubicaciones", label: "Ubicaciones" },
];

const socials = [
	{ label: "Facebook", href: "#", path: "M13.5 9H15V6.5h-1.75C11.6 6.5 10.5 7.6 10.5 9.25V11H9v2.5h1.5V19h2.5v-5.5H15l.5-2.5h-2v-1.25c0-.4.1-.75.5-.75Z" },
	{ label: "Instagram", href: "#", path: "M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.27a2.47 2.47 0 1 1 0-4.94 2.47 2.47 0 0 1 0 4.94ZM16.2 5H7.8A2.8 2.8 0 0 0 5 7.8v8.4A2.8 2.8 0 0 0 7.8 19h8.4a2.8 2.8 0 0 0 2.8-2.8V7.8A2.8 2.8 0 0 0 16.2 5Zm1.5 11.2c0 .83-.67 1.5-1.5 1.5H7.8c-.83 0-1.5-.67-1.5-1.5V7.8c0-.83.67-1.5 1.5-1.5h8.4c.83 0 1.5.67 1.5 1.5v8.4ZM16.4 7.6a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z" },
	{ label: "LinkedIn", href: "#", path: "M6.94 8.5H4.56V19h2.38V8.5ZM5.75 4.9a1.38 1.38 0 1 0 0 2.76 1.38 1.38 0 0 0 0-2.76ZM19.44 19h-2.38v-5.37c0-1.28-.46-2.15-1.6-2.15-.87 0-1.39.59-1.62 1.15-.08.2-.1.49-.1.77V19H11.4s.03-9.44 0-10.5h2.34v1.49c.31-.48 .87-1.16 2.12-1.16 1.55 0 2.71 1.01 2.71 3.18V19Z" },
];
---

<header class="site-header">
	<div class="container header-row">
		<a href="#inicio" class="logo" aria-label="Traninn Logistic — Inicio">
			<span class="logo-part logo-part--red">TRAN</span><span class="logo-part logo-part--dark">INN</span>
			<span class="logo-part logo-part--gray">LOGISTIC</span>
		</a>

		<nav class="nav" aria-label="Navegación principal">
			{navLinks.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>

		<div class="header-actions">
			<div class="socials" aria-label="Redes sociales">
				{socials.map((s) => (
					<a href={s.href} aria-label={s.label} class="social-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={s.path}></path></svg>
					</a>
				))}
			</div>
			<a class="btn-primary header-cta" href="https://wa.me/000000000000" target="_blank" rel="noopener noreferrer">
				Escríbenos
			</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: #fff;
		border-bottom: 1px solid var(--color-border);
	}

	.header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-top: 0.9rem;
		padding-bottom: 0.9rem;
	}

	.logo {
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}
	.logo-part--red { color: var(--color-red); }
	.logo-part--dark { color: var(--color-dark); }
	.logo-part--gray { color: var(--color-gray); margin-left: 0.3rem; }

	.nav {
		display: flex;
		gap: 1.75rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text-60);
	}
	.nav a {
		transition: color 0.15s ease;
	}
	.nav a:hover {
		color: var(--color-red);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.socials {
		display: flex;
		gap: 0.5rem;
	}
	.social-icon {
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		color: var(--color-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
	}
	.social-icon:hover {
		color: #fff;
		background: var(--color-red);
		border-color: var(--color-red);
	}

	.header-cta {
		padding: 0.6rem 1.35rem;
		font-size: 0.85rem;
	}

	@media (max-width: 900px) {
		.nav {
			display: none;
		}
	}
</style>
