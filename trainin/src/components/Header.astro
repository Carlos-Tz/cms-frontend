---
import Logo from "./Logo.astro";
interface Social {
	label: string;
	href: string;
	path: string;
}

export interface MenuItem {
	slug: string;
	path: string;
	title: string;
	children?: MenuItem[];
}

interface Props {
	menu?: MenuItem[];
	socials?: Social[];
	// Null when the CMS has no WhatsApp number: the CTA is then not rendered
	// at all, rather than pointing at a placeholder.
	whatsappUrl?: string | null;
}

// Used only if the CMS menu endpoint is unreachable.
const fallbackMenu: MenuItem[] = [
	{ slug: "inicio", path: "/", title: "Inicio", children: [] },
	{ slug: "nuestros-servicios", path: "/nuestros-servicios", title: "Nuestros servicios", children: [] },
	{ slug: "sobre-nosotros", path: "/sobre-nosotros", title: "Sobre nosotros", children: [] },
	{ slug: "ubicaciones", path: "/ubicaciones", title: "Ubicaciones", children: [] },
];

const fallbackSocials: Social[] = [
	{ label: "facebook", href: "#", path: "M13.5 9H15V6.5h-1.75C11.6 6.5 10.5 7.6 10.5 9.25V11H9v2.5h1.5V19h2.5v-5.5H15l.5-2.5h-2v-1.25c0-.4.1-.75.5-.75Z" },
	{ label: "instagram", href: "#", path: "M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.27a2.47 2.47 0 1 1 0-4.94 2.47 2.47 0 0 1 0 4.94ZM16.2 5H7.8A2.8 2.8 0 0 0 5 7.8v8.4A2.8 2.8 0 0 0 7.8 19h8.4a2.8 2.8 0 0 0 2.8-2.8V7.8A2.8 2.8 0 0 0 16.2 5Zm1.5 11.2c0 .83-.67 1.5-1.5 1.5H7.8c-.83 0-1.5-.67-1.5-1.5V7.8c0-.83.67-1.5 1.5-1.5h8.4c.83 0 1.5.67 1.5 1.5v8.4ZM16.4 7.6a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z" },
	{ label: "linkedin", href: "#", path: "M6.94 8.5H4.56V19h2.38V8.5ZM5.75 4.9a1.38 1.38 0 1 0 0 2.76 1.38 1.38 0 0 0 0-2.76ZM19.44 19h-2.38v-5.37c0-1.28-.46-2.15-1.6-2.15-.87 0-1.39.59-1.62 1.15-.08.2-.1.49-.1.77V19H11.4s.03-9.44 0-10.5h2.34v1.49c.31-.48 .87-1.16 2.12-1.16 1.55 0 2.71 1.01 2.71 3.18V19Z" },
];

const { menu, socials = fallbackSocials, whatsappUrl = null } = Astro.props;

// The CMS menu endpoint does not list the blog, so it is appended alongside it.
const blogItem: MenuItem = { slug: "blog", path: "/blog", title: "Blog", children: [] };
const navItems = [...(menu?.length ? menu : fallbackMenu), blogItem];

const normalize = (path: string) => (path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path);
const currentPath = normalize(Astro.url.pathname);
const isCurrent = (path: string) => normalize(path) === currentPath;
// A section stays highlighted while the visitor is on one of its sub-pages
// (a blog entry, a service detail), not only on its own path.
const isUnder = (path: string) => path !== "/" && currentPath.startsWith(`${normalize(path)}/`);
const isActive = (item: MenuItem): boolean =>
	isCurrent(item.path) || isUnder(item.path) || (item.children ?? []).some(isActive);
---

<header class="site-header">
	<div class="container header-row">
		<Logo href="/" />

		<nav class="nav" aria-label="Navegación principal">
			<ul class="nav-list">
				{navItems.map((item) => (
					<li class:list={["nav-item", { "has-children": !!item.children?.length }]}>
						<a
							href={item.path}
							class:list={["nav-link", { active: isActive(item) }]}
							aria-current={isCurrent(item.path) ? "page" : undefined}
							aria-haspopup={item.children?.length ? "true" : undefined}
						>
							{item.title}
							{item.children?.length ? (
								<svg class="nav-caret" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
									<path
										d="M6 9l6 6 6-6"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							) : null}
						</a>
						{item.children?.length ? (
							<ul class="submenu">
								{item.children.map((child) => (
									<li>
										<a
											href={child.path}
											class:list={["submenu-link", { active: isCurrent(child.path) }]}
											aria-current={isCurrent(child.path) ? "page" : undefined}
										>
											{child.title}
										</a>
									</li>
								))}
							</ul>
						) : null}
					</li>
				))}
			</ul>
		</nav>

		<div class="header-actions">
			<div class="socials" aria-label="Redes sociales">
				{socials.map((s) => (
					<a href={s.href} aria-label={s.label} class="social-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={s.path}></path></svg>
					</a>
				))}
			</div>
			{whatsappUrl && <a class="btn-primary header-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
				Escríbenos
			</a>}
		</div>

		<button
			class="nav-toggle"
			id="nav-toggle"
			type="button"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="nav-mobile"
		>
			<span></span><span></span><span></span>
		</button>
	</div>

	{/* Below 900px the inline nav is hidden and this drawer takes over. A parent
	    with children becomes a <details> so its sublinks are reachable without
	    a hover state that phones don't have. */}
	<nav class="nav-mobile" id="nav-mobile" aria-label="Navegación móvil">
		{navItems.map((item) =>
			item.children?.length ? (
				<details class="nav-mobile__item">
					<summary>{item.title}</summary>
					<ul class="nav-mobile__sublist">
						<li>
							<a href={item.path} aria-current={isCurrent(item.path) ? "page" : undefined}>
								Ver {item.title}
							</a>
						</li>
						{item.children.map((child) => (
							<li>
								<a href={child.path} aria-current={isCurrent(child.path) ? "page" : undefined}>
									{child.title}
								</a>
							</li>
						))}
					</ul>
				</details>
			) : (
				<a href={item.path} aria-current={isCurrent(item.path) ? "page" : undefined}>
					{item.title}
				</a>
			)
		)}

		<div class="nav-mobile__actions">
			<div class="socials socials--mobile" aria-label="Redes sociales">
				{socials.map((s) => (
					<a href={s.href} aria-label={s.label} class="social-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={s.path}></path></svg>
					</a>
				))}
			</div>
			{whatsappUrl && <a class="btn-primary header-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
				Escríbenos
			</a>}
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: #fff;
		border-bottom: 1px solid var(--color-border);
		transition: box-shadow 0.35s var(--ease-out), background 0.35s var(--ease-out);
	}
	/* Condensed once the page has scrolled, the way the reference template
	   shrinks its sticky bar. */
	.site-header.is-stuck {
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(10px);
		box-shadow: 0 10px 30px -18px rgba(32, 29, 30, 0.55);
	}

	.header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-top: 1.1rem;
		padding-bottom: 1.1rem;
		transition: padding 0.35s var(--ease-out);
	}
	.site-header.is-stuck .header-row {
		padding-top: 0.65rem;
		padding-bottom: 0.65rem;
	}


	.nav {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text-60);
	}

	.nav-list {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.4rem 0;
		white-space: nowrap;
		font-family: var(--font-title);
		font-size: 0.98rem;
		transition: color 0.25s ease;
	}
	.nav-link::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: 0;
		border-radius: var(--radius-full);
		background: var(--color-red);
		transition: width 0.35s var(--ease-out);
	}
	.nav-item:hover > .nav-link::after,
	.nav-link.active::after {
		width: 100%;
	}
	.nav-link:hover,
	.nav-link.active {
		color: var(--color-red);
	}

	.nav-caret {
		transition: transform 0.15s ease;
	}
	.nav-item.has-children:hover .nav-caret,
	.nav-item.has-children:focus-within .nav-caret {
		transform: rotate(180deg);
	}

	.submenu {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 14rem;
		margin: 0;
		padding: 0.4rem 0;
		list-style: none;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 0.6rem;
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.09);
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.35rem);
		transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
	}
	.nav-item.has-children:hover .submenu,
	.nav-item.has-children:focus-within .submenu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.submenu-link {
		display: block;
		padding: 0.5rem 1rem;
		font-weight: 500;
		white-space: nowrap;
		color: var(--color-text-60);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.submenu-link:hover,
	.submenu-link.active {
		color: var(--color-red);
		background: #f6f6f7;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.socials {
		display: flex;
		gap: 0.5rem;
	}
	.social-icon {
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		color: var(--color-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
	}
	.social-icon:hover {
		color: #fff;
		background: var(--color-red);
		border-color: var(--color-red);
	}

	.header-cta {
		padding: 0.6rem 1.35rem;
		font-size: 0.85rem;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: none;
		cursor: pointer;
	}
	.nav-toggle span {
		display: block;
		height: 2px;
		border-radius: 1px;
		background: var(--color-dark);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	/* Open state folds the three bars into a cross. */
	.nav-toggle[aria-expanded="true"] span:first-child {
		transform: translateY(7px) rotate(45deg);
	}
	.nav-toggle[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle[aria-expanded="true"] span:last-child {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav-mobile {
		display: none;
		flex-direction: column;
		padding: 0.5rem 1.5rem 1.5rem;
		border-top: 1px solid var(--color-border);
		background: #fff;
		/* The header is sticky, so a long menu has to scroll on its own rather
		   than running off the bottom of the viewport. */
		max-height: calc(100dvh - 4.5rem);
		overflow-y: auto;
	}

	.nav-mobile a {
		display: block;
		padding: 0.7rem 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
	}
	.nav-mobile a[aria-current="page"] {
		color: var(--color-red);
	}

	.nav-mobile__item summary {
		padding: 0.7rem 0;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		list-style: none;
		border-bottom: 1px solid var(--color-border);
	}
	.nav-mobile__item summary::-webkit-details-marker {
		display: none;
	}
	.nav-mobile__item summary::after {
		content: "＋";
		float: right;
		color: var(--color-red);
	}
	.nav-mobile__item[open] summary::after {
		content: "−";
	}

	.nav-mobile__sublist {
		margin: 0;
		padding: 0 0 0 1rem;
		list-style: none;
	}
	.nav-mobile__sublist a {
		font-weight: 500;
		color: var(--color-text-60);
	}

	/* .socials is hidden in the header row below 1240px; inside the drawer it
	   stays, since that is where navigation lives at those widths. */
	.nav-mobile .socials--mobile {
		display: flex;
	}

	.nav-mobile__actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1.25rem;
	}
	.nav-mobile__actions a {
		border-bottom: none;
		padding: 0;
	}
	.nav-mobile__actions .header-cta {
		color: #fff;
		padding: 0.6rem 1.35rem;
	}

	/* Between the breakpoint and ~1240px the row fits only once the social
	   icons step aside; the CTA and the nav itself are what visitors need. */
	@media (max-width: 1240px) {
		.socials {
			display: none;
		}

		.nav-list {
			gap: 1.15rem;
		}
	}

	@media (max-width: 1080px) {
		.nav,
		.header-actions {
			display: none;
		}

		.nav-toggle {
			display: flex;
		}

		/* Scoped to the breakpoint so a drawer left open before a resize to
		   desktop can't stay expanded beside the inline nav. */
		.nav-mobile.is-open {
			display: flex;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-toggle span,
		.nav-caret,
		.submenu {
			transition: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById("nav-toggle");
	const mobileNav = document.getElementById("nav-mobile");

	toggle?.addEventListener("click", () => {
		const isOpen = mobileNav?.classList.toggle("is-open");
		toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
		toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
	});

	function closeMobileNav() {
		mobileNav?.classList.remove("is-open");
		toggle?.setAttribute("aria-expanded", "false");
		toggle?.setAttribute("aria-label", "Abrir menú");
	}

	// Astro ships static pages, so a link click is a full navigation — but the
	// drawer is closed anyway for in-page anchors and for the back button
	// restoring this page from the bfcache.
	mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileNav));

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMobileNav();
	});

	// Resizing past the breakpoint with the drawer open would otherwise leave
	// aria-expanded="true" on a toggle the CSS has just hidden.
	const desktopNav = window.matchMedia("(min-width: 1081px)");
	const syncNavToBreakpoint = () => {
		if (desktopNav.matches) closeMobileNav();
	};
	desktopNav.addEventListener("change", syncNavToBreakpoint);
	syncNavToBreakpoint();

	// Condense the sticky bar once the page has moved off the top.
	const header = document.querySelector(".site-header");
	if (header) {
		const syncStuck = () => header.classList.toggle("is-stuck", window.scrollY > 24);
		window.addEventListener("scroll", syncStuck, { passive: true });
		syncStuck();
	}
</script>
