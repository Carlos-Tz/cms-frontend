---
// Content shape matches the CMS's "clients_showcase" section. A client may
// carry only a logo (the compact grid) or also a description and testimonial,
// in which case the section renders as cards.
interface Logo {
	name: string;
	image: string;
	url?: string | null;
	description?: string | null;
	quote?: string | null;
	quote_author?: string | null;
}

interface Props {
	title?: string | null;
	logos: Logo[];
}

const { title, logos } = Astro.props;

const hasDetails = logos.some((logo) => logo.description || logo.quote);
---

<section id="clientes" class="section clientes">
	<div class="container">
		{title && (
			<div class="section-head clientes-head">
				<h2 class="section-title">{title}</h2>
			</div>
		)}

		{hasDetails ? (
			<div class="clientes-cards">
				{logos.map((logo) => (
					<article class="card cliente-card">
						<div class="cliente-card-head">
							<h3 class="cliente-card-name">
								{logo.url ? (
									<a href={logo.url} target="_blank" rel="noopener noreferrer">{logo.name}</a>
								) : (
									logo.name
								)}
							</h3>

							<div class="cliente-card-logo">
								<img src={logo.image} alt={logo.name} loading="lazy" />
							</div>
						</div>
						{logo.description && <p class="cliente-card-text">{logo.description}</p>}
						{logo.quote && (
							<blockquote class="cliente-card-quote">
								<p>{logo.quote}</p>
								{logo.quote_author && <cite>{logo.quote_author}</cite>}
							</blockquote>
						)}
					</article>
				))}
			</div>
		) : (
			<div class="clientes-grid">
				{logos.map((logo) =>
					logo.url ? (
						<a class="cliente-logo" href={logo.url} target="_blank" rel="noopener noreferrer">
							<img src={logo.image} alt={logo.name} />
						</a>
					) : (
						<div class="cliente-logo">
							<img src={logo.image} alt={logo.name} />
						</div>
					)
				)}
			</div>
		)}
	</div>
</section>

<style>
	.clientes-head {
		text-align: center;
		margin-left: auto;
		margin-right: auto;
	}

	.clientes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 1.5rem;
	}

	.cliente-logo {
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		overflow: hidden;
		aspect-ratio: 3 / 2;
		filter: grayscale(1);
		opacity: 0.75;
		transition: filter 0.2s ease, opacity 0.2s ease;
	}
	.cliente-logo:hover {
		filter: grayscale(0);
		opacity: 1;
	}
	.cliente-logo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.clientes-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 1.5rem;
	}

	.cliente-card {
		position: relative;
		padding: 2rem 1.9rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	/* Oversized quote glyph behind the card corner, as in the template's
	   testimonial blocks. */
	.cliente-card-quote::before {
		content: "\201C";
		position: absolute;
		top: -1.7rem;
		left: 0.4rem;
		font-family: var(--font-title);
		font-size: 4.5rem;
		line-height: 1;
		color: rgba(200, 16, 46, 0.16);
		pointer-events: none;
		transition: color 0.4s var(--ease-out);
	}
	.cliente-card:hover .cliente-card-quote::before {
		color: rgba(200, 16, 46, 0.26);
	}
	.cliente-card > * {
		position: relative;
		z-index: 1;
	}

	.cliente-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.cliente-card-logo {
		flex-shrink: 0;
		width: 7.5rem;
		height: 4.5rem;
		padding: 0.5rem 0.65rem;
		border-radius: var(--radius-md);
		background: #fff;
		border: 1px solid var(--color-border);
	}
	.cliente-card-logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	@media (max-width: 420px) {
		.cliente-card-logo {
			width: 5.5rem;
			height: 3.25rem;
		}
	}

	.cliente-card-name {
		font-size: 1.25rem;
		line-height: 1.25;
	}
	.cliente-card-name a:hover {
		color: var(--color-red);
	}

	.cliente-card-text {
		color: var(--color-text-60);
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.cliente-card-quote {
		position: relative;
		margin: 1.9rem 0 0;
		padding-left: 1.1rem;
		border-left: 3px solid var(--color-red);
		color: var(--color-text-60);
		font-size: 0.95rem;
		line-height: 1.65;
	}
	.cliente-card-quote p {
		font-style: italic;
	}
	.cliente-card-quote cite {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.85rem;
		font-style: normal;
		font-weight: 600;
		color: var(--color-dark);
	}
</style>
