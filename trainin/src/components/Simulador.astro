---
// Content shape matches the CMS's "savings_simulator" section (shared with
// landing-gnu/gas-gnu): a list of fuel prices compared against gas natural.
import { BASE_URL } from "../functions/fetch";

interface FuelPrice {
	fuel: string;
	label: string;
	price_per_unit: number;
	unit: string;
	equivalence_factor: number;
}

interface Props {
	title?: string | null;
	intro?: string | null;
	fuelPrices: FuelPrice[];
	// Slug of the page this simulator sits on. A site may carry more than one
	// savings_simulator, each with its own reference prices, and the endpoint
	// needs this to price against the right one.
	page?: string | null;
}

const GNC_FUEL_KEY = "gas-natural";

const { title, intro, fuelPrices, page = null } = Astro.props;

// equivalence_factor normalizes each fuel's native unit (m³, litro, …) to a
// comparable cost basis; GNC's own factor is always 1 (the reference unit).
const effectiveCost = (price: FuelPrice) => price.price_per_unit * price.equivalence_factor;

const gncPrice = fuelPrices.find((price) => price.fuel === GNC_FUEL_KEY);
const comparableFuels = fuelPrices.filter((price) => price.fuel !== GNC_FUEL_KEY && price.price_per_unit > 0);

const fuelOptions = gncPrice
	? comparableFuels.map((price) => ({
			fuel: price.fuel,
			label: price.label,
			rate: 1 - effectiveCost(gncPrice) / effectiveCost(price),
		}))
	: [];
const savingsRatesByFuel = Object.fromEntries(fuelOptions.map((option) => [option.fuel, option.rate]));
// The endpoint takes a quantity in the fuel's own unit, not a peso amount, so
// the browser needs each price to convert the spend it was given.
const pricesByFuel = Object.fromEntries(comparableFuels.map((price) => [price.fuel, price.price_per_unit]));
---

<section id="simulador" class="section simulador">
	<div class="container simulador-grid">
		<div class="section-head simulador-copy">
			{title && <h2 class="section-title">{title}</h2>}
			{intro && <p class="simulador-text">{intro}</p>}
		</div>

		<form class="card simulador-card" data-simulador>
			<div class="field">
				<label for="fuel-actual">Combustible que usas actualmente</label>
				<select id="fuel-actual" name="fuelActual">
					{fuelOptions.map((option) => (
						<option value={option.fuel}>{option.label}</option>
					))}
				</select>
			</div>
			<div class="field">
				<label for="gasto-mensual">Gasto mensual actual (MXN)</label>
				<input id="gasto-mensual" name="gastoMensual" type="number" min="0" step="1" placeholder="Ej. 30000" required />
			</div>

			<div class="simulador-result">
				<div class="simulador-result-item">
					<span class="simulador-result-label">Ahorro mensual estimado</span>
					<span class="simulador-result-value simulador-result-value--highlight" data-result="ahorroMensual">$0 MXN</span>
				</div>
				<div class="simulador-result-item simulador-result-item--highlight">
					<span class="simulador-result-label">Ahorro anual estimado</span>
					<span class="simulador-result-value" data-result="ahorroAnual">$0 MXN</span>
				</div>
			</div>
		</form>
	</div>
</section>

<style>
	.simulador-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.simulador-copy .section-head {
		margin-bottom: 0;
	}

	.simulador-text {
		margin-top: 1rem;
		color: var(--color-text-60);
		font-size: 1rem;
		max-width: 30rem;
	}

	.simulador-card {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.field label {
		display: block;
		margin-bottom: 0.3rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-60);
	}
	.field input,
	.field select {
		width: 100%;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding: 0.85rem 1.2rem;
		font-size: 0.95rem;
		color: var(--color-text);
		font-family: inherit;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
	}
	.field input:focus,
	.field select:focus {
		outline: none;
		border-color: var(--color-red);
		background: #fff;
		box-shadow: 0 0 0 4px rgba(200, 16, 46, 0.12);
	}

	.simulador-result {
		margin-top: 0.25rem;
		padding: 1.35rem 1.5rem;
		border-radius: var(--radius-lg);
		background: var(--color-dark);
		color: var(--color-text-on-dark);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.simulador-result-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.95rem;
	}
	.simulador-result-label {
		display: block;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-60);
	}
	.simulador-result-value {
		font-family: var(--font-title);
		font-size: 1.45rem;
		font-weight: 700;
		line-height: 1.1;
	}
	/* Inside the dark result panel the annual figure is the one to land on, so
	   it gets the brand block and white type — red on near-black would not
	   carry enough contrast. */
	.simulador-result-item--highlight {
		border-radius: var(--radius-md);
		background: var(--color-red);
		padding: 0.85rem 1.1rem;
		margin-top: 0.25rem;
	}
	.simulador-result-item--highlight .simulador-result-label {
		color: rgba(255, 255, 255, 0.78);
	}
	.simulador-result-value--highlight {
		color: #fff;
		font-size: 1.7rem;
	}

	@media (max-width: 860px) {
		.simulador-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	/* iOS Safari zooms the whole page when a focused control's text is under
	   16px, and there is no way back out except a pinch. */
	@media (max-width: 860px) {
		.field input,
		.field select {
			font-size: 1rem;
		}
	}
</style>

<script define:vars={{ savingsRatesByFuel, pricesByFuel, apiBase: BASE_URL, simulatorPage: page }} is:inline>
	function formatCurrency(value) {
		return `$${Math.round(value).toLocaleString("es-MX")} MXN`;
	}

	function initSimulador(form) {
		const fuelSelect = form.querySelector("#fuel-actual");
		const gastoMensual = form.querySelector("#gasto-mensual");
		const ahorroMensualEl = form.querySelector('[data-result="ahorroMensual"]');
		const ahorroAnualEl = form.querySelector('[data-result="ahorroAnual"]');

		// Nudge the figure so a recalculation is visible even when the number
		// barely moves. The class has to come off (and the browser has to lay
		// out in between) before it can be re-added, or the keyframe won't replay.
		function pulse(el) {
			el.classList.remove("is-updated");
			void el.offsetWidth;
			el.classList.add("is-updated");
		}

		function render(ahorroMensual) {
			const nextMensual = formatCurrency(ahorroMensual);
			const nextAnual = formatCurrency(ahorroMensual * 12);

			if (ahorroMensualEl.textContent !== nextMensual) {
				ahorroMensualEl.textContent = nextMensual;
				pulse(ahorroMensualEl);
			}
			if (ahorroAnualEl.textContent !== nextAnual) {
				ahorroAnualEl.textContent = nextAnual;
				pulse(ahorroAnualEl);
			}
		}

		// The CMS owns the savings formula and the reference prices behind it
		// (`GET {site}/savings-simulator`). The rates baked into this page are
		// as old as the last build, so they only drive the instant estimate
		// while typing; the figure that settles is the server's.
		let pending = null;
		let requestId = 0;

		async function confirmWithServer(spend, fuel) {
			const pricePerUnit = pricesByFuel[fuel];
			if (!spend || !pricePerUnit) return;

			const query = new URLSearchParams({ fuel, quantity: String(spend / pricePerUnit) });
			if (simulatorPage) query.set("page", simulatorPage);

			const id = ++requestId;
			try {
				const response = await fetch(`${apiBase}savings-simulator?${query}`);
				const result = await response.json().catch(() => null);
				// A stale answer must never overwrite a newer one.
				if (id !== requestId || !response.ok || result?.status !== "success") return;
				if (Number.isFinite(result?.data?.savings)) render(Math.max(result.data.savings, 0));
			} catch (error) {
				// Keep the local estimate already on screen.
			}
		}

		function recalc() {
			const spend = Number(gastoMensual.value) || 0;
			const fuel = fuelSelect.value;
			const rate = savingsRatesByFuel[fuel] ?? 0;

			render(Math.max(spend * rate, 0));

			clearTimeout(pending);
			pending = setTimeout(() => confirmWithServer(spend, fuel), 400);
		}

		[fuelSelect, gastoMensual].forEach((input) => input.addEventListener("input", recalc));
		form.addEventListener("submit", (event) => event.preventDefault());
		recalc();
	}

	document.querySelectorAll("[data-simulador]").forEach(initSimulador);
</script>
