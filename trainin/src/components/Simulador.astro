---
// Content shape matches the CMS's "savings_simulator" section (shared with
// landing-gnu/gas-gnu): a list of fuel prices compared against gas natural.
interface FuelPrice {
	fuel: string;
	label: string;
	price_per_unit: number;
	unit: string;
	equivalence_factor: number;
}

interface Props {
	title?: string | null;
	intro?: string | null;
	fuelPrices: FuelPrice[];
}

const GNC_FUEL_KEY = "gas-natural";

const { title, intro, fuelPrices } = Astro.props;

// equivalence_factor normalizes each fuel's native unit (m³, litro, …) to a
// comparable cost basis; GNC's own factor is always 1 (the reference unit).
const effectiveCost = (price: FuelPrice) => price.price_per_unit * price.equivalence_factor;

const gncPrice = fuelPrices.find((price) => price.fuel === GNC_FUEL_KEY);
const comparableFuels = fuelPrices.filter((price) => price.fuel !== GNC_FUEL_KEY && price.price_per_unit > 0);

const fuelOptions = gncPrice
	? comparableFuels.map((price) => ({
			fuel: price.fuel,
			label: price.label,
			rate: 1 - effectiveCost(gncPrice) / effectiveCost(price),
		}))
	: [];
const savingsRatesByFuel = Object.fromEntries(fuelOptions.map((option) => [option.fuel, option.rate]));
---

<section id="simulador" class="section simulador">
	<div class="container simulador-grid">
		<div class="section-head simulador-copy">
			{title && <h2 class="section-title">{title}</h2>}
			{intro && <p class="simulador-text">{intro}</p>}
		</div>

		<form class="card simulador-card" data-simulador>
			<div class="field">
				<label for="fuel-actual">Combustible que usas actualmente</label>
				<select id="fuel-actual" name="fuelActual">
					{fuelOptions.map((option) => (
						<option value={option.fuel}>{option.label}</option>
					))}
				</select>
			</div>
			<div class="field">
				<label for="gasto-mensual">Gasto mensual actual (MXN)</label>
				<input id="gasto-mensual" name="gastoMensual" type="number" min="0" step="1" placeholder="Ej. 30000" required />
			</div>

			<div class="simulador-result">
				<div class="simulador-result-item">
					<span class="simulador-result-label">Ahorro mensual estimado</span>
					<span class="simulador-result-value simulador-result-value--highlight" data-result="ahorroMensual">$0 MXN</span>
				</div>
				<div class="simulador-result-item simulador-result-item--highlight">
					<span class="simulador-result-label">Ahorro anual estimado</span>
					<span class="simulador-result-value" data-result="ahorroAnual">$0 MXN</span>
				</div>
			</div>
		</form>
	</div>
</section>

<style>
	.simulador-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.simulador-copy .section-head {
		margin-bottom: 0;
	}

	.simulador-text {
		margin-top: 1rem;
		color: var(--color-text-60);
		font-size: 1rem;
		max-width: 30rem;
	}

	.simulador-card {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.field label {
		display: block;
		margin-bottom: 0.3rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-60);
	}
	.field input,
	.field select {
		width: 100%;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding: 0.65rem 0.85rem;
		font-size: 0.95rem;
		color: var(--color-text);
		font-family: inherit;
	}
	.field input:focus,
	.field select:focus {
		outline: none;
		border-color: var(--color-red);
	}

	.simulador-result {
		border-top: 1px solid var(--color-border);
		padding-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.simulador-result-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.95rem;
	}
	.simulador-result-label {
		color: var(--color-text-60);
	}
	.simulador-result-value {
		font-weight: 700;
	}
	.simulador-result-item--highlight {
		border-radius: var(--radius-md);
		background: rgba(200, 16, 46, 0.08);
		padding: 0.75rem 1rem;
		margin-top: 0.25rem;
	}
	.simulador-result-value--highlight {
		color: var(--color-red);
		font-size: 1.15rem;
	}

	@media (max-width: 860px) {
		.simulador-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	/* iOS Safari zooms the whole page when a focused control's text is under
	   16px, and there is no way back out except a pinch. */
	@media (max-width: 860px) {
		.field input,
		.field select {
			font-size: 1rem;
		}
	}
</style>

<script define:vars={{ savingsRatesByFuel }} is:inline>
	function formatCurrency(value) {
		return `$${Math.round(value).toLocaleString("es-MX")} MXN`;
	}

	function initSimulador(form) {
		const fuelSelect = form.querySelector("#fuel-actual");
		const gastoMensual = form.querySelector("#gasto-mensual");
		const ahorroMensualEl = form.querySelector('[data-result="ahorroMensual"]');
		const ahorroAnualEl = form.querySelector('[data-result="ahorroAnual"]');

		// Nudge the figure so a recalculation is visible even when the number
		// barely moves. The class has to come off (and the browser has to lay
		// out in between) before it can be re-added, or the keyframe won't replay.
		function pulse(el) {
			el.classList.remove("is-updated");
			void el.offsetWidth;
			el.classList.add("is-updated");
		}

		function recalc() {
			const spend = Number(gastoMensual.value) || 0;
			const rate = savingsRatesByFuel[fuelSelect.value] ?? 0;

			const ahorroMensual = Math.max(spend * rate, 0);
			const ahorroAnual = ahorroMensual * 12;

			const nextMensual = formatCurrency(ahorroMensual);
			const nextAnual = formatCurrency(ahorroAnual);

			if (ahorroMensualEl.textContent !== nextMensual) {
				ahorroMensualEl.textContent = nextMensual;
				pulse(ahorroMensualEl);
			}
			if (ahorroAnualEl.textContent !== nextAnual) {
				ahorroAnualEl.textContent = nextAnual;
				pulse(ahorroAnualEl);
			}
		}

		[fuelSelect, gastoMensual].forEach((input) => input.addEventListener("input", recalc));
		form.addEventListener("submit", (event) => event.preventDefault());
		recalc();
	}

	document.querySelectorAll("[data-simulador]").forEach(initSimulador);
</script>
