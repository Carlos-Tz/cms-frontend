---
import { titleLines } from "../functions/labels";
import { BASE_URL } from "../functions/fetch";
import { fetchGlobals, whatsappHref } from "../functions/globals";

// Field list matches the CMS's generic "lead_capture_form" section (shared
// with gas-gnu's LeadCaptureForm.astro): a set of field keys the admin picks,
// each rendered from this local metadata dictionary.
type ContactFieldType = "text" | "email" | "tel" | "textarea";

const contactFieldMeta: Record<string, { label: string; type: ContactFieldType; placeholder: string; required?: boolean }> = {
	name: { label: "Nombre", type: "text", placeholder: "Tu nombre", required: true },
	email: { label: "Correo electrónico", type: "email", placeholder: "tucorreo@ejemplo.com", required: true },
	phone: { label: "Teléfono", type: "tel", placeholder: "10 dígitos" },
	company: { label: "Empresa", type: "text", placeholder: "Nombre de tu empresa" },
	message: { label: "Mensaje", type: "textarea", placeholder: "Cuéntanos brevemente qué necesitas" },
};

interface Props {
	title?: string | null;
	intro?: string | null;
	submitLabel?: string | null;
	fields: string[];
	whatsappUrl?: string | null;
	formId?: string;
	// Slug of the page holding this form. Travels with the lead as `source`,
	// which the CMS validates against the site published pages and uses to
	// tell one form apart from another in the admin inbox.
	source?: string | null;
}

const { title, intro, submitLabel, fields, whatsappUrl, formId = "contacto-lead-form", source } = Astro.props;

// The WhatsApp number is site-wide data rather than part of this section, so
// it is read from `globals` unless the caller already resolved it.
const globals = await fetchGlobals();
const ctaHref = whatsappUrl ?? whatsappHref(globals?.whatsapp_button);

// The form on its own leaves the column beside it empty, so the site-wide
// contact details go there — same data the footer shows, from `globals`.
const contact = globals?.contact_info;
const contactLines = [
	{ icon: "fa-solid fa-location-dot", label: contact?.address, href: null },
	{
		icon: "fa-solid fa-phone",
		label: contact?.phone,
		href: contact?.phone ? `tel:${contact.phone.replace(/[^\d+]/g, "")}` : null,
	},
	{
		icon: "fa-solid fa-envelope",
		label: contact?.email,
		href: contact?.email ? `mailto:${contact.email}` : null,
	},
	{ icon: "fa-regular fa-clock", label: contact?.schedule, href: null },
	// contact_info.additional_info is part of the same CMS section; the footer
	// already shows it, so the form column should not quietly drop it.
	{ icon: "fa-solid fa-circle-info", label: contact?.additional_info, href: null },
].filter((line) => Boolean(line.label));
---

<section id="contacto" class="section section--dark contacto">
	<div class="container contacto-grid">
		<div class="section-head contacto-copy">
			{title && <h2 class="section-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h2>}
			{intro && <p class="contacto-text">{intro}</p>}

			{ctaHref && (
				<a class="btn-primary contacto-whatsapp" href={ctaHref} target="_blank" rel="noopener noreferrer">
					<i class="fa-brands fa-whatsapp" aria-hidden="true" />
					Escribir por WhatsApp
				</a>
			)}

			{contactLines.length > 0 && (
				<ul class="contacto-info">
					{contactLines.map((line) => (
						<li class="contacto-info-item">
							<span class="icon-chip icon-chip--on-dark" aria-hidden="true">
								<i class={line.icon} />
							</span>
							{line.href ? <a href={line.href}>{line.label}</a> : <span>{line.label}</span>}
						</li>
					))}
				</ul>
			)}
		</div>

		<form class="card contacto-form" id={formId} data-lead-form>
			{fields.map((field) => {
				const meta = contactFieldMeta[field] ?? {
					label: field.charAt(0).toUpperCase() + field.slice(1),
					type: "text" as ContactFieldType,
					placeholder: "",
				};
				return (
					<div class="field">
						<label for={`${formId}-${field}`}>{meta.label}</label>
						{meta.type === "textarea" ? (
							<textarea id={`${formId}-${field}`} name={field} rows="3" placeholder={meta.placeholder} required={meta.required} />
						) : (
							<input type={meta.type} id={`${formId}-${field}`} name={field} placeholder={meta.placeholder} required={meta.required} />
						)}
					</div>
				);
			})}
			<button type="submit" class="btn-primary contacto-submit">{submitLabel}</button>
			<p class="contacto-status" data-lead-status role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.contacto-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.contacto-copy .section-head {
		margin-bottom: 1.5rem;
	}

	.contacto-text {
		margin-top: 1rem;
		color: var(--color-text-on-dark-60);
		max-width: 28rem;
	}

	.contacto-whatsapp {
		margin-top: 1.75rem;
		background: var(--color-whatsapp);
		box-shadow: 0 10px 30px -8px rgba(37, 211, 102, 0.45);
	}

	.contacto-info {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contacto-info-item {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: var(--color-text-on-dark-60);
		font-size: 0.95rem;
	}
	.contacto-info-item a {
		transition: color 0.25s ease;
	}
	.contacto-info-item a:hover {
		color: #fff;
	}

	.contacto-form {
		background: #fff;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.field label {
		display: block;
		margin-bottom: 0.3rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-60);
	}
	.field input,
	.field select,
	.field textarea {
		width: 100%;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding: 0.85rem 1.2rem;
		font-size: 0.95rem;
		color: var(--color-text);
		font-family: inherit;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
	}
	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--color-red);
		background: #fff;
		box-shadow: 0 0 0 4px rgba(200, 16, 46, 0.12);
	}

	/* A pill would clip wrapped lines, so the message box keeps soft corners. */
	.field textarea {
		border-radius: var(--radius-lg);
		resize: vertical;
	}

	.contacto-submit {
		width: 100%;
		justify-content: center;
	}

	.contacto-status {
		font-size: 0.85rem;
		color: var(--color-red);
		min-height: 1.2em;
	}

	@media (max-width: 860px) {
		.contacto-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	/* iOS Safari zooms the whole page when a focused control's text is under
	   16px, and there is no way back out except a pinch. */
	@media (max-width: 860px) {
		.field input,
		.field select,
		.field textarea {
			font-size: 1rem;
		}
	}
</style>

<script define:vars={{ apiBase: BASE_URL, leadFormId: formId, leadSource: source ?? null }} is:inline>
	// Only these four map to real `leads` columns. Anything else this form
	// collects — `company` today, whatever the CMS adds to `fields[]` later —
	// has to travel nested under `details`, which the API whitelists against
	// the source page's own declared fields. Sent flat it is simply ignored.
	const CORE_LEAD_FIELDS = ["name", "email", "phone", "message"];

	const form = document.getElementById(leadFormId);
	const status = form ? form.querySelector("[data-lead-status]") : null;

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const submitButton = form.querySelector('button[type="submit"]');
		const entries = Object.fromEntries(new FormData(form).entries());
		let serverMessage = "";

		const data = leadSource ? { source: leadSource } : {};
		const details = {};
		for (const [key, value] of Object.entries(entries)) {
			if (CORE_LEAD_FIELDS.includes(key)) data[key] = value;
			else details[key] = value;
		}
		if (Object.keys(details).length) data.details = details;

		if (submitButton) submitButton.disabled = true;
		if (status) status.textContent = "Enviando...";

		try {
			const response = await fetch(apiBase + "leads", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					Accept: "application/json",
				},
				body: JSON.stringify(data),
			});
			const result = await response.json().catch(() => null);
			if (!response.ok) {
				// A 422 carries the per-field messages in `errors`, with
				// `message` only summarising them; 429 is the per-IP throttle.
				const firstError = result?.errors ? Object.values(result.errors)[0]?.[0] : null;
				serverMessage =
					response.status === 429
						? "Recibimos demasiados envíos. Espera un momento e intenta de nuevo."
						: firstError || result?.meta?.message || result?.message || "";
				throw new Error("request failed");
			}

			form.reset();
			if (status) status.textContent = result?.meta?.message || "¡Gracias! Un asesor de Traninn Logistic te contactará muy pronto.";
		} catch (error) {
			if (status) status.textContent = serverMessage || "No pudimos enviar tu mensaje. Intenta de nuevo.";
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
