---
import { BASE_URL } from "../functions/fetch";
import { fetchGlobals, whatsappHref } from "../functions/globals";

// Field list matches the CMS's generic "lead_capture_form" section (shared
// with gas-gnu's LeadCaptureForm.astro): a set of field keys the admin picks,
// each rendered from this local metadata dictionary.
type ContactFieldType = "text" | "email" | "tel" | "textarea";

const contactFieldMeta: Record<string, { label: string; type: ContactFieldType; placeholder: string; required?: boolean }> = {
	name: { label: "Nombre", type: "text", placeholder: "Tu nombre", required: true },
	email: { label: "Correo electrónico", type: "email", placeholder: "tucorreo@ejemplo.com", required: true },
	phone: { label: "Teléfono", type: "tel", placeholder: "10 dígitos" },
	company: { label: "Empresa", type: "text", placeholder: "Nombre de tu empresa" },
	message: { label: "Mensaje", type: "textarea", placeholder: "Cuéntanos brevemente qué necesitas" },
};

interface Props {
	title?: string | null;
	intro?: string | null;
	submitLabel?: string | null;
	fields: string[];
	whatsappUrl?: string | null;
	formId?: string;
	// Slug of the page holding this form. Travels with the lead as `source`,
	// which the CMS validates against the site published pages and uses to
	// tell one form apart from another in the admin inbox.
	source?: string | null;
}

const { title, intro, submitLabel, fields, whatsappUrl, formId = "contacto-lead-form", source } = Astro.props;

// The WhatsApp number is site-wide data rather than part of this section, so
// it is read from `globals` unless the caller already resolved it.
const ctaHref = whatsappUrl ?? whatsappHref((await fetchGlobals())?.whatsapp_button);
---

<section id="contacto" class="section section--dark contacto">
	<div class="container contacto-grid">
		<div class="section-head contacto-copy">
			{title && <h2 class="section-title">{title}</h2>}
			{intro && <p class="contacto-text">{intro}</p>}

			{ctaHref && (
				<a class="btn-primary contacto-whatsapp" href={ctaHref} target="_blank" rel="noopener noreferrer">
					Escribir por WhatsApp
				</a>
			)}
		</div>

		<form class="card contacto-form" id={formId} data-lead-form>
			{fields.map((field) => {
				const meta = contactFieldMeta[field] ?? {
					label: field.charAt(0).toUpperCase() + field.slice(1),
					type: "text" as ContactFieldType,
					placeholder: "",
				};
				return (
					<div class="field">
						<label for={`${formId}-${field}`}>{meta.label}</label>
						{meta.type === "textarea" ? (
							<textarea id={`${formId}-${field}`} name={field} rows="3" placeholder={meta.placeholder} required={meta.required} />
						) : (
							<input type={meta.type} id={`${formId}-${field}`} name={field} placeholder={meta.placeholder} required={meta.required} />
						)}
					</div>
				);
			})}
			<button type="submit" class="btn-primary contacto-submit">{submitLabel}</button>
			<p class="contacto-status" data-lead-status role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.contacto-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.contacto-copy .section-head {
		margin-bottom: 1.5rem;
	}

	.contacto-text {
		margin-top: 1rem;
		color: var(--color-text-on-dark-60);
		max-width: 28rem;
	}

	.contacto-whatsapp {
		margin-top: 1.75rem;
		background: var(--color-whatsapp);
		box-shadow: 0 10px 30px -8px rgba(37, 211, 102, 0.45);
	}

	.contacto-form {
		background: #fff;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.field label {
		display: block;
		margin-bottom: 0.3rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-60);
	}
	.field input,
	.field select,
	.field textarea {
		width: 100%;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding: 0.65rem 0.85rem;
		font-size: 0.95rem;
		color: var(--color-text);
		font-family: inherit;
	}
	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--color-red);
	}

	.contacto-submit {
		width: 100%;
		justify-content: center;
	}

	.contacto-status {
		font-size: 0.85rem;
		color: var(--color-red);
		min-height: 1.2em;
	}

	@media (max-width: 860px) {
		.contacto-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	/* iOS Safari zooms the whole page when a focused control's text is under
	   16px, and there is no way back out except a pinch. */
	@media (max-width: 860px) {
		.field input,
		.field select,
		.field textarea {
			font-size: 1rem;
		}
	}
</style>

<script define:vars={{ apiBase: BASE_URL, leadFormId: formId, leadSource: source ?? null }} is:inline>
	const form = document.getElementById(leadFormId);
	const status = form ? form.querySelector("[data-lead-status]") : null;

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const submitButton = form.querySelector('button[type="submit"]');
		const data = Object.fromEntries(new FormData(form).entries());
		let serverMessage = "";

		if (submitButton) submitButton.disabled = true;
		if (status) status.textContent = "Enviando...";

		try {
			const response = await fetch(apiBase + "leads", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					Accept: "application/json",
				},
				// `source` tags the lead with the page it came from.
				body: JSON.stringify(leadSource ? { ...data, source: leadSource } : data),
			});
			const result = await response.json().catch(() => null);
			if (!response.ok) {
				// The CMS answers 422 with a field message and 429 when the
				// per-IP throttle trips; both are worth showing verbatim.
				serverMessage = result?.meta?.message || result?.message || "";
				throw new Error("request failed");
			}

			form.reset();
			if (status) status.textContent = result?.meta?.message || "¡Gracias! Un asesor de Traninn Logistic te contactará muy pronto.";
		} catch (error) {
			if (status) status.textContent = serverMessage || "No pudimos enviar tu mensaje. Intenta de nuevo.";
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
