---
import { titleLines } from "../functions/labels";
// Content shape matches the CMS's "stations_map" section: the section supplies
// only the map framing (title, "lat,lng" center and zoom); the pins themselves
// come from the site-wide "stations" endpoint.
import { fetchData } from "../functions/fetch";

interface Props {
	title?: string | null;
	center?: string | null;
	zoom?: string | number | null;
}

type Station = {
	name: string;
	address: string | null;
	latitude: number;
	longitude: number;
	phone: string | null;
	schedule: string | null;
};
type StationsResponse = { status: string; data: Station[] };

const { title, center, zoom } = Astro.props;

const stationsResponse: StationsResponse | undefined = await fetchData("stations");
const stations = (stationsResponse?.data ?? []).filter(
	(station) => Number.isFinite(Number(station.latitude)) && Number.isFinite(Number(station.longitude))
);

// "19.7028,-101.1920" → [lat, lng]; falls back to the first station.
const parsedCenter = (center ?? "")
	.split(",")
	.map((part) => Number(part.trim()))
	.filter((part) => Number.isFinite(part));
const mapCenter =
	parsedCenter.length === 2
		? parsedCenter
		: stations.length
			? [Number(stations[0].latitude), Number(stations[0].longitude)]
			: null;
const mapZoom = Number(zoom) || 11;

/**
 * Google Maps embed for a coordinate. This keyless form takes lat/lng
 * directly; the documented Maps Embed API cannot, without an API key — and
 * none is configured (.env carries only CMS_API_URL). With a key, swap this
 * for https://www.google.com/maps/embed/v1/place?key=…&q=lat,lng
 */
const embedUrl = (lat: number, lng: number, z: number) =>
	`https://maps.google.com/maps?q=${lat},${lng}&hl=es&z=${z}&output=embed`;

/**
 * Directions straight to the station: this opens Maps with the route panel
 * already pointed at it, rather than just showing the place.
 */
const externalUrl = (lat: number, lng: number) =>
	`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

const points = stations.map((station) => ({
	name: station.name,
	lat: Number(station.latitude),
	lng: Number(station.longitude),
}));

// The embed opens on the first station; with several, the list switches it.
const embedZoom = Math.max(mapZoom, 14);
const initialSrc = points.length
	? embedUrl(points[0].lat, points[0].lng, embedZoom)
	: mapCenter
		? embedUrl(mapCenter[0], mapCenter[1], mapZoom)
		: null;
---

<section id="ubicaciones" class="section stations-map-section">
	<div class="container">
		{title && (
			<div class="section-head">
				<h2 class="section-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h2>
			</div>
		)}

		<div class="stations-grid">
			<div class="stations-list">
				{stations.map((station) => (
					<article class="station-item">
						<span class="station-dot"></span>
						<div>
							<h3 class="station-name">
							{points.length > 1 ? (
								<button
									class="station-switch"
									type="button"
									data-station-switch
									data-src={embedUrl(Number(station.latitude), Number(station.longitude), embedZoom)}
								>
									{station.name}
								</button>
							) : (
								station.name
							)}
						</h3>
							{station.address && (
								<p class="station-line">
									<i class="fa-solid fa-location-dot station-icon" aria-hidden="true" />
									<span>{station.address}</span>
								</p>
							)}
							{station.schedule && (
								<p class="station-line">
									<i class="fa-regular fa-clock station-icon" aria-hidden="true" />
									<span>{station.schedule}</span>
								</p>
							)}
							{station.phone && (
								<p class="station-line">
									<i class="fa-solid fa-phone station-icon" aria-hidden="true" />
									<a href={`tel:${station.phone.replace(/[^\d+]/g, "")}`}>{station.phone}</a>
								</p>
							)}
							
							<a
								class="station-directions"
								href={externalUrl(Number(station.latitude), Number(station.longitude))}
								target="_blank"
								rel="noopener noreferrer"
							>
								<i class="fa-solid fa-diamond-turn-right" aria-hidden="true" />
								Cómo llegar
							</a>
						</div>
					</article>
				))}
			</div>

			{initialSrc && (
				<div class="stations-map">
					<iframe
						data-stations-map
						src={initialSrc}
						title={title ?? "Mapa de ubicaciones"}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
				</div>
			)}
		</div>
	</div>
</section>

{
	points.length > 1 && (
		<script>
			// Clicking a station re-points the embed. One iframe with a swapped
			// src: the keyless Google embed shows a single place at a time.
			document.querySelectorAll<HTMLButtonElement>("[data-station-switch]").forEach((button) => {
				button.addEventListener("click", () => {
					const frame = document.querySelector<HTMLIFrameElement>("[data-stations-map]");
					const src = button.dataset.src;
					if (!frame || !src) return;

					frame.src = src;
					document
						.querySelectorAll("[data-station-switch]")
						.forEach((other) => other.classList.toggle("is-active", other === button));
				});
			});
		</script>
	)
}

<style>
	.stations-grid {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 3rem;
		align-items: start;
	}

	.stations-list {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.station-item {
		display: flex;
		gap: 0.9rem;
	}

	.station-dot {
		flex-shrink: 0;
		margin-top: 0.35rem;
		width: 0.65rem;
		height: 0.65rem;
		border-radius: var(--radius-full);
		background: var(--color-red);
	}

	.station-name {
		font-size: 1.05rem;
	}

	.station-line {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		margin-top: 0.35rem;
		font-size: 0.92rem;
		color: var(--color-text-60);
		line-height: 1.6;
	}
	.station-icon {
		flex-shrink: 0;
		width: 1rem;
		margin-top: 0.35rem;
		font-size: 0.8rem;
		color: var(--color-red);
	}

	/* Opens the location in Google Maps proper, where directions live. */
	.station-directions {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.9rem;
		padding: 0.55rem 1.15rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		font-family: var(--font-title);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-text);
		transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
	}
	.station-directions:hover {
		color: #fff;
		background: var(--color-red);
		border-color: var(--color-red);
	}

	.station-line a:hover {
		color: var(--color-red);
	}

	.stations-map {
		height: 26rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		overflow: hidden;
		background: var(--color-bg-alt);
		z-index: 0;
	}
	/* An iframe with no size attributes falls back to 300×150, which left the
	   map sitting in the corner of its container. */
	.stations-map iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (max-width: 860px) {
		.stations-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.stations-map {
			height: 20rem;
		}
	}
</style>
