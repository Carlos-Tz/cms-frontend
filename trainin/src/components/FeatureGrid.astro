---
import { titleLines, textLines } from "../functions/labels";
// Content shape matches the CMS's "feature_grid" section: an optional title
// plus a list of items, each with an optional icon (a media path or URL).
interface FeatureItem {
	icon?: string | null;
	title: string;
	text?: string | null;
}

interface Props {
	title?: string | null;
	items: FeatureItem[];
}

const { title, items } = Astro.props;

// The CMS sends no icons today, so each card picks a Font Awesome glyph from
// its own title and text. The step number stays as a small corner marker.
const ICON_BY_KEYWORD: [RegExp, string][] = [
	[/certificad|seguro|segurid|protec/i, "fa-shield-halved"],
	[/cobertur|regional|nacional|alcance/i, "fa-earth-americas"],
	[/program|horario|puntual|tiempo/i, "fa-calendar-check"],
	[/ruta|planea|traz/i, "fa-route"],
	[/monitor|tiempo real|seguimiento|rastre/i, "fa-satellite-dish"],
	[/reporte|informe|dato|indicador/i, "fa-chart-line"],
	[/flota|unidad|veh|cami/i, "fa-truck-fast"],
	[/maniobra|carga|tonelaje|peso/i, "fa-truck-ramp-box"],
	[/gas|gnc|combustible|energ/i, "fa-gas-pump"],
	[/almacen|bodega|inventario/i, "fa-warehouse"],
	[/equipo|person|asesor|cliente/i, "fa-people-group"],
];

const iconFor = (item: FeatureItem) => {
	const haystack = `${item.title} ${item.text ?? ""}`;
	return ICON_BY_KEYWORD.find(([pattern]) => pattern.test(haystack))?.[1] ?? "fa-circle-check";
};

const stepLabel = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="section feature-grid-section">
	<div class="container">
		{title && (
			<div class="section-head">
				<h2 class="section-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h2>
			</div>
		)}

		<div class="feature-grid">
			{items.map((item, index) => (
				<article class="card feature-card">
					<span class="feature-step" aria-hidden="true">{stepLabel(index)}</span>

					<div class="feature-badge">
						{item.icon ? (
							<img class="feature-icon" src={item.icon} alt="" />
						) : (
							<i class={`fa-solid ${iconFor(item)}`} aria-hidden="true" />
						)}
					</div>

					<h3 class="feature-title">{item.title}</h3>
					{item.text && <p class="feature-text">{textLines(item.text).map((line) => <span class="text-line">{line}</span>)}</p>}

					<span class="feature-rule" aria-hidden="true"></span>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 1.5rem;
	}

	.feature-card {
		position: relative;
		padding: 2.25rem 1.9rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		overflow: hidden;
	}

	/* A soft wash slides up from the bottom of the card on hover, the way the
	   template's service cards tint behind their content. */
	.feature-card::before {
		content: "";
		position: absolute;
		inset: auto 0 0 0;
		height: 0;
		background: linear-gradient(180deg, rgba(200, 16, 46, 0) 0%, rgba(200, 16, 46, 0.07) 100%);
		transition: height 0.45s var(--ease-out);
		z-index: 0;
	}
	.feature-card:hover::before {
		height: 100%;
	}

	.feature-card > * {
		position: relative;
		z-index: 1;
	}

	.feature-badge {
		width: 4.25rem;
		height: 4.25rem;
		margin-bottom: 0.6rem;
		border-radius: 1.1rem;
		display: grid;
		place-items: center;
		background: var(--color-red);
		color: #fff;
		box-shadow: var(--shadow-cta);
		transition: transform 0.45s var(--ease-out), background 0.3s ease;
	}
	.feature-card:hover .feature-badge {
		transform: translateY(-4px) rotate(-6deg);
		background: var(--color-dark);
	}

	.feature-icon {
		width: 2.1rem;
		height: 2.1rem;
		object-fit: contain;
	}

	.feature-badge i {
		font-size: 1.6rem;
	}

	/* Step number as a watermark in the card corner. Selector includes the
	   card because Astro scopes `.feature-card > *` to a higher specificity. */
	.feature-card .feature-step {
		position: absolute;
		top: 1.1rem;
		right: 1.4rem;
		font-family: var(--font-title);
		font-size: 2.6rem;
		font-weight: 800;
		line-height: 1;
		color: rgba(32, 29, 30, 0.07);
		transition: color 0.4s var(--ease-out);
	}
	.feature-card:hover .feature-step {
		color: rgba(200, 16, 46, 0.16);
	}

	.feature-title {
		font-size: 1.3rem;
		transition: color 0.3s ease;
	}
	.feature-card:hover .feature-title {
		color: var(--color-red);
	}

	.feature-text {
		color: var(--color-text-60);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	/* Accent rule that draws itself in as the card is pointed at. */
	.feature-rule {
		display: block;
		margin-top: auto;
		padding-top: 1.25rem;
		height: 3px;
		width: 100%;
		background: linear-gradient(90deg, var(--color-red) 0%, var(--color-red) 100%) no-repeat left bottom / 0 3px;
		transition: background-size 0.5s var(--ease-out);
	}
	.feature-card:hover .feature-rule {
		background-size: 40% 3px;
	}
</style>
