---
import Logo from "./Logo.astro";
import type { ContactInfo } from "../types/globals";

interface Social {
	label: string;
	href: string;
	path: string;
}

export interface MenuItem {
	slug: string;
	path: string;
	title: string;
	children?: MenuItem[];
}

interface Props {
	// Same CMS menu the header renders, so the columns cannot drift from it.
	menu?: MenuItem[];
	socials?: Social[];
	// Null when the CMS has no WhatsApp number: the CTA is then not rendered
	// at all, rather than pointing at a placeholder.
	whatsappUrl?: string | null;
	// Site-wide contact details from the CMS `globals` endpoint.
	contact?: ContactInfo | null;
}

const fallbackSocials: Social[] = [
	{ label: "facebook", href: "#", path: "M13.5 9H15V6.5h-1.75C11.6 6.5 10.5 7.6 10.5 9.25V11H9v2.5h1.5V19h2.5v-5.5H15l.5-2.5h-2v-1.25c0-.4.1-.75.5-.75Z" },
	{ label: "instagram", href: "#", path: "M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.27a2.47 2.47 0 1 1 0-4.94 2.47 2.47 0 0 1 0 4.94ZM16.2 5H7.8A2.8 2.8 0 0 0 5 7.8v8.4A2.8 2.8 0 0 0 7.8 19h8.4a2.8 2.8 0 0 0 2.8-2.8V7.8A2.8 2.8 0 0 0 16.2 5Zm1.5 11.2c0 .83-.67 1.5-1.5 1.5H7.8c-.83 0-1.5-.67-1.5-1.5V7.8c0-.83.67-1.5 1.5-1.5h8.4c.83 0 1.5.67 1.5 1.5v8.4ZM16.4 7.6a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z" },
	{ label: "linkedin", href: "#", path: "M6.94 8.5H4.56V19h2.38V8.5ZM5.75 4.9a1.38 1.38 0 1 0 0 2.76 1.38 1.38 0 0 0 0-2.76ZM19.44 19h-2.38v-5.37c0-1.28-.46-2.15-1.6-2.15-.87 0-1.39.59-1.62 1.15-.08.2-.1.49-.1.77V19H11.4s.03-9.44 0-10.5h2.34v1.49c.31-.48 .87-1.16 2.12-1.16 1.55 0 2.71 1.01 2.71 3.18V19Z" },
];

const { menu, socials = fallbackSocials, whatsappUrl = null, contact } = Astro.props;

// One column per menu entry that has sub-pages; its own path heads the list so
// the parent page stays reachable. Entries without children (Inicio,
// Ubicaciones, Contacto) already sit in the header and are not repeated.
const columnas = (menu ?? [])
	.filter((item) => item.children?.length)
	.map((item) => ({
		title: item.title,
		links: [
			{ label: `Ver ${item.title.toLowerCase()}`, href: item.path },
			...(item.children ?? []).map((child) => ({ label: child.title, href: child.path })),
		],
	}));

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<Logo onDark />
			<p class="footer-text">Transporte de GNC, logística y carga pesada con cobertura nacional.</p>
			<div class="socials">
				{socials.map((s) => (
					<a href={s.href} aria-label={s.label} class="social-icon">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={s.path}></path></svg>
					</a>
				))}
			</div>
		</div>

		{columnas.map((columna) => (
			<div class="footer-col">
				<h3 class="footer-col-title">{columna.title}</h3>
				<ul>
					{columna.links.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>
		))}

		<div class="footer-col">
			<h3 class="footer-col-title">Contacto</h3>
			<ul>
				{contact?.address && (
					<li class="footer-contact-text">
						<i class="fa-solid fa-location-dot footer-icon" aria-hidden="true" />
						<span>{contact.address}</span>
					</li>
				)}
				{contact?.email && (
					<li>
						<a href={`mailto:${contact.email}`}>
							<i class="fa-solid fa-envelope footer-icon" aria-hidden="true" />
							<span>{contact.email}</span>
						</a>
					</li>
				)}
				{contact?.phone && (
					<li>
						<a href={`tel:${contact.phone.replace(/\s/g, "")}`}>
							<i class="fa-solid fa-phone footer-icon" aria-hidden="true" />
							<span>{contact.phone}</span>
						</a>
					</li>
				)}
				{contact?.schedule && (
					<li class="footer-contact-text">
						<i class="fa-regular fa-clock footer-icon" aria-hidden="true" />
						<span>{contact.schedule}</span>
					</li>
				)}
				{contact?.additional_info && (
					<li class="footer-contact-text">
						<i class="fa-solid fa-circle-info footer-icon" aria-hidden="true" />
						<span>{contact.additional_info}</span>
					</li>
				)}
				{whatsappUrl && (
					<li>
						<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
							<i class="fa-brands fa-whatsapp footer-icon" aria-hidden="true" />
							<span>WhatsApp directo</span>
						</a>
					</li>
				)}
			</ul>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>© {year} Traninn Logistic. Todos los derechos reservados.</p>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--color-dark);
		color: var(--color-text-on-dark-60);
		padding-top: 4rem;
	}
	.site-footer::before {
		content: "";
		position: absolute;
		inset: -40% 60% 40% -20%;
		z-index: -1;
		background: linear-gradient(115deg, rgba(200, 16, 46, 0.35) 0%, rgba(200, 16, 46, 0) 70%);
		transform: skewX(-14deg);
		pointer-events: none;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 2rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border-on-dark);
	}


	.footer-text {
		margin-top: 0.85rem;
		font-size: 0.9rem;
		max-width: 20rem;
	}

	.socials {
		display: flex;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}
	.social-icon {
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border-on-dark);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.social-icon:hover {
		background: var(--color-red);
		border-color: var(--color-red);
	}

	.footer-col-title {
		font-family: var(--font-title);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #fff;
		margin-bottom: 1rem;
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.9rem;
	}
	/* A 0.9rem line measures ~20px tall, under the 24 CSS-px minimum target size
	   (WCAG 2.5.8). The padding makes up the difference and replaces most of the
	   list gap, so the column's rhythm is unchanged. */
	.footer-col a,
	.footer-contact-text {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 0.35rem 0;
	}

	.footer-icon {
		flex-shrink: 0;
		width: 1rem;
		margin-top: 0.45rem;
		font-size: 0.8rem;
		color: var(--color-red);
	}
	.footer-col a {
		position: relative;
		width: fit-content;
		transition: color 0.25s ease, transform 0.25s var(--ease-out);
	}
	.footer-col a::before {
		content: "";
		position: absolute;
		left: -0.9rem;
		top: 50%;
		width: 0.4rem;
		height: 1px;
		background: var(--color-red);
		opacity: 0;
		transition: opacity 0.25s ease, width 0.25s var(--ease-out);
	}
	.footer-col a:hover {
		color: #fff;
		transform: translateX(0.55rem);
	}
	.footer-col a:hover::before {
		opacity: 1;
		width: 0.7rem;
	}
	/* Contact details that aren't links (address, schedule) */
	.footer-contact-text {
		color: var(--color-text-on-dark-60);
	}

	.footer-bottom {
		padding: 1.5rem 1.5rem;
		font-size: 0.8rem;
		color: var(--color-text-40, rgba(255, 255, 255, 0.4));
	}

	@media (max-width: 860px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
