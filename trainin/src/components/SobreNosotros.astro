---
import noimg from "../../assets/images/noimg.jpg";

const bloques = [
	{
		title: "¿Qué hacemos?",
		text: "Transportamos gas natural vehicular, mercancía y carga pesada para empresas que necesitan un aliado logístico confiable en todo el país.",
	},
	{
		title: "Propósito empresarial",
		text: "Impulsar la transición energética del transporte de carga, ofreciendo alternativas más limpias y eficientes que la operación diésel tradicional.",
	},
	{
		title: "Nuestra historia",
		text: "Nacimos de la unión entre experiencia en logística pesada y la visión de un transporte más sustentable, creciendo junto con nuestros clientes.",
	},
];
---

<section id="nosotros" class="section nosotros">
	<div class="container nosotros-grid">
		<div class="nosotros-image">
			<img src={noimg.src} alt="Equipo Traninn Logistic" />
		</div>

		<div class="nosotros-content">
			<div class="section-head">
				<span class="eyebrow">Sobre nosotros</span>
				<h2 class="section-title">Un equipo enfocado en <span class="accent">mover tu operación</span></h2>
			</div>

			<div class="nosotros-blocks">
				{bloques.map((bloque) => (
					<div class="nosotros-block">
						<h3 class="nosotros-block-title">{bloque.title}</h3>
						<p class="nosotros-block-text">{bloque.text}</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.nosotros-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 3rem;
		align-items: center;
	}

	.nosotros-image {
		border-radius: var(--radius-lg);
		overflow: hidden;
		aspect-ratio: 4 / 5;
	}
	.nosotros-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.nosotros-content .section-head {
		margin-bottom: 2rem;
	}

	.nosotros-blocks {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.nosotros-block {
		border-left: 3px solid var(--color-red);
		padding-left: 1.1rem;
	}
	.nosotros-block-title {
		font-size: 1.05rem;
		color: var(--color-dark);
	}
	.nosotros-block-text {
		margin-top: 0.4rem;
		color: var(--color-text-60);
		font-size: 0.92rem;
	}

	@media (max-width: 860px) {
		.nosotros-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
