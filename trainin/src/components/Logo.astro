---
// The site's single logo source. Header and Footer both render this, so the
// brand mark is swapped in one place.
//
// The artwork is a finished lockup — monogram plus the TRANINN LOGISTIC
// wordmark — so the component draws no type of its own. `markOnly` falls back
// to the bare TL monogram, which is also the favicon.
//
// The dark-background lockup is supplied artwork (white monogram, red
// wordmark), not a generated knockout. The monogram's own dark variant is
// still generated from logo.png — see technical_debt.md.
const ART = {
	lockup: { light: "/logo-lockup.png", dark: "/logo-lockup-dark-bg.png", width: 603, height: 183 },
	mark: { light: "/logo.png", dark: "/logo-white.png", width: 421, height: 367 },
};

interface Props {
	// The footer sits on the dark band, where the knockout artwork is used.
	onDark?: boolean;
	// The header's logo links home; the footer's does not.
	href?: string | null;
	// The symbol alone, without the wordmark.
	markOnly?: boolean;
	// Rendered height of the artwork.
	height?: string;
}

const { onDark = false, href = null, markOnly = false, height } = Astro.props;

const art = markOnly ? ART.mark : ART.lockup;
const src = onDark ? art.dark : art.light;
// The lockup is wide and low; the monogram is nearly square, so it needs less
// height to read at the same visual weight.
const renderedHeight = height ?? (markOnly ? "2.4rem" : "2.6rem");

const Tag = href ? "a" : "div";
---

<Tag
	class:list={["logo", { "logo--on-dark": onDark }]}
	href={href ?? undefined}
	aria-label={href ? "Traninn Logistic — Inicio" : undefined}
>
	{/* The size is inline as well as in the stylesheet: the width/height
	    attributes are the artwork's natural size, so until this component's CSS
	    applies the browser would paint the logo at full size across the page. */}
	<img
		class="logo-img"
		src={src}
		alt="Traninn Logistic"
		width={art.width}
		height={art.height}
		style={`height: ${renderedHeight}; width: auto;`}
	/>
</Tag>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
	}

	.logo-img {
		width: auto;
		object-fit: contain;
		transition: transform 0.4s var(--ease-out);
	}
	.logo:hover .logo-img {
		transform: scale(1.04);
	}

	@media (max-width: 420px) {
		.logo-img {
			height: 2.1rem !important;
		}
	}
</style>
