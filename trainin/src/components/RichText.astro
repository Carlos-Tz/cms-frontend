---
import { titleLines } from "../functions/labels";
// Content shape matches the CMS's generic "rich_text" section (shared with
// gas-gnu's RichText.astro): a title, an HTML body, and an optional video.
// Used on any page, so it carries no page-specific copy or id.
interface Props {
	title?: string | null;
	body: string;
	videoUrl?: string | null;
	image?: string | null;
	// rich_text.image_video_url — the poster frame for `videoUrl`. With one,
	// the video renders as a click-to-play still instead of loading (and
	// autoplaying) a third-party iframe on arrival.
	poster?: string | null;
	id?: string;
}

const { title, body, videoUrl, image, poster, id } = Astro.props;

function toEmbedUrl(url: string) {
	try {
		const parsed = new URL(url);
		const host = parsed.hostname.replace(/^www\./, "");

		if (host === "youtube.com" || host === "m.youtube.com") {
			if (parsed.pathname === "/watch") {
				const videoId = parsed.searchParams.get("v");
				if (videoId) return `https://www.youtube.com/embed/${videoId}`;
			}
			if (parsed.pathname.startsWith("/embed/")) return url;
			if (parsed.pathname.startsWith("/shorts/")) {
				return `https://www.youtube.com/embed/${parsed.pathname.split("/")[2]}`;
			}
		}

		if (host === "youtu.be") {
			return `https://www.youtube.com/embed/${parsed.pathname.slice(1)}`;
		}

		if (host === "vimeo.com") {
			return `https://player.vimeo.com/video/${parsed.pathname.slice(1)}`;
		}

		if (host === "player.vimeo.com") return url;

		return url;
	} catch {
		return url;
	}
}

// Autoplay is opt-in per player and browsers only honor it while the video is
// muted, so ask for both through the embed's own query params.
function withAutoplay(url: string) {
	try {
		const parsed = new URL(url);
		const host = parsed.hostname.replace(/^www\./, "");

		if (host === "youtube.com" || host === "youtube-nocookie.com") {
			parsed.searchParams.set("autoplay", "1");
			parsed.searchParams.set("mute", "1");
			parsed.searchParams.set("playsinline", "1");
			return parsed.toString();
		}

		if (host === "player.vimeo.com") {
			parsed.searchParams.set("autoplay", "1");
			parsed.searchParams.set("muted", "1");
			return parsed.toString();
		}

		return url;
	} catch {
		return url;
	}
}

const embedUrl = videoUrl ? withAutoplay(toEmbedUrl(videoUrl)) : null;

// A poster with no video of its own is just an image for the side column.
const sideImage = image ?? (!embedUrl ? poster : null) ?? null;
---

<section id={id} class="section rich-text">
	<div class:list={["container", "rich-text-grid", { "rich-text-grid--single": !sideImage }]}>
		{sideImage && (
			<div class="rich-text-image">
				<img src={sideImage} alt={title ?? ""} />
			</div>
		)}

		<div class="rich-text-content">
			{title && (
				<div class="section-head">
					<h2 class="section-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h2>
				</div>
			)}

			<div class="prose" set:html={body} />

			{embedUrl && (
				<div class="rich-text-video">
					{poster ? (
						<button
							class="rich-text-video-facade"
							type="button"
							data-video-facade
							data-embed={embedUrl}
							data-title={title ?? "Video"}
							aria-label="Reproducir video"
						>
							<img src={poster} alt="" loading="lazy" />
							<span class="rich-text-video-play" aria-hidden="true">
								<i class="fa-solid fa-play" />
							</span>
						</button>
					) : (
						<iframe
							src={embedUrl}
							title={title ?? "Video"}
							loading="lazy"
							allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
							allowfullscreen
						></iframe>
					)}
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.rich-text-grid {
		display: grid;
		/* Copy on the left; the artwork takes the slightly larger share,
		   because width is what a wide picture needs. */
		grid-template-columns: 1fr 1.15fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}
	/* Without an image the body would otherwise sit in a half-width column. */
	.rich-text-grid--single {
		grid-template-columns: 1fr;
		max-width: 48rem;
	}

	/* The frame matches the height of the copy beside it, whatever shape the
	   artwork is: no fixed ratio, so a 16:9, a 2:1 or an ultra-wide all fill
	   the same column. The min-height keeps it from collapsing when the copy
	   is short. */
	.rich-text-image {
		order: 2;
		align-self: stretch;
		min-height: clamp(16rem, 26vw, 26rem);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-bg-alt);
	}
	/* Cover, not contain: filling the frame matters more than showing every
	   edge of the picture, so wide artwork is cropped at the sides. */
	.rich-text-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.rich-text-content .section-head {
		margin-bottom: 1.5rem;
	}

	@media (max-width: 860px) {
		.rich-text-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.rich-text-image {
			order: 0;
			min-height: 0;
			aspect-ratio: 16 / 10;
		}
	}
</style>

<style is:global>
	/* Shared prose styles for CMS-authored HTML ("rich_text" sections) */
	.prose {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-text-60);
		/* Justified body copy; hyphenation (the page is lang="es") keeps the
		   spacing from opening rivers on narrow columns. */
		text-align: justify;
		hyphens: auto;
		-webkit-hyphens: auto;
	}
	.prose :is(h1, h2, h3, h4) {
		font-family: var(--font-title);
		font-weight: 600;
		text-align: left;
		hyphens: manual;
		-webkit-hyphens: manual;
	}
	/* A CMS body may open with an <h1> or turn a corner with one partway
	   through. Opening it is just a heading; arriving mid-article it is a
	   chapter break, and only that case gets the treatment below. */
	.prose h1 {
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-dark);
		text-wrap: balance;
	}

	/* Chapter break: a hairline across the column, tipped with brand red,
	   and air on both sides so the article visibly changes subject. */
	.prose h1:not(:first-child) {
		position: relative;
		margin-top: 3.5rem;
		padding-top: 2.25rem;
		border-top: 1px solid var(--color-border);
	}
	.prose h1:not(:first-child)::before {
		content: "";
		position: absolute;
		top: -2px;
		left: 0;
		width: 3.5rem;
		height: 3px;
		border-radius: var(--radius-full);
		background: var(--color-red);
	}
	.prose h1:not(:first-child) + * {
		margin-top: 1.25rem;
	}

	/* Cards written inside a CMS body:
	       <div class="card"><div class="tittle">…</div><p>…</p></div>
	   "card" is a site-wide class (border, radius, shadow) that brings no
	   padding of its own, so an authored one needs finishing here. The
	   article becomes a grid only when it holds cards: they sit two-up while
	   the prose around them keeps the full column. */
	.prose article:has(> .card) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 1.25rem;
	}
	.prose article:has(> .card) > :not(.card) {
		grid-column: 1 / -1;
	}
	/* The grid's gap already spaces the prose; keep the flow margins from
	   stacking on top of it. */
	.prose article:has(> .card) > p + p {
		margin-top: 0;
	}

	.prose article.is-measuring {
		align-items: start;
	}
	.prose article.is-measuring > .card {
		min-height: 0;
	}

	.prose .card {
		/* Set by the script below to the tallest card in the grid: CSS alone
		   only evens out cards that share a row. */
		min-height: var(--card-height, auto);
		padding: 1.5rem 1.6rem;
		text-align: left;
		hyphens: manual;
		-webkit-hyphens: manual;
	}
	/* "tittle" is the editor's spelling; accept the correct one too. */
	.prose .card :is(.tittle, .title) {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin-bottom: 0.55rem;
		font-family: var(--font-title);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-dark);
	}
	.prose .card :is(.tittle, .title)::before {
		content: "";
		flex-shrink: 0;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: var(--radius-full);
		background: var(--color-red);
	}
	.prose .card p {
		margin: 0;
		font-size: 0.95rem;
	}

	.prose :is(h2, h3) {
		margin-top: 1.5rem;
		color: var(--color-dark);
	}
	.prose p + p {
		margin-top: 1rem;
	}
	.prose a {
		color: var(--color-red);
		text-decoration: underline;
	}

	.rich-text-video {
		margin-top: 1.5rem;
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-dark);
	}
	.rich-text-video-facade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		cursor: pointer;
		background: var(--color-dark);
		display: block;
	}
	.rich-text-video-facade img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease-out), opacity 0.3s ease;
	}
	.rich-text-video-facade:hover img {
		transform: scale(1.04);
		opacity: 0.85;
	}
	.rich-text-video-play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: var(--radius-full);
		background: var(--color-red);
		color: #fff;
		font-size: 1.4rem;
		padding-left: 0.2rem;
		box-shadow: var(--shadow-cta);
		transition: transform 0.3s var(--ease-out);
	}
	.rich-text-video-facade:hover .rich-text-video-play {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.rich-text-video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: none;
	}
	/* CMS-authored rich text can carry anything an editor pastes. A wide table or
	   an <iframe> embed would otherwise push the whole page sideways on a phone,
	   so each is made to scroll or shrink inside the column instead. */
	.prose :is(table, pre) {
	  display: block;
	  max-width: 100%;
	  overflow-x: auto;
	}

	.prose :is(img, iframe, video, embed, object) {
	  max-width: 100%;
	}
</style>

<script>
	// The poster is a facade: the embed (already carrying autoplay params) is
	// only created once someone asks for it, so a page with a video does not
	// pull a third-party player on load.
	document.querySelectorAll("[data-video-facade]").forEach((facade) => {
		facade.addEventListener("click", () => {
			const embed = facade.getAttribute("data-embed");
			if (!embed) return;

			const iframe = document.createElement("iframe");
			iframe.src = embed;
			iframe.title = facade.getAttribute("data-title") ?? "Video";
			iframe.allow = "autoplay; fullscreen; encrypted-media; picture-in-picture";
			iframe.allowFullscreen = true;

			facade.replaceWith(iframe);
		});
	});
</script>

<script>
	// Authored cards (<div class="card"> inside a CMS body) all take the
	// height of the tallest one. Grid stretches cards that share a row, but
	// nothing in CSS matches heights ACROSS rows, and the article's rows hold
	// prose as well as cards, so grid-auto-rows: 1fr would stretch those too.
	function equalizeCards(article: HTMLElement) {
		const cards = Array.from(article.querySelectorAll<HTMLElement>(":scope > .card"));
		if (cards.length < 2) return;

		// Measure natural heights: with the forced height still applied every
		// card reports the same number and the tallest can never shrink back.
		article.classList.add("is-measuring");

		// A card filling the row is one-per-row (phones): nothing to match.
		const stacked = cards[0].getBoundingClientRect().width > article.clientWidth * 0.9;
		const tallest = stacked
			? 0
			: Math.max(...cards.map((card) => card.getBoundingClientRect().height));

		article.classList.remove("is-measuring");
		article.style.setProperty("--card-height", tallest ? `${Math.ceil(tallest)}px` : "auto");
	}

	const articles = Array.from(document.querySelectorAll<HTMLElement>(".prose article")).filter(
		(article) => article.querySelector(":scope > .card")
	);

	if (articles.length) {
		const run = () => articles.forEach(equalizeCards);
		// After layout settles — the cards enter with a staggered reveal.
		requestAnimationFrame(run);
		// Web fonts change the line count, and so the height.
		document.fonts?.ready.then(run);
		window.addEventListener("resize", run);
	}
</script>
