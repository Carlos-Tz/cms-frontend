---
// Renders a CMS page's "sections" array: each section's `type` picks a
// component, and sections render in the order the API returns them. Unknown
// types are skipped, so a new CMS section type never breaks a page.
import Hero from "./Hero.astro";
import PageHero from "./PageHero.astro";
// Kept for the hidden savings_simulator case further down.
// import Simulador from "./Simulador.astro";
import RichText from "./RichText.astro";
import FeatureGrid from "./FeatureGrid.astro";
import ImageGallery from "./ImageGallery.astro";
import StationsMap from "./StationsMap.astro";
import Marquee from "./Marquee.astro";
import Clientes from "./Clientes.astro";
import Contacto from "./Contacto.astro";
import { mediaUrl } from "../functions/fetch";

type Slide = {
	image: string;
	title: string;
	subtitle: string | null;
	link_url: string | null;
	link_label: string | null;
};
// type FuelPrice = { fuel; label; price_per_unit; unit; equivalence_factor }
//   — only used by the hidden savings_simulator case.
type Logo = {
	name: string;
	image: string;
	url: string | null;
	description?: string | null;
	quote?: string | null;
	quote_author?: string | null;
};
type GalleryImage = { image: string; caption: string | null; alt: string | null };
type FeatureItem = { icon: string | null; title: string; text: string | null };

type BannerCarousel = { slides?: Slide[] };
type PageHeroContent = { title?: string | null; subtitle?: string | null; image?: string | null };
// type SavingsSimulator = { title?: string; intro?: string; fuel_prices?: FuelPrice[] };
type RichTextContent = {
	title: string | null;
	body: string;
	video_url: string | null;
	// Poster frame for video_url; a media path despite the `_url` name.
	image_video_url?: string | null;
};
type FeatureGridContent = { title?: string | null; items?: FeatureItem[] };
type ImageGalleryContent = { title?: string | null; images?: GalleryImage[] };
type StationsMapContent = { title?: string | null; center?: string | null; zoom?: string | number | null };
type ClientsShowcase = { title?: string | null; logos?: Logo[] };
type LeadCaptureForm = { title?: string; intro?: string; submit_label?: string; fields?: string[] };

export type PageSection = { type: string; content: Record<string, any> };

interface Props {
	sections: PageSection[];
	// Slug of the page being rendered, forwarded to sections that need to know
	// where they live (the lead form tags its submissions with it).
	slug?: string;
}

const { sections, slug } = Astro.props;

// Full-bleed banners own their background and sit outside the zebra; every
// other section is wrapped in a band that alternates plain / tinted down the
// page, so the rhythm holds whatever mix of sections the CMS returns.
const FULL_BLEED = new Set(["banner_carousel", "page_hero"]);
// Section types the site does not render at all. They must not take a turn in
// the zebra either, or hiding one would flip every band below it.
const HIDDEN = new Set(["savings_simulator"]);
let bandIndex = 0;
const bandTint: (boolean | null)[] = sections.map((section) =>
	FULL_BLEED.has(section.type) || HIDDEN.has(section.type) ? null : bandIndex++ % 2 === 1
);
---

{
	sections.map((section, index) => {
		const tint = bandTint[index];

		const rendered = (() => {
			switch (section.type) {
			case "banner_carousel": {
				const { slides = [] } = section.content as BannerCarousel;
				if (!slides.length) return null;

				const hero = (
					<Hero
						slides={slides.map((slide) => ({ ...slide, image: mediaUrl(slide.image) }))}
						compact={index > 0}
					/>
				);

				// The keyword band belongs directly under a full-height opening
				// banner, the way the reference template places it.
				return index === 0 ? (
					<>
						{hero}
						<Marquee />
					</>
				) : (
					hero
				);
			}

			case "page_hero": {
				const { title, subtitle, image } = section.content as PageHeroContent;
				return title ? <PageHero title={title} subtitle={subtitle} image={image ? mediaUrl(image) : null} /> : null;
			}

			// Hidden site-wide by request: the CMS still serves the section and
			// Simulador.astro is still here, so restoring it is a matter of
			// returning the component below instead of null.
			case "savings_simulator":
				return null;

			case "rich_text": {
				const { title, body, video_url, image_video_url } = section.content as RichTextContent;
				return (
					<RichText
						title={title}
						body={body ?? ""}
						videoUrl={video_url}
						poster={image_video_url ? mediaUrl(image_video_url) : null}
					/>
				);
			}

			case "feature_grid": {
				const { title, items = [] } = section.content as FeatureGridContent;
				return items.length ? (
					<FeatureGrid
						title={title}
						items={items.map((item) => ({ ...item, icon: item.icon ? mediaUrl(item.icon) : null }))}
					/>
				) : null;
			}

			case "image_gallery": {
				const { title, images = [] } = section.content as ImageGalleryContent;
				return images.length ? (
					<ImageGallery title={title} images={images.map((item) => ({ ...item, image: mediaUrl(item.image) }))} />
				) : null;
			}

			case "stations_map": {
				const { title, center, zoom } = section.content as StationsMapContent;
				return <StationsMap title={title} center={center} zoom={zoom} />;
			}

			case "clients_showcase": {
				const { title, logos = [] } = section.content as ClientsShowcase;
				return logos.length ? (
					<Clientes title={title} logos={logos.map((logo) => ({ ...logo, image: mediaUrl(logo.image) }))} />
				) : null;
			}

			case "lead_capture_form": {
				const { title, intro, submit_label, fields = [] } = section.content as LeadCaptureForm;
				return (
					<Contacto title={title} intro={intro} submitLabel={submit_label} fields={fields} source={slug} />
				);
			}

				default:
					return null;
			}
		})();

		if (!rendered) return null;
		if (tint === null) return rendered;

		return <div class:list={["band", { "band--tint": tint }]}>{rendered}</div>;
	})
}
