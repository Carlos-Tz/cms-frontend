---
import { titleLines } from "../functions/labels";
// Content shape matches the CMS's "image_gallery" section: an optional title
// plus a list of images, each with an optional caption and alt text.
interface GalleryImage {
	image: string;
	caption?: string | null;
	alt?: string | null;
}

interface Props {
	title?: string | null;
	images: GalleryImage[];
}

const { title, images } = Astro.props;

/**
 * Captions are authored as "Título: descripción" (see the values on
 * /sobre-nosotros/proposito-empresarial), so the part before the first colon
 * becomes the card heading and the rest its body. A caption with no colon is
 * all heading — that is how /sobre-nosotros/que-hacemos writes them.
 *
 * Runs of whitespace are collapsed: the CMS copy was pasted with the line
 * breaks still in it.
 */
function splitCaption(caption: string | null | undefined) {
	const clean = (caption ?? "").replace(/\s+/g, " ").trim();
	if (!clean) return { heading: null, body: null };

	const colon = clean.indexOf(":");
	if (colon === -1) return { heading: clean, body: null };

	return {
		heading: clean.slice(0, colon).trim() || null,
		body: clean.slice(colon + 1).trim() || null,
	};
}

const cards = images.map((item) => ({ ...item, ...splitCaption(item.caption) }));
---

<section class="section image-gallery-section">
	<div class="container">
		{title && (
			<div class="section-head">
				<h2 class="section-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h2>
			</div>
		)}

		<div class="gallery-grid">
			{cards.map((item) => (
				<figure class="gallery-item">
					<div class="gallery-media shine">
						<img src={item.image} alt={item.alt ?? item.heading ?? ""} loading="lazy" />
					</div>

					{(item.heading || item.body) && (
						<figcaption class="gallery-panel">
							{item.heading && <h3 class="gallery-heading">{item.heading}</h3>}
							{item.body && <p class="gallery-text">{item.body}</p>}
						</figcaption>
					)}
				</figure>
			))}
		</div>
	</div>
</section>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: clamp(1.5rem, 3vw, 2.25rem);
	}

	.gallery-item {
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.gallery-media {
		position: relative;
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--color-bg-alt);
	}
	.gallery-media img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 0.6s var(--ease-out);
	}
	.gallery-item:hover .gallery-media img {
		transform: scale(1.05);
	}

	/* The copy sits on a panel that rides up over the foot of the image, so
	   the two read as one card rather than a picture with a label under it. */
	.gallery-panel {
		position: relative;
		z-index: 2;
		flex: 1;
		margin: -3rem 1rem 0;
		padding: 1.4rem 1.5rem 1.5rem;
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		box-shadow: var(--shadow-card);
		transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
	}
	.gallery-item:hover .gallery-panel {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card-hover);
	}

	.gallery-heading {
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-dark);
	}

	.gallery-text {
		margin-top: 0.5rem;
		font-size: 0.95rem;
		line-height: 1.7;
		color: var(--color-text-60);
		text-wrap: pretty;
	}

	@media (max-width: 560px) {
		.gallery-panel {
			margin: -2.25rem 0.75rem 0;
			padding: 1.2rem 1.25rem 1.3rem;
		}
	}
</style>
