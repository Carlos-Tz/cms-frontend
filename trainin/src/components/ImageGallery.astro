---
import { titleLines } from "../functions/labels";
// Content shape matches the CMS's "image_gallery" section: an optional title
// plus a list of images, each with an optional caption and alt text.
interface GalleryImage {
	image: string;
	caption?: string | null;
	alt?: string | null;
}

interface Props {
	title?: string | null;
	images: GalleryImage[];
}

const { title, images } = Astro.props;
---

<section class="section image-gallery-section">
	<div class="container">
		{title && (
			<div class="section-head">
				<h2 class="section-title">{titleLines(title).map((line) => <span class="title-line">{line}</span>)}</h2>
			</div>
		)}

		<div class="gallery-grid">
			{images.map((item) => (
				<figure class="gallery-item shine">
					<img src={item.image} alt={item.alt ?? item.caption ?? ""} loading="lazy" />
					{item.caption && <figcaption class="gallery-caption">{item.caption}</figcaption>}
				</figure>
			))}
		</div>
	</div>
</section>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 1.5rem;
	}

	.gallery-item {
		position: relative;
		margin: 0;
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--color-bg-alt);
	}

	.gallery-item img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}

	/* The caption rides over the foot of the image and lifts into place on
	   hover, instead of adding a band under every tile. */
	.gallery-caption {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 3;
		padding: 2.5rem 1.15rem 1.1rem;
		font-family: var(--font-title);
		font-size: 0.95rem;
		font-weight: 500;
		color: #fff;
		background: linear-gradient(180deg, rgba(32, 29, 30, 0) 0%, rgba(32, 29, 30, 0.85) 100%);
		transform: translateY(0.5rem);
		opacity: 0;
		transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
	}
	.gallery-item:hover .gallery-caption,
	.gallery-item:focus-within .gallery-caption {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-caption {
			opacity: 1;
			transform: none;
		}
	}
</style>
