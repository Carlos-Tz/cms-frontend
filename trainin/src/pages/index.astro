---
import Layout from "../layouts/Layout.astro";
import PageSections from "../components/PageSections.astro";
import { fetchData } from "../functions/fetch";

type PageResponse = {
  status: string;
  data: { slug: string; path: string; title: string; sections: { type: string; content: Record<string, any> }[] };
  meta: Record<string, any>;
};

// Site "traninn-logistic", page "inicio" — see gnu-cms-admin for the editor.
// Every section on this page comes from the CMS; nothing is hardcoded here.
const pageResponse: PageResponse | undefined = await fetchData("pages/inicio");
const sections = pageResponse?.data?.sections ?? [];
---

<Layout>
  <PageSections sections={sections} slug={pageResponse?.data?.slug} />
</Layout>
