---
import Layout from "../../layouts/Layout.astro";
import PageSections from "../../components/PageSections.astro";
import ChildPageCards from "../../components/ChildPageCards.astro";
import { fetchData } from "../../functions/fetch";
import { pageTitle } from "../../functions/labels";

type PageResponse = {
  status: string;
  data: { slug: string; path: string; title: string; sections: { type: string; content: Record<string, any> }[] };
  meta: Record<string, any>;
};

// Site "traninn-logistic", page "sobre-nosotros" (CMS path /sobre-nosotros).
const pageResponse: PageResponse | undefined = await fetchData("pages/sobre-nosotros");
const page = pageResponse?.data;
const sections = page?.sections ?? [];
---

<Layout title={pageTitle(page?.slug, page?.title ?? "")}>
  <PageSections sections={sections} slug={page?.slug} />
  {/* Follows the one remaining banded section (rich_text), which is plain. */}
  <ChildPageCards title="Conoce Traninn Logistic" />
</Layout>
