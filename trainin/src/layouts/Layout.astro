---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { fetchData } from "../functions/fetch";
import type { GlobalsResponse } from "../types/globals";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Traninn Logistic — Transporte de GNC, logística y carga pesada",
	description = "Traninn Logistic: transporte de gas natural vehicular (GNC), logística y carga pesada con cobertura nacional.",
} = Astro.props;

type MenuItem = { slug: string; path: string; title: string; children?: MenuItem[] };
type MenuResponse = { status: string; data: MenuItem[] };

const menuResponse: MenuResponse | undefined = await fetchData("menu");
const menuItems = menuResponse?.data ?? [];

// Contact details, social links and the WhatsApp number are edited once in the
// CMS admin (Datos de contacto / Redes sociales / Botón de WhatsApp) and shared
// by every page, so they come from the site-wide `globals` endpoint. This
// layout wraps every page, so it fetches them here rather than relying on each
// page to pass them down — same approach as gas-gnu's Layout.astro.
const globalsResponse: GlobalsResponse | undefined = await fetchData("globals");
const globals = globalsResponse?.data;

const contactInfo = globals?.contact_info;
const socialIcons = globals?.social_icons;
const whatsappButton = globals?.whatsapp_button;

const SOCIAL_ICON_PATHS: Record<string, string> = {
	facebook: "M13.5 9H15V6.5h-1.75C11.6 6.5 10.5 7.6 10.5 9.25V11H9v2.5h1.5V19h2.5v-5.5H15l.5-2.5h-2v-1.25c0-.4.1-.75.5-.75Z",
	instagram:
		"M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.27a2.47 2.47 0 1 1 0-4.94 2.47 2.47 0 0 1 0 4.94ZM16.2 5H7.8A2.8 2.8 0 0 0 5 7.8v8.4A2.8 2.8 0 0 0 7.8 19h8.4a2.8 2.8 0 0 0 2.8-2.8V7.8A2.8 2.8 0 0 0 16.2 5Zm1.5 11.2c0 .83-.67 1.5-1.5 1.5H7.8c-.83 0-1.5-.67-1.5-1.5V7.8c0-.83.67-1.5 1.5-1.5h8.4c.83 0 1.5.67 1.5 1.5v8.4ZM16.4 7.6a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z",
	linkedin:
		"M6.94 8.5H4.56V19h2.38V8.5ZM5.75 4.9a1.38 1.38 0 1 0 0 2.76 1.38 1.38 0 0 0 0-2.76ZM19.44 19h-2.38v-5.37c0-1.28-.46-2.15-1.6-2.15-.87 0-1.39.59-1.62 1.15-.08.2-.1.49-.1.77V19H11.4s.03-9.44 0-10.5h2.34v1.49c.31-.48 .87-1.16 2.12-1.16 1.55 0 2.71 1.01 2.71 3.18V19Z",
};

const fallbackNetworks = [
	{ network: "facebook", url: "#" },
	{ network: "instagram", url: "#" },
	{ network: "linkedin", url: "#" },
];
const socialLinks = (socialIcons?.networks?.length ? socialIcons.networks : fallbackNetworks)
	.filter((item) => SOCIAL_ICON_PATHS[item.network])
	.map((item) => ({ label: item.network, href: item.url || "#", path: SOCIAL_ICON_PATHS[item.network] }));

const whatsappDigits = (whatsappButton?.phone || "000000000000").replace(/\D/g, "");
const whatsappHref = `https://wa.me/${whatsappDigits}${
	whatsappButton?.prefilled_message ? `?text=${encodeURIComponent(whatsappButton.prefilled_message)}` : ""
}`;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<Header menu={menuItems} socials={socialLinks} whatsappUrl={whatsappHref} />
		<main>
			<slot />
		</main>
		<Footer socials={socialLinks} whatsappUrl={whatsappHref} contact={contactInfo} />
		<WhatsAppButton href={whatsappHref} />
	</body>
</html>
