---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import noImg from "../../assets/images/noimg.jpg";
import { fetchData, mediaUrl } from "../../functions/fetch";

type PageSection = { type: string; content: Record<string, any> };
type PageResponse = {
  status: string;
  data: { slug: string; path: string; title: string; sections: PageSection[] };
  meta: Record<string, any>;
};

type BlogPostSummary = {
  slug: string;
  title: string;
  excerpt: string;
  cover_image: string | null;
  published_at: string;
};
type BlogListResponse = {
  status: string;
  data: BlogPostSummary[];
  meta: { site: string; page: number; per_page: number; total: number; last_page: number };
};

const pageResponse: PageResponse | undefined = await fetchData("pages/blog");
const pageHero = pageResponse?.data?.sections?.find((section) => section.type === "page_hero")?.content as
  | { title: string; subtitle: string; image: string | null }
  | undefined;

const currentPage = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const listResponse: BlogListResponse | undefined = await fetchData(`blog?page=${currentPage}`);
const posts = listResponse?.data ?? [];
const meta = listResponse?.meta ?? { site: "gnu", page: 1, per_page: posts.length, total: posts.length, last_page: 1 };

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" });

const heroTitle = pageHero?.title ?? "Blog";
const heroSubtitle = pageHero?.subtitle ?? "Noticias y artículos sobre el gas natural.";
---

<Layout title={heroTitle} description={heroSubtitle}>
  <main>
    <PageHero title={heroTitle} subtitle={heroSubtitle} image={pageHero?.image} />

    <section class="section">
      <div class="container">
        {posts.length ? (
          <>
            <div class="grid grid--3">
              {posts.map((post) => (
                <a href={`/blog/${post.slug}`} class="blog-card">
                  <img class="blog-card__cover" src={post.cover_image ? mediaUrl(post.cover_image) : noImg.src} alt="" />
                  <div class="blog-card__body">
                    <p class="blog-card__tag">{formatDate(post.published_at)}</p>
                    <p class="blog-card__title">{post.title}</p>
                    <p class="blog-card__excerpt">{post.excerpt}</p>
                    <span class="blog-card__link">Leer más →</span>
                  </div>
                </a>
              ))}
            </div>

            {meta.last_page > 1 && (
              <div class="pagination">
                {meta.page > 1 && (
                  <a class="btn-secondary" href={`/blog?page=${meta.page - 1}`}>← Anteriores</a>
                )}
                <span class="pagination__status">Página {meta.page} de {meta.last_page}</span>
                {meta.page < meta.last_page && (
                  <a class="btn-secondary" href={`/blog?page=${meta.page + 1}`}>Siguientes →</a>
                )}
              </div>
            )}
          </>
        ) : (
          <p class="section-subtitle" style="text-align:center;">Aún no hay publicaciones disponibles.</p>
        )}
      </div>
    </section>
  </main>
</Layout>
