---
import Layout from "../layouts/Layout.astro";
import ContactBand from "../components/sections/ContactBand.astro";
import StationsMap from "../components/sections/StationsMap.astro";
import RichText from "../components/sections/RichText.astro";
import SavingsSimulator from "../components/sections/SavingsSimulator.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import HeroCarousel from "../components/sections/HeroCarousel.astro";
import ClientsShowcase from "../components/sections/ClientsShowcase.astro";
import { mediaUrl } from "../functions/fetch";
import { getGlobals, getPage, sectionOf } from "../lib/cms";

// The home page keeps a curated order rather than the CMS's raw section list:
// each block is read by type from `pages/inicio`, the stations map from the
// contact page, and the testimonials from the site-wide globals.
const page = await getPage("inicio");
const contacto = await getPage("contacto");
const globals = await getGlobals();

const bannerCarousel = sectionOf(page, "banner_carousel");
const savingsSimulator = sectionOf(page, "savings_simulator");
const richText = sectionOf(page, "rich_text");
const clientsShowcase = sectionOf(page, "clients_showcase");
const leadCaptureForm = sectionOf(page, "lead_capture_form");
const stationsMap = sectionOf(contacto, "stations_map");
const testimonials = globals.testimonials;

// The first banner is what the page opens on, so it is also its social preview.
const firstSlide = bannerCarousel?.slides?.[0];
const socialImage = firstSlide?.image ? mediaUrl(firstSlide.image) : undefined;
---

<Layout image={socialImage}>
  <main id="inicio">
    <HeroCarousel slides={bannerCarousel?.slides} />

    <!-- Simulador de ahorro: dark like the hero, so the two read as one opening -->
    <SavingsSimulator
      title={savingsSimulator?.title}
      intro={savingsSimulator?.intro}
      fuel_prices={savingsSimulator?.fuel_prices}
      page={page?.slug ?? "inicio"}
    />

    <!-- Nuestros Clientes: a light trust strip between the two dark bands -->
    <ClientsShowcase id="clientes" title={clientsShowcase?.title} logos={clientsShowcase?.logos} />

    <!-- Contenido editorial / video de la portada -->
    {richText && <RichText title={richText.title} body={richText.body} video_url={richText.video_url} />}

    <!-- Testimonios -->
    <Testimonials title={testimonials?.title} items={testimonials?.items} />

    <!-- Contacto + estaciones share one band, so there's no empty gap between them -->
    <ContactBand
      id="contacto"
      formId="home-lead-form"
      title={leadCaptureForm?.title}
      intro={leadCaptureForm?.intro}
      submit_label={leadCaptureForm?.submit_label}
      fields={leadCaptureForm?.fields}
      source={page?.slug ?? "inicio"}
    />

    {stationsMap?.center && (
      <StationsMap title={stationsMap.title ?? "Dónde encontrarnos"} center={stationsMap.center} zoom={stationsMap.zoom} />
    )}
  </main>
</Layout>
