---
import Layout from "../layouts/Layout.astro";
import LeadCaptureForm from "../components/sections/LeadCaptureForm.astro";
import noImg from "../assets/images/noimg.jpg";
import { fetchData, mediaUrl } from "../functions/fetch";

type Slide = {
  image: string;
  title: string | null;
  subtitle: string | null;
  link_url: string | null;
  link_label: string | null;
};

type FuelPrice = {
  fuel: string;
  label: string;
  price_per_unit: number;
  unit: string;
  equivalence_factor: number;
};

type Logo = {
  image: string;
  name: string;
  url: string | null;
};

type PageSection = { type: string; content: Record<string, any> };
type PageResponse = {
  status: string;
  data: { slug: string; path: string; title: string; sections: PageSection[] };
  meta: Record<string, any>;
};

const pageResponse: PageResponse | undefined = await fetchData("pages/inicio");
const sections = pageResponse?.data?.sections ?? [];
const getSection = (type: string) => sections.find((section) => section.type === type)?.content;

const bannerCarousel = getSection("banner_carousel") as { slides: Slide[] } | undefined;
const savingsSimulator = getSection("savings_simulator") as
  | { title: string; intro: string; fuel_prices: FuelPrice[] }
  | undefined;
const clientsShowcase = getSection("clients_showcase") as
  | { title: string; logos: Logo[] }
  | undefined;
const leadCaptureForm = getSection("lead_capture_form") as
  | { title: string; intro: string; submit_label: string; fields: string[] }
  | undefined;

const fallbackSlides: Slide[] = [
  { image: noImg.src, title: "Hasta 40% menos que la gasolina", subtitle: "Ahorro real", link_url: null, link_label: null },
  { image: noImg.src, title: "+120 estaciones en todo México", subtitle: "Cobertura nacional", link_url: null, link_label: null },
  { image: noImg.src, title: "Menor huella de carbono desde hoy", subtitle: "Energía responsable", link_url: null, link_label: null },
];
const slides: Slide[] = bannerCarousel?.slides?.length
  ? bannerCarousel.slides.map((slide) => ({ ...slide, image: mediaUrl(slide.image) }))
  : fallbackSlides;

const fuelPrices = savingsSimulator?.fuel_prices ?? [];
const gasNaturalPrice = fuelPrices.find((fuel) => fuel.fuel === "gas-natural");
const comparableFuels = fuelPrices.filter((fuel) => fuel.fuel !== "gas-natural");

const fallbackLogos: Logo[] = [{ image: noImg.src, name: "Cliente de ejemplo", url: null }];
const logos: Logo[] = clientsShowcase?.logos?.length
  ? clientsShowcase.logos.map((logo) => ({ ...logo, image: mediaUrl(logo.image) }))
  : fallbackLogos;
---

<Layout>
  <main id="inicio">
    <!-- Hero: full-bleed carousel driven by the CMS -->
    <section class="hero" id="banner-carousel">
      <div class="hero__track">
        {slides.map((slide, index) => (
          <div class={"hero-slide" + (index === 0 ? " is-active" : "")}>
            <img class="hero-slide__img" src={slide.image} alt="" />
            <div class="hero-slide__scrim" aria-hidden="true" />
            <div class="container hero-slide__content">
              {slide.title && (
                index === 0 ? (
                  <h1 class="hero-slide__title">{slide.title}</h1>
                ) : (
                  <p class="hero-slide__title">{slide.title}</p>
                )
              )}
              {slide.subtitle && <p class="hero-slide__subtitle">{slide.subtitle}</p>}
              {slide.link_url && slide.link_label && (
                <a class="btn-primary hero-slide__cta" href={slide.link_url} target="_blank" rel="noopener noreferrer">
                  {slide.link_label}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="hero__dots" role="tablist" aria-label="Banners"></div>
    </section>

    <!-- Simulador de ahorro -->
    <section class="section" id="simulador">
      <div class="container">
        <div class="simulator">
          <div>
            <span class="eyebrow eyebrow--on-dark">Simulador de ahorro</span>
            <h2 class="simulator__heading">
              {savingsSimulator?.title ?? "Calcula cuánto puedes ahorrar con gas natural"}
            </h2>
            <p class="simulator__lead">
              {savingsSimulator?.intro ??
                "Ingresa tu gasto mensual actual en gasolina o diésel y descubre tu ahorro estimado al cambiarte a GNU Gas Natural."}
            </p>
            <form id="savings-form" style="margin-top: 1.5rem;">
              <div class="field field--on-dark">
                <label for="current-fuel">Combustible actual</label>
                <select id="current-fuel" name="current-fuel">
                  {comparableFuels.map((fuel) => (
                    <option value={fuel.fuel}>{fuel.label}</option>
                  ))}
                </select>
              </div>
              <div class="field field--on-dark">
                <label for="monthly-spend">Gasto mensual actual (MXN)</label>
                <input type="number" id="monthly-spend" name="monthly-spend" min="0" placeholder="Ej. 4500" required />
              </div>
              <button type="submit" class="btn-primary">Calcular ahorro</button>
            </form>
          </div>
          <div class="simulator__result">
            <p class="simulator__result-value" id="savings-value">$0 MXN</p>
            <p class="simulator__result-label">Ahorro mensual estimado</p>
            <p class="simulator__result-label" id="savings-annual" style="margin-top: 0.75rem;">
              Ahorro anual estimado: $0 MXN
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Nuestros Clientes -->
    <section class="section">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="eyebrow">Nuestros Clientes</span>
          <h2 class="section-title">{clientsShowcase?.title ?? "Nuestros clientes"}</h2>
        </div>
        <div class="logo-grid">
          {logos.map((logo) =>
            logo.url ? (
              <a class="logo-card" href={logo.url} target="_blank" rel="noopener noreferrer">
                <img class="logo-card__img" src={logo.image} alt={logo.name} />
              </a>
            ) : (
              <div class="logo-card">
                <img class="logo-card__img" src={logo.image} alt={logo.name} />
              </div>
            )
          )}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="section section--alt" id="contacto">
      <div class="container" style="max-width: 34rem;">
        <div class="section-head section-head--center">
          <span class="eyebrow">Contacto</span>
          <h2 class="section-title">{leadCaptureForm?.title ?? "Hablemos de tu proyecto de gas natural"}</h2>
          <p class="section-subtitle">
            {leadCaptureForm?.intro ??
              "Déjanos tus datos y un asesor te contactará."}
          </p>
        </div>
        <LeadCaptureForm
          formId="home-lead-form"
          title="Cotiza sin compromiso"
          submit_label={leadCaptureForm?.submit_label ?? "Enviar mensaje"}
          fields={leadCaptureForm?.fields}
        />
      </div>
    </section>
  </main>
</Layout>

<script>
  const track = document.querySelector<HTMLElement>(".hero__track");
  const slides = Array.from(document.querySelectorAll<HTMLElement>(".hero-slide"));
  const dotsContainer = document.querySelector<HTMLElement>(".hero__dots");

  if (track && slides.length && dotsContainer) {
    slides.forEach((_, index) => {
      const dot = document.createElement("button");
      dot.className = "hero__dot" + (index === 0 ? " is-active" : "");
      dot.setAttribute("aria-label", `Ir al banner ${index + 1}`);
      dot.addEventListener("click", () => showSlide(index));
      dotsContainer.appendChild(dot);
    });

    const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>(".hero__dot"));
    let current = 0;

    function showSlide(index: number) {
      slides[current].classList.remove("is-active");
      dots[current].classList.remove("is-active");
      current = index;
      slides[current].classList.add("is-active");
      dots[current].classList.add("is-active");
    }

    setInterval(() => {
      showSlide((current + 1) % slides.length);
    }, 5000);
  }

</script>

<script is:inline define:vars={{ comparableFuels, gasNaturalPrice }}>
  const savingsForm = document.querySelector("#savings-form");
  const savingsValue = document.querySelector("#savings-value");
  const savingsAnnual = document.querySelector("#savings-annual");
  const fuelSelect = document.querySelector("#current-fuel");
  const FALLBACK_SAVINGS_RATE = 0.35;

  savingsForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const input = document.querySelector("#monthly-spend");
    const spend = Number(input?.value ?? 0);
    if (!Number.isFinite(spend) || spend <= 0) return;

    const selectedFuel = comparableFuels.find((fuel) => fuel.fuel === fuelSelect?.value);
    let monthlySavings;

    if (selectedFuel && gasNaturalPrice) {
      const unitsConsumed = spend / selectedFuel.price_per_unit;
      const gasNaturalUnitsNeeded = unitsConsumed * selectedFuel.equivalence_factor;
      const gasNaturalCost = gasNaturalUnitsNeeded * gasNaturalPrice.price_per_unit;
      monthlySavings = Math.max(0, Math.round(spend - gasNaturalCost));
    } else {
      monthlySavings = Math.round(spend * FALLBACK_SAVINGS_RATE);
    }

    const annualSavings = monthlySavings * 12;

    if (savingsValue) {
      savingsValue.textContent = `$${monthlySavings.toLocaleString("es-MX")} MXN`;
      savingsValue.classList.remove("is-updated");
      void savingsValue.offsetWidth;
      savingsValue.classList.add("is-updated");
    }
    if (savingsAnnual) savingsAnnual.textContent = `Ahorro anual estimado: $${annualSavings.toLocaleString("es-MX")} MXN`;
  });
</script>
