---
import Layout from "../layouts/Layout.astro";
import LeadCaptureForm from "../components/sections/LeadCaptureForm.astro";
import StationsMap from "../components/sections/StationsMap.astro";
import RichText from "../components/sections/RichText.astro";
import SavingsSimulator from "../components/sections/SavingsSimulator.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import noImg from "../assets/images/noimg.jpg";
import { fetchData, mediaUrl } from "../functions/fetch";
import type { GlobalsResponse } from "../types/globals";

type Slide = {
  image: string;
  title: string | null;
  subtitle: string | null;
  link_url: string | null;
  link_label: string | null;
};

type FuelPrice = {
  fuel: string;
  label: string;
  price_per_unit: number;
  unit: string;
  equivalence_factor: number;
};

type Logo = {
  image: string;
  name: string;
  url: string | null;
};

type PageSection = { type: string; content: Record<string, any> };
type PageResponse = {
  status: string;
  data: { slug: string; path: string; title: string; sections: PageSection[] };
  meta: Record<string, any>;
};

const pageResponse: PageResponse | undefined = await fetchData("pages/inicio");
const sections = pageResponse?.data?.sections ?? [];
const getSection = (type: string) => sections.find((section) => section.type === type)?.content;

const contactoResponse: PageResponse | undefined = await fetchData("pages/contacto");
const contactoSections = contactoResponse?.data?.sections ?? [];
const stationsMap = contactoSections.find((section) => section.type === "stations_map")?.content as
  | { title: string; center: string; zoom?: string | number }
  | undefined;

const globalsResponse: GlobalsResponse | undefined = await fetchData("globals");
const testimonials = globalsResponse?.data?.testimonials;

const bannerCarousel = getSection("banner_carousel") as { slides: Slide[] } | undefined;
const savingsSimulator = getSection("savings_simulator") as
  | { title: string; intro: string; fuel_prices: FuelPrice[] }
  | undefined;
const richText = getSection("rich_text") as
  | { title: string | null; body: string; video_url: string | null }
  | undefined;
const clientsShowcase = getSection("clients_showcase") as
  | { title: string; logos: Logo[] }
  | undefined;
const leadCaptureForm = getSection("lead_capture_form") as
  | { title: string; intro: string; submit_label: string; fields: string[] }
  | undefined;

const fallbackSlides: Slide[] = [
  { image: noImg.src, title: "Hasta 40% menos que la gasolina", subtitle: "Ahorro real", link_url: null, link_label: null },
  { image: noImg.src, title: "+120 estaciones en todo México", subtitle: "Cobertura nacional", link_url: null, link_label: null },
  { image: noImg.src, title: "Menor huella de carbono desde hoy", subtitle: "Energía responsable", link_url: null, link_label: null },
];
const slides: Slide[] = bannerCarousel?.slides?.length
  ? bannerCarousel.slides.map((slide) => ({ ...slide, image: mediaUrl(slide.image) }))
  : fallbackSlides;

const fallbackLogos: Logo[] = [{ image: noImg.src, name: "Cliente de ejemplo", url: null }];
const logos: Logo[] = clientsShowcase?.logos?.length
  ? clientsShowcase.logos.map((logo) => ({ ...logo, image: mediaUrl(logo.image) }))
  : fallbackLogos;
const useLogoMarquee = logos.length >= 4;
const marqueeLogos = useLogoMarquee ? [...logos, ...logos] : logos;
---

<Layout>
  <main id="inicio">
    <!-- Hero: full-bleed carousel driven by the CMS -->
    <section class="hero" id="banner-carousel">
      <div class="hero__track">
        {slides.map((slide, index) => (
          <div class={"hero-slide" + (index === 0 ? " is-active" : "")}>
            <img class="hero-slide__img" src={slide.image} alt="" />
            <div class="hero-slide__scrim" aria-hidden="true" />
            <div class="container hero-slide__content">
              {slide.title && (
                index === 0 ? (
                  <h1 class="hero-slide__title">{slide.title}</h1>
                ) : (
                  <p class="hero-slide__title">{slide.title}</p>
                )
              )}
              {slide.subtitle && <p class="hero-slide__subtitle">{slide.subtitle}</p>}
              {slide.link_url && slide.link_label && (
                <a class="btn-primary hero-slide__cta" href={slide.link_url} target="_blank" rel="noopener noreferrer">
                  {slide.link_label}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="hero__dots" role="tablist" aria-label="Banners"></div>
    </section>

    <!-- Simulador de ahorro -->
    <SavingsSimulator
      title={savingsSimulator?.title}
      intro={savingsSimulator?.intro}
      fuel_prices={savingsSimulator?.fuel_prices}
      page={pageResponse?.data?.slug ?? "inicio"}
    />

    <!-- Contenido editorial / video de la portada -->
    {richText && <RichText title={richText.title} body={richText.body} video_url={richText.video_url} />}

    <!-- Nuestros Clientes -->
    <section class="section" id="clientes">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="eyebrow">Nuestros Clientes</span>
          <h2 class="section-title">{clientsShowcase?.title ?? "Nuestros clientes"}</h2>
        </div>
        {useLogoMarquee ? (
          <div class="logo-marquee">
            <div class="logo-marquee__track">
              {marqueeLogos.map((logo) => (
                <div class="logo-marquee__item">
                  {logo.url ? (
                    <a class="logo-card" href={logo.url} target="_blank" rel="noopener noreferrer">
                      <div class="logo-card__figure">
                        <img class="logo-card__img" src={logo.image} alt={logo.name} />
                      </div>
                      <span class="logo-card__name">{logo.name}</span>
                    </a>
                  ) : (
                    <div class="logo-card">
                      <div class="logo-card__figure">
                        <img class="logo-card__img" src={logo.image} alt={logo.name} />
                      </div>
                      <span class="logo-card__name">{logo.name}</span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="logo-grid">
            {logos.map((logo) =>
              logo.url ? (
                <a class="logo-card" href={logo.url} target="_blank" rel="noopener noreferrer">
                  <div class="logo-card__figure">
                    <img class="logo-card__img" src={logo.image} alt={logo.name} />
                  </div>
                  <span class="logo-card__name">{logo.name}</span>
                </a>
              ) : (
                <div class="logo-card">
                  <div class="logo-card__figure">
                    <img class="logo-card__img" src={logo.image} alt={logo.name} />
                  </div>
                  <span class="logo-card__name">{logo.name}</span>
                </div>
              )
            )}
          </div>
        )}
      </div>
    </section>

    <!-- Testimonios -->
    <Testimonials title={testimonials?.title} items={testimonials?.items} />

    <!-- Contacto -->
    <section class="section" id="contacto">
      <div class="container">
        <div class="contact-layout">
          <div class="section-head">
            <span class="eyebrow">Contacto</span>
            <h2 class="section-title">{leadCaptureForm?.title ?? "Hablemos de tu proyecto de gas natural"}</h2>
            <p class="section-subtitle">
              {leadCaptureForm?.intro ??
                "Déjanos tus datos y un asesor te contactará."}
            </p>
          </div>
          <LeadCaptureForm
            formId="home-lead-form"
            title="Cotiza sin compromiso"
            submit_label={leadCaptureForm?.submit_label ?? "Enviar mensaje"}
            fields={leadCaptureForm?.fields}
            source={pageResponse?.data?.slug ?? "inicio"}
          />
        </div>
      </div>
    </section>

    {stationsMap?.center && (
      <StationsMap title={stationsMap.title ?? "Dónde encontrarnos"} center={stationsMap.center} zoom={stationsMap.zoom} />
    )}
  </main>
</Layout>

<script>
  const track = document.querySelector<HTMLElement>(".hero__track");
  const slides = Array.from(document.querySelectorAll<HTMLElement>(".hero-slide"));
  const dotsContainer = document.querySelector<HTMLElement>(".hero__dots");

  if (track && slides.length && dotsContainer) {
    slides.forEach((_, index) => {
      const dot = document.createElement("button");
      dot.className = "hero__dot" + (index === 0 ? " is-active" : "");
      dot.setAttribute("aria-label", `Ir al banner ${index + 1}`);
      dot.addEventListener("click", () => showSlide(index));
      dotsContainer.appendChild(dot);
    });

    const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>(".hero__dot"));
    let current = 0;

    function showSlide(index: number) {
      slides[current].classList.remove("is-active");
      dots[current].classList.remove("is-active");
      current = index;
      slides[current].classList.add("is-active");
      dots[current].classList.add("is-active");
    }

    setInterval(() => {
      showSlide((current + 1) % slides.length);
    }, 5000);
  }

  // "Nuestros Clientes" logos: colorful and zoomed in by default (--logo-zoom
  // falls back to 1.18 in CSS), scrubbed down to 1 ("zero zoom") as the
  // section scrolls up through the viewport.
  const clientsSection = document.querySelector<HTMLElement>("#clientes");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (clientsSection && !prefersReducedMotion) {
    const ZOOM_MAX = 1.18;
    const ZOOM_MIN = 1;
    let ticking = false;

    function updateLogoZoom() {
      const rect = clientsSection!.getBoundingClientRect();
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      // 0 while the section's top hasn't reached the viewport bottom yet,
      // 1 once its top has scrolled all the way to the viewport top.
      const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / viewportHeight));
      const zoom = ZOOM_MAX - (ZOOM_MAX - ZOOM_MIN) * progress;
      clientsSection!.style.setProperty("--logo-zoom", zoom.toFixed(3));
      ticking = false;
    }

    updateLogoZoom();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateLogoZoom);
        }
      },
      { passive: true }
    );
    window.addEventListener("resize", updateLogoZoom);
  }
</script>
