---
import Layout from "../layouts/Layout.astro";
import LeadCaptureForm from "../components/sections/LeadCaptureForm.astro";
import StationsMap from "../components/sections/StationsMap.astro";
import RichText from "../components/sections/RichText.astro";
import SavingsSimulator from "../components/sections/SavingsSimulator.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import HeroCarousel from "../components/sections/HeroCarousel.astro";
import ClientsShowcase from "../components/sections/ClientsShowcase.astro";
import customerServiceIcon from "../assets/images/customer-service-agent-icon-vector.jpg";
import { mediaUrl } from "../functions/fetch";
import { getGlobals, getPage, sectionOf } from "../lib/cms";

// The home page keeps a curated order rather than the CMS's raw section list:
// each block is read by type from `pages/inicio`, the stations map from the
// contact page, and the testimonials from the site-wide globals.
const page = await getPage("inicio");
const contacto = await getPage("contacto");
const globals = await getGlobals();

const bannerCarousel = sectionOf(page, "banner_carousel");
const savingsSimulator = sectionOf(page, "savings_simulator");
const richText = sectionOf(page, "rich_text");
const clientsShowcase = sectionOf(page, "clients_showcase");
const leadCaptureForm = sectionOf(page, "lead_capture_form");
const stationsMap = sectionOf(contacto, "stations_map");
const testimonials = globals.testimonials;

// The first banner is what the page opens on, so it is also its social preview.
const firstSlide = bannerCarousel?.slides?.[0];
const socialImage = firstSlide?.image ? mediaUrl(firstSlide.image) : undefined;
---

<Layout image={socialImage}>
  <main id="inicio">
    <HeroCarousel slides={bannerCarousel?.slides} />

    <!-- Simulador de ahorro -->
    <SavingsSimulator
      title={savingsSimulator?.title}
      intro={savingsSimulator?.intro}
      fuel_prices={savingsSimulator?.fuel_prices}
      page={page?.slug ?? "inicio"}
    />

    <!-- Contenido editorial / video de la portada -->
    {richText && <RichText title={richText.title} body={richText.body} video_url={richText.video_url} />}

    <!-- Nuestros Clientes -->
    <ClientsShowcase id="clientes" title={clientsShowcase?.title} logos={clientsShowcase?.logos} />

    <!-- Testimonios -->
    <Testimonials title={testimonials?.title} items={testimonials?.items} />

    <!-- Contacto -->
    <section class="section" id="contacto">
      <div class="container">
        <div class="contact-layout">
          <div class="section-head">
            <img class="contact-agent-icon" src={customerServiceIcon.src} alt="" />
            <span class="eyebrow">Contacto</span>
            <h2 class="section-title">{leadCaptureForm?.title ?? "Hablemos de tu proyecto de gas natural"}</h2>
            <p class="section-subtitle">
              {leadCaptureForm?.intro ??
                "Déjanos tus datos y un asesor te contactará."}
            </p>
          </div>
          <LeadCaptureForm
            formId="home-lead-form"
            title="Cotiza sin compromiso"
            submit_label={leadCaptureForm?.submit_label ?? "Enviar mensaje"}
            fields={leadCaptureForm?.fields}
            source={page?.slug ?? "inicio"}
          />
        </div>
      </div>
    </section>

    {stationsMap?.center && (
      <StationsMap title={stationsMap.title ?? "Dónde encontrarnos"} center={stationsMap.center} zoom={stationsMap.zoom} />
    )}
  </main>
</Layout>

<script>
  // "Nuestros Clientes" logos: colorful and zoomed in by default (--logo-zoom
  // falls back to 1.18 in CSS), scrubbed down to 1 ("zero zoom") as the
  // section scrolls up through the viewport.
  const clientsSection = document.querySelector<HTMLElement>("#clientes");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (clientsSection && !prefersReducedMotion) {
    const ZOOM_MAX = 1.18;
    const ZOOM_MIN = 1;
    let ticking = false;

    function updateLogoZoom() {
      const rect = clientsSection!.getBoundingClientRect();
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      // 0 while the section's top hasn't reached the viewport bottom yet,
      // 1 once its top has scrolled all the way to the viewport top.
      const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / viewportHeight));
      const zoom = ZOOM_MAX - (ZOOM_MAX - ZOOM_MIN) * progress;
      clientsSection!.style.setProperty("--logo-zoom", zoom.toFixed(3));
      ticking = false;
    }

    updateLogoZoom();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateLogoZoom);
        }
      },
      { passive: true }
    );
    window.addEventListener("resize", updateLogoZoom);
  }
</script>
