---
import CmsPage from "../../components/CmsPage.astro";
import ChildPageCards from "../../components/ChildPageCards.astro";

const fallbackChildren = [
  { slug: "distintivo-esr", path: "/desarrollo-sostenible/distintivo-esr", title: "Distintivo ESR" },
  { slug: "ecovadis", path: "/desarrollo-sostenible/ecovadis", title: "EcoVadis" },
  { slug: "voluntariado", path: "/desarrollo-sostenible/voluntariado", title: "Voluntariado" },
  { slug: "iniciativas-rse", path: "/desarrollo-sostenible/iniciativas-rse", title: "Iniciativas RSE" },
];
---

<CmsPage slug="desarrollo-sostenible" fallbackTitle="Desarrollo Sostenible">
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Conoce más</span>
        <h2 class="section-title">Explora Desarrollo Sostenible</h2>
      </div>
      <ChildPageCards parent="desarrollo-sostenible" fallback={fallbackChildren} gridClass="grid--4" />
    </div>
  </section>
</CmsPage>
