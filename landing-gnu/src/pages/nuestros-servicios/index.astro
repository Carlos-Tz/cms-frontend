---
import CmsPage from "../../components/CmsPage.astro";
import ServiceCards from "../../components/ServiceCards.astro";

const fallbackChildren = [
  { slug: "gnv", path: "/nuestros-servicios/gnv", title: "GNV" },
  { slug: "gnc", path: "/nuestros-servicios/gnc", title: "GNC" },
  { slug: "gnd", path: "/nuestros-servicios/gnd", title: "GND" },
];
---

<CmsPage
  slug="nuestros-servicios"
  fallbackTitle="Nuestros Servicios"
  fallbackSubtitle="Soluciones de gas natural para tu operación."
  excludeTypes={["clients_showcase"]}
>
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Conoce más</span>
        <h2 class="section-title">Tres formas de aprovechar el gas natural</h2>
        <p class="section-subtitle">
          Compara GNV, GNC y GND, y encuentra la solución de GNU Gas Natural que mejor se adapta a tu operación.
        </p>
      </div>
      <ServiceCards parent="nuestros-servicios" fallback={fallbackChildren} />
    </div>
  </section>
</CmsPage>
