---
import { mediaUrl } from "../../functions/fetch";
import CardBadge from "../CardBadge.astro";

interface FeatureItem {
  icon: string | null;
  title: string;
  text: string;
}

interface Props {
  title?: string | null;
  // Optional 16:9 banner above the title (see NEW-FIELDS.md — not a CMS
  // field yet). The content guide's reference size is 1024x576.
  image?: string | null;
  items: FeatureItem[];
  // Show only each card's title, dropping its text.
  titlesOnly?: boolean;
}

const { title, image, items, titlesOnly = false } = Astro.props;
---

<section class="section section--alt texture-grid">
  <div class="container">
    {image && (
      <div class="feature-grid__banner">
        <img src={mediaUrl(image)} alt="" loading="lazy" />
      </div>
    )}
    {title && (
      <div class="section-head section-head--center">
        <h2 class="section-title">{title}</h2>
      </div>
    )}
    <div class="grid grid--3">
      {items.map((item) => (
        <div class:list={["card card--feature", { "card--photo": item.icon, "card--title-only": titlesOnly }]}>
          {item.icon ? (
            // CMS icons here are full square photos (1254×1254), not line
            // art — shown as a real image banner, not squeezed into the
            // small tinted icon tile below (which only suits the SVG
            // fallback: flat color, reads fine at that size).
            <div class="card__media">
              <img class="card__media-img" src={mediaUrl(item.icon)} alt="" loading="lazy" />
            </div>
          ) : (
            <div class="card__icon" aria-hidden="true">
              <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none">
                <path
                  d="M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 1 3-1 4-2 4a2 2 0 0 1-2-2c0-2 2-3 1-6-2 1-4 3-4 6a5 5 0 0 0 5 5 5 5 0 0 0 5-5c0-4-3-6-3-9-3 1-5 4-5 7"
                  fill="currentColor"
                />
              </svg>
            </div>
          )}
          {/* With a photo, the copy sits in a white panel overlapping the
              photo's bottom edge (card--photo, Gaseco-style). */}
          <div class="card__panel">
            {item.icon && <CardBadge />}
            <p class="card__title">{item.title}</p>
            {!titlesOnly && <p class="card__text">{item.text}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
