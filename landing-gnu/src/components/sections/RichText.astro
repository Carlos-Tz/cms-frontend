---
import { normalizeRichText } from "../../lib/richText";

interface Props {
  title?: string | null;
  body: string;
  video_url?: string | null;
}

const { title, body: rawBody, video_url } = Astro.props;

// Rebuilds pasted (PDF-wrapped) copy into real paragraphs/headings and tidies
// editor residue — see lib/richText.ts.
const body = normalizeRichText(rawBody, { recoveredHeading: "h3" }).html;

// An all-caps title ("NUESTROS SERVICIOS") is written as a label, not a
// headline: it renders as the eyebrow above the copy, and the body's own
// first heading (if any) carries the headline size.
const isLabelTitle = !!title && title === title.toUpperCase() && /[A-ZÁÉÍÓÚÑ]{3}/.test(title);

function toEmbedUrl(url: string) {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");

    if (host === "youtube.com" || host === "m.youtube.com") {
      if (parsed.pathname === "/watch") {
        const id = parsed.searchParams.get("v");
        if (id) return `https://www.youtube.com/embed/${id}`;
      }
      if (parsed.pathname.startsWith("/embed/")) return url;
      if (parsed.pathname.startsWith("/shorts/")) {
        return `https://www.youtube.com/embed/${parsed.pathname.split("/")[2]}`;
      }
    }

    if (host === "youtu.be") {
      return `https://www.youtube.com/embed/${parsed.pathname.slice(1)}`;
    }

    if (host === "vimeo.com") {
      return `https://player.vimeo.com/video/${parsed.pathname.slice(1)}`;
    }

    if (host === "player.vimeo.com") return url;

    return url;
  } catch {
    return url;
  }
}

// Autoplay is opt-in per player and browsers only honor it while the video is
// muted, so ask for both through the embed's own query params.
function withAutoplay(url: string) {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");

    if (host === "youtube.com" || host === "youtube-nocookie.com") {
      parsed.searchParams.set("autoplay", "1");
      parsed.searchParams.set("mute", "1");
      parsed.searchParams.set("playsinline", "1");
      return parsed.toString();
    }

    if (host === "player.vimeo.com") {
      parsed.searchParams.set("autoplay", "1");
      parsed.searchParams.set("muted", "1");
      return parsed.toString();
    }

    return url;
  } catch {
    return url;
  }
}

const embedUrl = video_url ? withAutoplay(toEmbedUrl(video_url)) : null;
---

{embedUrl ? (
  <>
  <section class="section rich-text-media">
    <div class="container">
      <div class="rich-text-media__layout">
        <div class="rich-text-media__video">
          <iframe
            src={embedUrl}
            title={title ?? "Video"}
            loading="lazy"
            allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="rich-text-media__content">
          {title && (isLabelTitle ? <span class="eyebrow">{title}</span> : <h2 class="section-title">{title}</h2>)}
          <div class:list={["prose", { "prose--after-label": isLabelTitle }]} set:html={body} />
        </div>
      </div>
    </div>
  </section>

  <script>
    // Drifts the section's background from white (matching "Simulador de
    // ahorro" right above it) to a very light tint of the logo's blue as it
    // scrolls through view — the dark heading / body text stay readable
    // against it the whole way through since neither stop ever gets dark.
    document.querySelectorAll<HTMLElement>(".rich-text-media").forEach((section) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const stops: [number, number, number][] = [
        [255, 255, 255], // --color-bg — same white as "Simulador de ahorro"
        [224, 236, 246], // light tint of the logo blue (#1f5ca9)
      ];

      function colorAt(t: number) {
        const scaled = Math.min(0.999, Math.max(0, t)) * (stops.length - 1);
        const i = Math.floor(scaled);
        const frac = scaled - i;
        const [r1, g1, b1] = stops[i];
        const [r2, g2, b2] = stops[i + 1];
        const r = Math.round(r1 + (r2 - r1) * frac);
        const g = Math.round(g1 + (g2 - g1) * frac);
        const b = Math.round(b1 + (b2 - b1) * frac);
        return `rgb(${r}, ${g}, ${b})`;
      }

      let ticking = false;
      function update() {
        const rect = section.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        // 0 while the section's top hasn't reached the viewport bottom yet,
        // 1 once its bottom has scrolled past the viewport top — i.e.
        // progress across the section's own scroll-through range.
        const total = rect.height + viewportHeight;
        const rawProgress = total > 0 ? Math.min(1, Math.max(0, (viewportHeight - rect.top) / total)) : 0;
        // Eased (not linear): holds black through the section's entrance and
        // only ramps toward the logo blue in the back half of the scroll-through.
        const progress = Math.pow(rawProgress, 2.5);
        section.style.setProperty("--section-bg", colorAt(progress));
        ticking = false;
      }

      update();
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      window.addEventListener("resize", update);
    });
  </script>
  </>
) : (
  <section class="section">
    <div class="container rich-text">
      {title && (isLabelTitle ? <span class="eyebrow">{title}</span> : <h2 class="section-title">{title}</h2>)}
      <div class:list={["prose", "prose--section", { "prose--after-label": isLabelTitle }]} set:html={body} />
    </div>
  </section>
)}
