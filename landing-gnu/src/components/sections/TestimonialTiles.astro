---
// The interactive photo/quote tiles shared by Testimonials.astro (site-wide
// "Lo que dicen nuestros clientes") and ClientsShowcase.astro (a client's own
// quote, embedded under its logo) — same visual, same behavior, wherever a
// list of quotes needs to render.
import { mediaUrl } from "../../functions/fetch";

interface Testimonial {
  quote: string;
  author?: string | null;
  role?: string | null;
  photo?: string | null;
}

interface Props {
  items?: Testimonial[];
}

const { items = [] } = Astro.props;

// CMS authors sometimes type their own quote marks into the text. The tile
// already adds a decorative one, so strip any the author included to avoid
// doubling up (e.g. `""like this".`) — the closing quote is often followed
// by trailing punctuation (a period), so the trailing match allows for one.
const stripQuotes = (quote: string) =>
  quote
    .trim()
    .replace(/^["“”'‘’]+/, "")
    .replace(/["“”'‘’]+(?=[.!?]?\s*$)/, "")
    .trim();

// Without a photo the tile shows the author's initials instead, so every
// tile has something to show before it is hovered.
const initials = (name?: string | null) =>
  (name ?? "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase())
    .join("") || "“";
---

{items.length > 0 && (
  <div class="testimonial-tiles">
    {items.map((item) => (
      // Focusable so the quote also opens from the keyboard and, on touch
      // screens, with a tap (see the script below).
      <figure class="testimonial-tile" tabindex="0" aria-label={item.author ? `Testimonio de ${item.author}` : "Testimonio"}>
        <div class="testimonial-tile__media" aria-hidden="true">
          {item.photo ? (
            <img class="testimonial-tile__img" src={mediaUrl(item.photo)} alt="" loading="lazy" />
          ) : (
            <span class="testimonial-tile__initials">{initials(item.author)}</span>
          )}
          <span class="testimonial-tile__cue">
            Leer testimonio
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 9.5V2.5M3 5.5l3-3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
        <div class="testimonial-tile__panel">
          <svg class="testimonial-tile__mark" width="28" height="22" viewBox="0 0 34 26" fill="none" aria-hidden="true">
            <path d="M14.4 0 8 12.2h5.6V26H0V13.6L6.4 0h8Zm19.6 0-6.4 12.2H33V26H19.6V13.6L26 0h8Z" fill="currentColor" />
          </svg>
          <blockquote class="testimonial-tile__quote">
            <p>{stripQuotes(item.quote)}</p>
          </blockquote>
          {(item.author || item.role) && (
            <figcaption class="testimonial-tile__meta">
              {item.author && <span class="testimonial-tile__author">{item.author}</span>}
              {item.role && <span class="testimonial-tile__role">{item.role}</span>}
            </figcaption>
          )}
        </div>
      </figure>
    ))}
  </div>
)}

<script>
  // Touch screens have no hover: a tap toggles the tile open (and closes the
  // others), so the quote is reachable there too. Mouse users keep hover.
  // Scoped per `.testimonial-tiles` grid so more than one instance on a page
  // (e.g. the home page's own section plus one embedded in a client card)
  // toggle independently instead of one tile closing another grid's tile.
  const touch = window.matchMedia("(hover: none)");
  document.querySelectorAll<HTMLElement>(".testimonial-tiles").forEach((grid) => {
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>(".testimonial-tile"));
    tiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        if (!touch.matches) return;
        const open = tile.classList.contains("is-open");
        tiles.forEach((other) => other.classList.remove("is-open"));
        if (!open) tile.classList.add("is-open");
      });
      tile.addEventListener("keydown", (event) => {
        if (event.key === "Escape") tile.blur();
      });
    });
  });
</script>
