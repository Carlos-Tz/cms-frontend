---
// The testimonial quote cards shared by Testimonials.astro (site-wide "Lo
// que dicen nuestros clientes") and ClientsShowcase.astro (a client's own
// quote, embedded under its logo) — same visual, same markup, wherever a
// list of quotes needs to render. A sober, always-visible card: the full
// quote is on screen from the start (no hover-to-reveal), so there's no
// separate "open" state or touch/keyboard affordance to wire up.
import { mediaUrl } from "../../functions/fetch";
import { cleanClientLogoUrl } from "../../lib/clientLogos";

interface Testimonial {
  quote: string;
  author?: string | null;
  role?: string | null;
  photo?: string | null;
}

interface Props {
  items?: Testimonial[];
}

const { items = [] } = Astro.props;

// CMS authors sometimes type their own quote marks into the text. The tile
// already adds a decorative one, so strip any the author included to avoid
// doubling up (e.g. `""like this".`) — the closing quote is often followed
// by trailing punctuation (a period), so the trailing match allows for one.
const stripQuotes = (quote: string) =>
  quote
    .trim()
    .replace(/^["“”'‘’]+/, "")
    .replace(/["“”'‘’]+(?=[.!?]?\s*$)/, "")
    .trim();

// Without a photo the tile shows the author's initials instead.
const initials = (name?: string | null) =>
  (name ?? "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase())
    .join("") || "“";
---

{items.length > 0 && (
  <div class="testimonial-tiles">
    {items.map((item) => (
      <figure class="testimonial-tile" aria-label={item.author ? `Testimonio de ${item.author}` : "Testimonio"}>
        <div class="testimonial-tile__media" aria-hidden="true">
          {item.photo ? (
            <img class="testimonial-tile__img" src={cleanClientLogoUrl(mediaUrl(item.photo))} alt="" loading="lazy" />
          ) : (
            <span class="testimonial-tile__initials">{initials(item.author)}</span>
          )}
        </div>
        <svg class="testimonial-tile__mark" width="28" height="22" viewBox="0 0 34 26" fill="none" aria-hidden="true">
          <path d="M14.4 0 8 12.2h5.6V26H0V13.6L6.4 0h8Zm19.6 0-6.4 12.2H33V26H19.6V13.6L26 0h8Z" fill="currentColor" />
        </svg>
        <blockquote class="testimonial-tile__quote">
          <p>{stripQuotes(item.quote)}</p>
        </blockquote>
        {(item.author || item.role) && (
          <figcaption class="testimonial-tile__meta">
            {item.author && <span class="testimonial-tile__author">{item.author}</span>}
            {item.role && <span class="testimonial-tile__role">{item.role}</span>}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
)}
