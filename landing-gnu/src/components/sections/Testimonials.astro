---
import TestimonialTiles from "./TestimonialTiles.astro";

interface Testimonial {
  quote: string;
  author?: string | null;
  role?: string | null;
  photo?: string | null;
}

interface Props {
  title?: string | null;
  items?: Testimonial[];
}

const { title, items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Testimonios</span>
        <h2 class="section-title">{title ?? "Lo que dicen nuestros clientes"}</h2>
      </div>
      <TestimonialTiles items={items} />
    </div>
  </section>
)}
