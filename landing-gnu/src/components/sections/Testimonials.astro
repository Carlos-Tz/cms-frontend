---
import TestimonialTiles from "./TestimonialTiles.astro";

interface Testimonial {
  quote: string;
  author?: string | null;
  role?: string | null;
  photo?: string | null;
}

interface Props {
  title?: string | null;
  items?: Testimonial[];
}

const { title, items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="section section--alt texture-grid">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Testimonios</span>
        <h2 class="section-title">{title ?? "Lo que dicen nuestros clientes"}</h2>
      </div>
      {/* GNU's testimonials are attributed by client logo, not a personal
          headshot (same convention as ClientsShowcase's quoted clients) —
          "contain" so the logo shows whole, padded, instead of cropped. */}
      <TestimonialTiles items={items} imageFit="contain" />
    </div>
  </section>
)}
