---
// A row of trust pillars sitting right under the hero, its cards peeking up
// over the hero's own bottom edge — the "feature strip overlapping the
// hero" layout borrowed from the TechBiz template (inspiration/). Content
// reuses the same three claims HeroCarousel already falls back to, so
// nothing here is invented copy.
interface Item {
  icon: "percent" | "map-pin" | "leaf";
  title: string;
  text: string;
}

const items: Item[] = [
  { icon: "percent", title: "Haz que cada kilómetro rinda más.", text: "Descubre cómo el gas natural vehicular puede ayudarte a reducir el gasto de combustible." },
  { icon: "map-pin", title: "Energía que acompaña tu operación.", text: "Soluciones de suministro de gas natural para industrias y transporte, de acuerdo con la viabilidad de cada proyecto." },
  { icon: "leaf", title: "Eficiencia que genera ahorro. Energía que reduce tu huella.", text: "Impulsamos una forma más eficiente de consumir energía, ayudando a la industria y al transporte a reducir costos y su impacto ambiental." },
];

const ICON_PATHS: Record<Item["icon"], string> = {
  percent:
    '<circle cx="7" cy="7" r="2.5" /><circle cx="17" cy="17" r="2.5" /><path d="M18 6 6 18" />',
  // Same pin shape as the stations list, so the icon language stays consistent.
  "map-pin": '<path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.25" />',
  leaf: '<path d="M5 19c7 1 13-4 14-14-9 0-14 5-14 12 0 .7 0 1.4 0 2Z" /><path d="M5 19c2-4 5-7 9-9" />',
};
---

<div class="trust-strip">
  <div class="container">
    <div class="trust-strip__grid">
      {items.map((item) => (
        <div class="trust-strip__card">
          <span class="trust-strip__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON_PATHS[item.icon]} />
          </span>
          <div class="trust-strip__body">
            <p class="trust-strip__title">{item.title}</p>
            <p class="trust-strip__text">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
