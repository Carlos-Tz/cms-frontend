---
// A `lead_capture_form` laid out as a full band: the pitch and the site-wide
// contact details on one side, the form on the other — so the form never
// floats alone in a narrow column with empty space on both sides. Shared by
// the home page, /contacto and every CMS page that carries the section.
import LeadCaptureForm from "./LeadCaptureForm.astro";
import ContactInfo from "./ContactInfo.astro";
import customerServiceIcon from "../../assets/images/customer-service-agent-icon-vector.jpg";
import { getGlobals, whatsappHref } from "../../lib/cms";

interface Props {
  title?: string | null;
  intro?: string | null;
  submit_label?: string | null;
  fields?: string[];
  formId?: string;
  source?: string | null;
  id?: string;
}

const {
  title,
  intro,
  submit_label,
  fields,
  formId = "lead-form",
  source = null,
  id,
} = Astro.props;

const globals = await getGlobals();
const contactInfo = globals.contact_info;
const whatsapp = whatsappHref(globals);
---

<section class="section lead-band texture-dots" id={id}>
  <div class="lead-band__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="contact-layout">
      <div class="lead-band__aside">
        <div class="lead-band__intro">
          <img class="contact-agent-icon" src={customerServiceIcon.src} alt="" />
          <div>
            <span class="eyebrow">Contacto</span>
            <h2 class="section-title">{title ?? "Hablemos de tu proyecto de gas natural"}</h2>
          </div>
        </div>
        <p class="section-subtitle">{intro ?? "Déjanos tus datos y un asesor te contactará."}</p>
        {contactInfo && <ContactInfo {...contactInfo} whatsappHref={whatsapp} inline />}
      </div>
      <LeadCaptureForm
        formId={formId}
        title="Cotiza sin compromiso"
        submit_label={submit_label ?? "Enviar mensaje"}
        fields={fields}
        source={source}
      />
    </div>
  </div>
</section>
