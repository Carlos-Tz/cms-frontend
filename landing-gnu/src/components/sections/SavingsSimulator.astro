---
import SimulatorCalculator, { type FuelPrice } from "../SimulatorCalculator.astro";

interface Props {
  title?: string | null;
  intro?: string | null;
  fuel_prices?: FuelPrice[];
  // Slug of the page this simulator sits on. `gnu` carries one on the home
  // page and another on /nuestros-servicios/gnc, each with its own reference
  // prices, and the endpoint needs this to pick the right one — without it it
  // silently answers with the site's first.
  page?: string | null;
}

const { title, intro, fuel_prices = [], page = null } = Astro.props;

const hasComparableFuels = fuel_prices.some((fuel) => fuel.fuel !== "gas-natural");
---

{hasComparableFuels && (
  <section class="simulator-band texture-grain" id="simulador" data-inline-simulator>
    <div class="aurora aurora--soft" aria-hidden="true">
      <span class="aurora__blob aurora__blob--1"></span>
      <span class="aurora__blob aurora__blob--2"></span>
      <span class="aurora__blob aurora__blob--3"></span>
    </div>
    <div class="container simulator">
      <div class="simulator__intro">
        <span class="eyebrow">Simulador de ahorro</span>
        <h2 class="simulator__heading">{title ?? "Calcula cuánto puedes ahorrar con gas natural"}</h2>
        <p class="simulator__lead">
          {intro ?? "Ingresa tu gasto mensual actual en gasolina o diésel y descubre tu ahorro estimado al cambiarte a GNU Gas Natural."}
        </p>
        <ul class="simulator__perks">
          <li>Resultado al instante</li>
          <li>Precios de referencia actualizados</li>
          <li>Sin registro</li>
        </ul>
      </div>
      <SimulatorCalculator fuel_prices={fuel_prices} page={page} idPrefix={`sim-${page ?? "page"}`} />
    </div>
  </section>
)}
