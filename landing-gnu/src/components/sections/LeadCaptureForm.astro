---
import { BASE_URL } from "../../functions/fetch";
import logo from "../../assets/images/logo-blue.png";

type ContactFieldType = "text" | "email" | "tel" | "textarea";

const contactFieldMeta: Record<string, { label: string; type: ContactFieldType; placeholder: string }> = {
  name: { label: "Nombre completo", type: "text", placeholder: "Tu nombre" },
  email: { label: "Correo electrónico", type: "email", placeholder: "tucorreo@ejemplo.com" },
  phone: { label: "Teléfono", type: "tel", placeholder: "Ej. 55 1234 5678" },
  message: { label: "Mensaje", type: "textarea", placeholder: "Cuéntanos qué necesitas" },
};

interface Props {
  title?: string | null;
  intro?: string | null;
  submit_label?: string | null;
  fields?: string[];
  formId?: string;
  // Slug of the page holding this form. Travels with the lead as `source`; the
  // CMS validates it against the site's published pages and the admin inbox
  // filters on it to tell one form apart from another.
  source?: string | null;
}

const {
  title = "Cotiza sin compromiso",
  intro,
  submit_label = "Enviar",
  fields = ["name", "email", "phone", "message"],
  formId = "lead-form",
  source = null,
} = Astro.props;
---

<div class="card" id={`${formId}-panel`}>
  <img class="card__brand-logo" src={logo.src} width={logo.width} height={logo.height} alt="GNU Gas Natural" />
  <p class="card__title lead-form__title" style="margin-bottom: 1rem;">{title}</p>
  {intro && <p class="card__text" style="margin-bottom: 1rem;">{intro}</p>}
  <form id={formId}>
    {fields.map((field) => {
      const meta = contactFieldMeta[field] ?? {
        label: field.charAt(0).toUpperCase() + field.slice(1),
        type: "text" as ContactFieldType,
        placeholder: "",
      };
      return (
        <div class="field">
          <label for={`${formId}-${field}`}>{meta.label}</label>
          {meta.type === "textarea" ? (
            <textarea id={`${formId}-${field}`} name={field} rows="3" placeholder={meta.placeholder} />
          ) : (
            <input
              type={meta.type}
              id={`${formId}-${field}`}
              name={field}
              placeholder={meta.placeholder}
              required={field !== "phone"}
            />
          )}
        </div>
      );
    })}
    <button type="submit" class="btn-primary">{submit_label}</button>
    <p class="lead-form__status" data-lead-form-status role="status" aria-live="polite"></p>
  </form>
</div>

{/* Success confirmation (errors stay inline in the status line above). One
    dialog per form, so two forms on a page never share one. Same pattern as
    gas-gnu's LeadCaptureForm. */}
<dialog
  class="confirmation-modal"
  id={`${formId}-confirmation`}
  aria-labelledby={`${formId}-confirmation-title`}
  aria-describedby={`${formId}-confirmation-text`}
>
  <button type="button" class="confirmation-modal__close" aria-label="Cerrar">×</button>
  <div class="confirmation-modal__check" aria-hidden="true">
    <svg viewBox="0 0 52 52">
      <circle class="confirmation-modal__check-circle" cx="26" cy="26" r="24" fill="none" />
      <path class="confirmation-modal__check-mark" fill="none" d="M14 27l7 7 16-16" />
    </svg>
  </div>
  <p class="confirmation-modal__title" id={`${formId}-confirmation-title`}>¡Listo!</p>
  <p class="confirmation-modal__text" id={`${formId}-confirmation-text`} data-lead-form-confirmation-text></p>
</dialog>

<script define:vars={{ apiBase: BASE_URL, leadFormId: formId, leadSource: source }} is:inline>
  // Only these four map to real `leads` columns. Anything else the CMS lists
  // in this section's `fields[]` (empresa, flota, …) is an extra the API only
  // accepts nested under `details`, whitelisted server-side against the source
  // page's own declared fields — sent flat, it is silently dropped.
  const CORE_LEAD_FIELDS = ["name", "email", "phone", "message"];

  const form = document.getElementById(leadFormId);
  const status = form ? form.querySelector("[data-lead-form-status]") : null;

  // Success confirmation modal. Closes on its × button, Esc, a click on the
  // backdrop, or by itself after 4.5s; focus then returns to the submit
  // button so keyboard users land back where they were.
  const confirmationModal = document.getElementById(leadFormId + "-confirmation");
  const confirmationText = confirmationModal?.querySelector("[data-lead-form-confirmation-text]");
  let confirmationTimer;

  function showConfirmation(message) {
    // No <dialog> support: fall back to the inline status line.
    if (!confirmationModal || typeof confirmationModal.showModal !== "function") {
      if (status) {
        status.textContent = message;
        status.className = "lead-form__status lead-form__status--success";
      }
      return;
    }
    if (confirmationText) confirmationText.textContent = message;
    if (status) {
      status.textContent = "";
      status.className = "lead-form__status";
    }
    confirmationModal.showModal();
    clearTimeout(confirmationTimer);
    confirmationTimer = window.setTimeout(() => confirmationModal.close(), 4500);
  }

  confirmationModal?.addEventListener("click", (event) => {
    if (event.target === confirmationModal) confirmationModal.close();
  });
  confirmationModal?.querySelector(".confirmation-modal__close")?.addEventListener("click", () => confirmationModal.close());
  confirmationModal?.addEventListener("close", () => {
    clearTimeout(confirmationTimer);
    form?.querySelector('button[type="submit"]')?.focus();
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = form.querySelector('button[type="submit"]');
    const entries = Object.fromEntries(new FormData(form).entries());

    const data = leadSource ? { source: leadSource } : {};
    const details = {};
    for (const [key, value] of Object.entries(entries)) {
      if (CORE_LEAD_FIELDS.includes(key)) data[key] = value;
      else details[key] = value;
    }
    if (Object.keys(details).length) data.details = details;

    if (submitButton) submitButton.disabled = true;
    if (status) {
      status.textContent = "Enviando...";
      status.className = "lead-form__status";
    }

    try {
      const response = await fetch(apiBase + "leads", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(data),
      });
      const result = await response.json().catch(() => null);

      if (!response.ok) {
        // 429 is the route's throttle:10,1; 422 carries per-field messages.
        const firstError = result?.errors ? Object.values(result.errors)[0]?.[0] : null;
        throw new Error(
          response.status === 429
            ? "Recibimos demasiados envíos. Espera un momento e intenta de nuevo."
            : firstError || result?.message || "No pudimos enviar tu mensaje. Intenta de nuevo."
        );
      }

      form.reset();
      showConfirmation(result?.meta?.message || "Gracias por contactarnos. Un asesor se comunicará contigo.");
    } catch (error) {
      if (status) {
        status.textContent = error?.message || "No pudimos enviar tu mensaje. Intenta de nuevo.";
        status.className = "lead-form__status lead-form__status--error";
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
