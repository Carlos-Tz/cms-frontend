---
// A page rendered straight from `GET pages/{slug}`: its sections in CMS order,
// with its "Encabezado de página" doubling as the SEO summary — the hero
// subtitle becomes the meta description and the hero image the social preview.
// Anything passed as children renders after the sections (e.g. a hub's cards).
import Layout from "../layouts/Layout.astro";
import SectionRenderer from "./SectionRenderer.astro";
import PageHero from "./sections/PageHero.astro";
import { mediaUrl } from "../functions/fetch";
import { getPage, heroOf, type Section } from "../lib/cms";
import { NAV_LABEL_OVERRIDES } from "../config/labelOverrides";

interface Props {
  slug: string;
  // Shown only when the CMS is unreachable at build time.
  fallbackTitle: string;
  fallbackSubtitle?: string;
  // Section types from the CMS to skip, e.g. when a page already shows the
  // same section elsewhere (so the editor doesn't have to remove it from
  // the CMS just to keep one specific page from duplicating it).
  excludeTypes?: string[];
  // A section borrowed from another page, rendered right after this page's
  // first section of type `after` (or last, when there is none) — e.g. the
  // GNC simulator shown on GNV.
  insertSection?: { after: string; section: Section };
  // Show feature_grid cards with their titles only, dropping the text.
  featureTitlesOnly?: boolean;
}

const { slug, fallbackTitle, fallbackSubtitle, excludeTypes = [], featureTitlesOnly = false, insertSection } = Astro.props;

const page = await getPage(slug);
const hero = heroOf(page);
const sections = (page?.sections ?? []).filter((section) => !excludeTypes.includes(section.type));
if (insertSection) {
  const anchor = sections.findIndex((section) => section.type === insertSection.after);
  sections.splice(anchor === -1 ? sections.length : anchor + 1, 0, insertSection.section);
}
---

<Layout
  title={NAV_LABEL_OVERRIDES[slug] ?? page?.title ?? fallbackTitle}
  description={hero?.subtitle ?? fallbackSubtitle}
  image={hero?.image ? mediaUrl(hero.image) : undefined}
>
  <main>
    {!page && <PageHero title={fallbackTitle} subtitle={fallbackSubtitle} />}
    <SectionRenderer sections={sections} pageSlug={page?.slug} featureTitlesOnly={featureTitlesOnly} />
    <slot />
  </main>
</Layout>
