---
import "../styles/global.css";
import { fetchData } from "../functions/fetch";
import { seo } from "../config/seo";
import type { GlobalsResponse } from "../types/globals";

interface Props {
  // Page-specific title, WITHOUT the site name — Layout appends
  // "{titleSeparator} {siteName}" automatically. Omit to fall back to
  // `seo.defaultTitle` (used as-is, already includes the site name).
  title?: string;
  description?: string;
  // Absolute or root-relative URL to a social preview image (og:image / twitter:image).
  image?: string | null;
  // Set true on pages that shouldn't be indexed (e.g. a "not found" state).
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;

const pageTitle = title ? `${title} ${seo.titleSeparator} ${seo.siteName}` : seo.defaultTitle;
const pageDescription = description ?? seo.defaultDescription;
const socialImage = image ?? seo.defaultImage;
const canonicalUrl = new URL(Astro.url.pathname, seo.siteUrl).toString();
const socialImageUrl = socialImage ? new URL(socialImage, seo.siteUrl).toString() : null;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/nuestros-servicios", label: "Nuestros Servicios" },
  { href: "/sobre-nosotros", label: "Sobre Nosotros" },
  { href: "/desarrollo-sostenible", label: "Desarrollo Sostenible" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];

// Footer contact info, social links and the WhatsApp button are all editable
// from the CMS admin (home page → Datos de contacto / Redes sociales / Botón
// de WhatsApp) and shared by every page, so they come from the site-wide
// `globals` endpoint. This layout wraps every page, so it fetches them here
// rather than relying on each page to pass them down.
const globalsResponse: GlobalsResponse | undefined = await fetchData("globals");
const globals = globalsResponse?.data;

const contactInfo = globals?.contact_info;
const socialIcons = globals?.social_icons;
const whatsappButton = globals?.whatsapp_button;

const footerEmail = contactInfo?.email ?? "contacto@gnugas.mx";
const footerPhone = contactInfo?.phone ?? "800 555 0192";
const footerSchedule = contactInfo?.schedule ?? "Lun–Vie, 9:00–18:00";
const footerAddress = contactInfo?.address;
const footerAdditionalInfo = contactInfo?.additional_info;

const SOCIAL_ICON_MARKUP: Record<string, string> = {
  facebook:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H17V3.6C16.6 3.55 15.5 3.4 14.2 3.4c-2.7 0-4.5 1.65-4.5 4.65v2.85H7v3.1h2.7V21h3.8z"/></svg>',
  instagram:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>',
  linkedin:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38V8.5zM5.25 3.5a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92zM20.44 20h-3.37v-6.05c0-1.44-.03-3.3-2.02-3.3-2.02 0-2.33 1.58-2.33 3.2V20H9.35V8.5h3.24v1.57h.05c.45-.86 1.56-1.77 3.21-1.77 3.43 0 4.06 2.26 4.06 5.19V20z"/></svg>',
  youtube:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2s-.2-1.5-.85-2.15c-.8-.85-1.7-.85-2.1-.9C15.8 4 12 4 12 4h0s-3.8 0-6.65.15c-.4.05-1.3.05-2.1.9C2.6 5.7 2.4 7.2 2.4 7.2S2.2 9 2.2 10.7v1.6c0 1.7.2 3.5.2 3.5s.2 1.5.85 2.15c.8.85 1.85.82 2.3.91C7.2 19 12 19 12 19s3.8 0 6.65-.15c.4-.05 1.3-.05 2.1-.9.65-.65.85-2.15.85-2.15s.2-1.8.2-3.5v-1.6c0-1.7-.2-3.5-.2-3.5zM10 14.6V8.9l5.2 2.85z"/></svg>',
  twitter:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 3H21l-6.4 7.3L22 21h-5.9l-4.6-6-5.3 6H3l6.8-7.8L2.4 3h6l4.2 5.5L18.9 3zM17.9 19.3h1.6L8.2 4.6H6.5l11.4 14.7z"/></svg>',
  tiktok:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14.5 3h2.7c.2 1.5 1 2.8 2.3 3.6.9.6 2 .9 3 .9v2.8c-1.5 0-3-.4-4.3-1.2v6.6c0 3.4-2.8 6.1-6.1 6.1S6 18.1 6 14.8c0-3.2 2.5-5.8 5.6-6.1v2.9c-1.5.3-2.7 1.6-2.7 3.2 0 1.8 1.4 3.2 3.2 3.2s3.2-1.4 3.2-3.2V3z"/></svg>',
};

const fallbackNetworks = [
  { network: "facebook", url: "#" },
  { network: "instagram", url: "#" },
  { network: "linkedin", url: "#" },
  { network: "youtube", url: "#" },
];
const socialNetworks = (socialIcons?.networks?.length ? socialIcons.networks : fallbackNetworks).filter(
  (item) => SOCIAL_ICON_MARKUP[item.network]
);

const whatsappDigits = (whatsappButton?.phone || "525555550192").replace(/\D/g, "");
const whatsappHref = `https://wa.me/${whatsappDigits}${
  whatsappButton?.prefilled_message ? `?text=${encodeURIComponent(whatsappButton.prefilled_message)}` : ""
}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}

    <meta name="twitter:card" content={seo.twitterCard} />
    {seo.twitterHandle && <meta name="twitter:site" content={seo.twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="#inicio" class="brand">
          <span class="brand__mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 1 3-1 4-2 4a2 2 0 0 1-2-2c0-2 2-3 1-6-2 1-4 3-4 6a5 5 0 0 0 5 5 5 5 0 0 0 5-5c0-4-3-6-3-9-3 1-5 4-5 7"
                fill="#45d6c9"
              />
            </svg>
          </span>
          GNU <span style="color: var(--color-primary-light);">Gas Natural</span>
        </a>
        <nav class="nav" aria-label="Principal">
          {navLinks.map((link) => (
            <a class="nav-link" href={link.href}>{link.label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="btn-primary" href="#contacto">Cotiza aquí</a>
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Abrir menú"
          >
            <span class="nav-toggle__bar" aria-hidden="true"></span>
            <span class="nav-toggle__bar" aria-hidden="true"></span>
            <span class="nav-toggle__bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>

    <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
      <div class="mobile-nav__inner">
        <div class="mobile-nav__header">
          <a href="#inicio" class="brand" style="color: #fff;">
            <span class="brand__mark" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path
                  d="M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 1 3-1 4-2 4a2 2 0 0 1-2-2c0-2 2-3 1-6-2 1-4 3-4 6a5 5 0 0 0 5 5 5 5 0 0 0 5-5c0-4-3-6-3-9-3 1-5 4-5 7"
                  fill="#45d6c9"
                />
              </svg>
            </span>
            GNU <span style="color: var(--color-primary-light);">Gas Natural</span>
          </a>
          <button type="button" class="mobile-nav__close" id="mobile-nav-close" aria-label="Cerrar menú">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M5 5l14 14M19 5L5 19" />
            </svg>
          </button>
        </div>
        <nav class="mobile-nav__links" aria-label="Principal (móvil)">
          {navLinks.map((link) => (
            <a class="mobile-nav__link" href={link.href}>{link.label}</a>
          ))}
        </nav>
        <a class="btn-primary mobile-nav__cta" href="#contacto">Cotiza aquí</a>
      </div>
    </div>

    <slot />

    <footer class="site-footer" id="contacto-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a href="#inicio" class="brand" style="color: #fff;">
              <span class="brand__mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 1 3-1 4-2 4a2 2 0 0 1-2-2c0-2 2-3 1-6-2 1-4 3-4 6a5 5 0 0 0 5 5 5 5 0 0 0 5-5c0-4-3-6-3-9-3 1-5 4-5 7"
                    fill="#45d6c9"
                  />
                </svg>
              </span>
              GNU Gas Natural
            </a>
            <p style="margin-top: 1rem; font-size: 0.875rem; max-width: 20rem;">
              Energía limpia y ahorro real para hogares, negocios y flotillas vehiculares en todo México.
            </p>
            <div class="social-row">
              {socialNetworks.map((item) => (
                <a class="social-icon" href={item.url || "#"} target="_blank" rel="noopener noreferrer" aria-label={item.network}>
                  <Fragment set:html={SOCIAL_ICON_MARKUP[item.network]} />
                </a>
              ))}
            </div>
          </div>
          <div>
            <p class="footer-heading">Navegación</p>
            {navLinks.map((link) => (
              <a class="footer-link" href={link.href}>{link.label}</a>
            ))}
          </div>
          <div>
            <p class="footer-heading">Servicios</p>
            <a class="footer-link" href="/nuestros-servicios">Gas Natural Comprimido (GNC)</a>
            <a class="footer-link" href="/nuestros-servicios">Gas Natural Domiciliario (GND)</a>
            <a class="footer-link" href="/nuestros-servicios">Gas Natural Vehicular (GNV)</a>
          </div>
          <div>
            <p class="footer-heading">Contacto</p>
            {footerAddress && <p class="footer-link">{footerAddress}</p>}
            <p class="footer-link">{footerEmail}</p>
            <p class="footer-link">{footerPhone}</p>
            <p class="footer-link">{footerSchedule}</p>
            {footerAdditionalInfo && <p class="footer-link">{footerAdditionalInfo}</p>}
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2025 GNU Gas Natural. Todos los derechos reservados.</span>
          <span>Aviso de privacidad · Términos y condiciones</span>
        </div>
      </div>
    </footer>

    <a
      class="whatsapp-fab"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.05-1.35A10 10 0 1 0 12 2zm0 18.1a8.06 8.06 0 0 1-4.1-1.12l-.3-.18-3 .8.8-2.93-.19-.3A8.1 8.1 0 1 1 12 20.1zm4.44-6.06c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.53.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.35-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.15-.06-.1-.22-.16-.46-.28z"/>
      </svg>
    </a>

    <script>
      const navToggle = document.getElementById("nav-toggle");
      const mobileNav = document.getElementById("mobile-nav");
      const mobileNavClose = document.getElementById("mobile-nav-close");

      if (navToggle && mobileNav) {
        const closeMobileNav = () => {
          mobileNav.classList.remove("is-open");
          mobileNav.setAttribute("aria-hidden", "true");
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Abrir menú");
          document.body.classList.remove("nav-open");
        };

        const openMobileNav = () => {
          mobileNav.classList.add("is-open");
          mobileNav.setAttribute("aria-hidden", "false");
          navToggle.setAttribute("aria-expanded", "true");
          navToggle.setAttribute("aria-label", "Cerrar menú");
          document.body.classList.add("nav-open");
        };

        navToggle.addEventListener("click", () => {
          if (navToggle.getAttribute("aria-expanded") === "true") closeMobileNav();
          else openMobileNav();
        });

        mobileNavClose?.addEventListener("click", closeMobileNav);
        mobileNav.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileNav));

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeMobileNav();
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth >= 900) closeMobileNav();
        });
      }

      const revealTargets = Array.from(
        document.querySelectorAll(
          ".section-head, .card, .logo-card, .simulator, .prose, .testimonial-card, .stations-map, .stations-list__item"
        )
      );

      if (revealTargets.length) {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

        // Anything already inside the viewport at load (a short page, or a
        // scroll position the browser restored on refresh) would have the
        // IntersectionObserver below report it as "intersecting" the instant
        // observe() runs. A CSS *transition* only animates if the browser gets
        // to paint the "before" state first — this early in the page's
        // lifecycle that's never guaranteed, so it can jump straight to the
        // end state with nothing visible in between. A keyframe *animation*
        // doesn't have that requirement (it always plays from its own 0%
        // keyframe once applied), so already-visible elements get one of
        // those instead of the scroll-triggered transition.
        const alreadyVisible: Element[] = [];
        const belowFold: Element[] = [];
        revealTargets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          (rect.top < viewportHeight && rect.bottom > 0 ? alreadyVisible : belowFold).push(el);
        });

        alreadyVisible.forEach((el) => el.classList.add("reveal-instant"));

        if (belowFold.length && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
          );

          belowFold.forEach((el) => {
            el.classList.add("reveal");
            observer.observe(el);
          });
        } else {
          belowFold.forEach((el) => el.classList.add("reveal", "is-visible"));
        }
      }
    </script>
  </body>
</html>
