# Port the admin calls (VITE_BUILD_SERVER_URL in gnu-cms-admin/.env).
PORT=4400

# CMS origin, no trailing slash. Used only to validate the admin's bearer token.
CMS_BASE_URL=https://gnu-headless-cms.165.227.59.215.sslip.io

# Comma-separated origins allowed to call this service (the admin's URL).
ALLOWED_ORIGINS=http://localhost:5173

# Per site: where `npm run build` runs (CODE_PATH, the Astro project, with
# node_modules already installed) and where its dist/ gets published
# (PUBLIC_PATH, the folder the web server actually serves — its contents are
# fully replaced after a successful build). The two are independent
# directories, not nested — there is no shared "code/" subfolder to carve out
# anymore. Leave a site's pair unset (or "/") and that site's build just fails
# closed with a clear error instead of touching anything.
VITE_GNU_CODE_PATH=/home/frontend/landing-gnu
VITE_GNU_PUBLIC_PATH=/var/www/html/sitios-cms/gnu

VITE_GAS_NATURAL_CODE_PATH=
VITE_GAS_NATURAL_PUBLIC_PATH=

VITE_TECTUUS_CODE_PATH=
VITE_TECTUUS_PUBLIC_PATH=

VITE_TRANINN_CODE_PATH=
VITE_TRANINN_PUBLIC_PATH=
