# Port the admin calls (VITE_BUILD_SERVER_URL in gnu-cms-admin/.env).
PORT=4400

# CMS origin, no trailing slash. Used only to validate the admin's bearer token.
CMS_BASE_URL=https://gnu-headless-cms.165.227.59.215.sslip.io

# Comma-separated origins allowed to call this service (the admin's URL).
ALLOWED_ORIGINS=http://localhost:5173

# Folder that contains landing-gnu/, gas-gnu/, trainin/, tectuus/. Relative to this folder.
SITES_ROOT=..

# Optional: command run inside the site folder after a successful build, to
# publish dist/. Leave unset to only build.
# DEPLOY_CMD_GNU=rsync -a --delete dist/ /var/www/landing-gnu/dist/
# DEPLOY_CMD_GAS_NATURAL=rsync -a --delete dist/ /var/www/gas-gnu/dist/
# DEPLOY_CMD_TRAININ=rsync -a --delete dist/ /var/www/trainin/dist/
# DEPLOY_CMD_TECTUUS=rsync -a --delete dist/ /var/www/tectuus/dist/
