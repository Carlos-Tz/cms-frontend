# Port the admin calls (VITE_BUILD_SERVER_URL in gnu-cms-admin/.env).
PORT=4400

# CMS origin, no trailing slash. Used only to validate the admin's bearer token.
CMS_BASE_URL=https://gnu-headless-cms.165.227.59.215.sslip.io

# Comma-separated origins allowed to call this service (the admin's URL).
ALLOWED_ORIGINS=http://localhost:5173

# Folder the web server serves the sites from. Each site folder in it
# (gnu, gnu-gas-natural, traninn-logistic, tectuus) holds the published build
# plus the Astro project, with node_modules installed, in code/. The build runs
# in <folder>/code and dist/ then replaces everything in <folder> except code/.
PUBLISH_ROOT=/var/www/html/sitios-cms

# Local dev only (used when PUBLISH_ROOT is unset): folder that contains the
# repo's landing-gnu/, gas-gnu/, trainin/, tectuus/. Relative to this folder.
# Nothing is published in that mode, only dist/ is regenerated.
# SITES_ROOT=..
